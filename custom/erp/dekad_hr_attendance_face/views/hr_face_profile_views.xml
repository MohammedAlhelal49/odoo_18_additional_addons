<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="hr_face_profile_view_list" model="ir.ui.view">
        <field name="name">hr.face.profile.list</field>
        <field name="model">hr.face.profile</field>
        <field name="arch" type="xml">
            <list create="0" edit="0">
                <field name="employee_id" widget="many2one_avatar_employee"/>
                <field name="company_id" groups="base.group_multi_company"/>
                <field name="sample_count"/>
                <field name="consent_date"/>
                <field name="consent_user_id" widget="many2one_avatar_user"/>
            </list>
        </field>
    </record>

    <record id="hr_face_profile_view_form" model="ir.ui.view">
        <field name="name">hr.face.profile.form</field>
        <field name="model">hr.face.profile</field>
        <field name="arch" type="xml">
            <form create="0" edit="0">
                <sheet>
                    <group>
                        <group>
                            <field name="employee_id"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="sample_count"/>
                        </group>
                        <group>
                            <field name="consent_given"/>
                            <field name="consent_date"/>
                            <field name="consent_user_id"/>
                        </group>
                    </group>
                    <div class="text-muted">
                        Face templates are stored as numeric vectors only; no photo is kept.
                        Deleting this profile permanently removes the employee's biometric data.
                    </div>
                </sheet>
            </form>
        </field>
    </record>

    <record id="hr_face_profile_view_search" model="ir.ui.view">
        <field name="name">hr.face.profile.search</field>
        <field name="model">hr.face.profile</field>
        <field name="arch" type="xml">
            <search>
                <field name="employee_id"/>
                <field name="company_id" groups="base.group_multi_company"/>
            </search>
        </field>
    </record>

    <record id="hr_face_profile_action" model="ir.actions.act_window">
        <field name="name">Face Profiles</field>
        <field name="res_model">hr.face.profile</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No enrolled faces yet</p>
            <p>Open an employee and click "Face" to enroll their face with their consent.</p>
        </field>
    </record>
</odoo>
