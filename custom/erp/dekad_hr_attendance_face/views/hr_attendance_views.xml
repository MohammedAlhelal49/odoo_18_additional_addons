<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Extends hr_attendance.hr_attendance_view_form -->
    <record id="hr_attendance_view_form_face" model="ir.ui.view">
        <field name="name">hr.attendance.form.inherit.face</field>
        <field name="model">hr.attendance</field>
        <field name="inherit_id" ref="hr_attendance.hr_attendance_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet" position="inside">
                <group string="Face Recognition" name="face_photos" groups="hr_attendance.group_hr_attendance_manager"
                       invisible="in_mode not in ('face_kiosk', 'face_mobile') and out_mode not in ('face_kiosk', 'face_mobile')">
                    <field name="face_photo_in" widget="image" options="{'size': [160, 160]}"/>
                    <field name="face_photo_out" widget="image" options="{'size': [160, 160]}"/>
                </group>
            </xpath>
        </field>
    </record>
</odoo>
