<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="ir_cron_face_gc" model="ir.cron">
            <field name="name">Attendance Face: clean challenges and rate limits</field>
            <field name="model_id" ref="model_hr_face_challenge"/>
            <field name="state">code</field>
            <field name="code">model._cron_face_gc()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">hours</field>
            <field name="user_id" ref="base.user_root"/>
        </record>
        <record id="ir_cron_face_purge_photos" model="ir.cron">
            <field name="name">Attendance Face: purge expired check-in photos</field>
            <field name="model_id" ref="hr_attendance.model_hr_attendance"/>
            <field name="state">code</field>
            <field name="code">model._cron_face_purge_photos()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="user_id" ref="base.user_root"/>
        </record>
        <record id="ir_cron_face_purge_inactive" model="ir.cron">
            <field name="name">Attendance Face: delete face data of archived employees</field>
            <field name="model_id" ref="model_hr_face_profile"/>
            <field name="state">code</field>
            <field name="code">model._cron_purge_inactive()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="user_id" ref="base.user_root"/>
        </record>
    </data>
</odoo>
