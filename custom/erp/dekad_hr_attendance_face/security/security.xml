<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="hr_face_profile_rule_company" model="ir.rule">
            <field name="name">Face profile: multi-company</field>
            <field name="model_id" ref="model_hr_face_profile"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        </record>
        <record id="hr_face_sample_rule_company" model="ir.rule">
            <field name="name">Face sample: multi-company</field>
            <field name="model_id" ref="model_hr_face_sample"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        </record>
        <record id="hr_face_attempt_rule_company" model="ir.rule">
            <field name="name">Face attempt: multi-company</field>
            <field name="model_id" ref="model_hr_face_attempt"/>
            <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
        </record>
        <!-- Biometric templates: restricted to Attendance administrators even if another
             module grants broader ACLs (e.g. a group implying model access). -->
        <record id="hr_face_sample_rule_manager_only" model="ir.rule">
            <field name="name">Face sample: Attendance administrators only</field>
            <field name="model_id" ref="model_hr_face_sample"/>
            <field name="domain_force">[(0, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('base.group_user')), (4, ref('base.group_portal')), (4, ref('base.group_public'))]"/>
        </record>
        <record id="hr_face_sample_rule_manager" model="ir.rule">
            <field name="name">Face sample: Attendance administrators</field>
            <field name="model_id" ref="model_hr_face_sample"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('hr_attendance.group_hr_attendance_manager'))]"/>
        </record>
    </data>
</odoo>
