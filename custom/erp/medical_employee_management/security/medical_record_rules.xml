<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">
        <!-- Record-Level Access Rules for Medical Center Roles -->

        <!-- Doctor: Can view all employees (for schedule checking), edit only own record -->
        <record id="rule_hr_employee_doctor_visibility" model="ir.rule">
            <field name="name">Doctor: View All Employees</field>
            <field name="model_id" ref="hr.model_hr_employee"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="perm_read">1</field>
            <field name="perm_write">0</field>
            <field name="perm_create">0</field>
            <field name="perm_unlink">0</field>
            <field name="groups" eval="[(4, ref('group_medical_doctor'))]"/>
        </record>

        <!-- Doctor: Can edit own employee record -->
        <record id="rule_hr_employee_doctor_self_edit" model="ir.rule">
            <field name="name">Doctor: Edit Own Record</field>
            <field name="model_id" ref="hr.model_hr_employee"/>
            <field name="domain_force">['|', ('user_id', '=', user.id), ('id', '=', user.employee_id.id)]</field>
            <field name="perm_read">1</field>
            <field name="perm_write">1</field>
            <field name="perm_create">0</field>
            <field name="perm_unlink">0</field>
            <field name="groups" eval="[(4, ref('group_medical_doctor'))]"/>
        </record>

