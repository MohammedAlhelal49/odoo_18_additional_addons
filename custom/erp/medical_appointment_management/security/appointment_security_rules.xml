<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">
        <!-- Administrator Full Access (Owner / Full System Admin with Override) -->
        <record id="rule_appointment_system_admin" model="ir.rule">
            <field name="name">Administrator Appointments All (Full Override)</field>
            <field name="model_id" ref="model_medical_appointment"/>
            <field name="groups" eval="[(4, ref('base.group_system'))]"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="perm_read">1</field>
            <field name="perm_write">1</field>
            <field name="perm_create">1</field>
            <field name="perm_unlink">1</field>
        </record>

        <!-- Manager Full Appointment Access (Owner / Medical Center Manager) -->
        <record id="rule_appointment_manager" model="ir.rule">
            <field name="name">Manager Appointments All (Full Override)</field>
            <field name="model_id" ref="model_medical_appointment"/>
            <field name="groups" eval="[(4, ref('group_medical_appointment_manager'))]"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="perm_read">1</field>
            <field name="perm_write">1</field>
            <field name="perm_create">1</field>
            <field name="perm_unlink">1</field>
        </record>

        <!-- Receptionist Full Appointment Access (Patient Check-in & Confirmations) -->
        <record id="rule_appointment_receptionist" model="ir.rule">
            <field name="name">Receptionist Appointments All</field>
            <field name="model_id" ref="model_medical_appointment"/>
            <field name="groups" eval="[(4, ref('medical_employee_management.group_medical_receptionist'))]"/>
            <field name="domain_force">[(1, '=', 1)]</field>
        </record>

        <!-- Receptionist Manager Access -->
        <record id="rule_appointment_receptionist_manager" model="ir.rule">
            <field name="name">Receptionist Manager Appointments All</field>
            <field name="model_id" ref="model_medical_appointment"/>
            <field name="groups" eval="[(4, ref('medical_employee_management.group_medical_receptionist_manager'))]"/>
            <field name="domain_force">[(1, '=', 1)]</field>
        </record>

        <!-- Nurse Manager (Head Nurse: Supervises All Nurse Triage in Team/Department) -->
        <record id="rule_appointment_nurse_manager" model="ir.rule">
            <field name="name">Nurse Manager Appointments &amp; Triage (Team &amp; Clinic)</field>
            <field name="model_id" ref="model_medical_appointment"/>
            <field name="groups" eval="[(4, ref('medical_employee_management.group_medical_nurse_manager'))]"/>
            <field name="domain_force">['|', '|', '|', ('nurse_id.user_id', '=', user.id), ('nurse_id.parent_id.user_id', '=', user.id), ('nurse_id.department_id.manager_id.user_id', '=', user.id), ('status', 'in', ['checked_in', 'ready_for_doctor', 'in_consultation', 'completed'])]</field>
        </record>

        <!-- Regular Nurse (Assigned Triage or Waiting in Clinic) -->
        <record id="rule_appointment_nurse" model="ir.rule">
            <field name="name">Nurse Appointments (Assigned or Waiting for Triage)</field>
            <field name="model_id" ref="model_medical_appointment"/>
            <field name="groups" eval="[(4, ref('medical_employee_management.group_medical_nurse'))]"/>
            <field name="domain_force">['|', ('nurse_id.user_id', '=', user.id), ('status', 'in', ['checked_in', 'ready_for_doctor'])]</field>
        </record>

        <!-- Doctor Manager (Head of Doctors: Self & Doctors Reporting to Them) -->
        <record id="rule_appointment_doctor_manager" model="ir.rule">
            <field name="name">Doctor Manager Appointments (Self &amp; Subordinate Doctors)</field>
            <field name="model_id" ref="model_medical_appointment"/>
            <field name="groups" eval="[(4, ref('medical_employee_management.group_medical_doctor_manager'))]"/>
            <field name="domain_force">['|', '|', ('doctor_id.user_id', '=', user.id), ('doctor_id.parent_id.user_id', '=', user.id), ('doctor_id.department_id.manager_id.user_id', '=', user.id)]</field>
        </record>

        <!-- Regular Doctor (Self Consultations & Appointments Only) -->
        <record id="rule_appointment_doctor" model="ir.rule">
            <field name="name">Doctor Appointments (Self Only)</field>
            <field name="model_id" ref="model_medical_appointment"/>
            <field name="groups" eval="[(4, ref('medical_employee_management.group_medical_doctor'))]"/>
            <field name="domain_force">[('doctor_id.user_id', '=', user.id)]</field>
        </record>

        <!-- Sales Manager (Head of Sales: Self & Sales Reps Reporting to Them) -->
        <record id="rule_appointment_sales_manager" model="ir.rule">
            <field name="name">Sales Manager Appointments (Self &amp; Subordinate Sales Reps)</field>
            <field name="model_id" ref="model_medical_appointment"/>
            <field name="groups" eval="[(4, ref('medical_employee_management.group_medical_sales_manager'))]"/>
            <field name="domain_force">['|', '|', ('sales_employee_id.user_id', '=', user.id), ('sales_employee_id.parent_id.user_id', '=', user.id), ('sales_employee_id.department_id.manager_id.user_id', '=', user.id)]</field>
        </record>

        <!-- Regular Sales Rep (Self Booked Appointments Only) -->
        <record id="rule_appointment_sales" model="ir.rule">
            <field name="name">Sales Appointments (Self Booked Only)</field>
            <field name="model_id" ref="model_medical_appointment"/>
            <field name="groups" eval="[(4, ref('medical_employee_management.group_medical_sales'))]"/>
            <field name="domain_force">[('sales_employee_id.user_id', '=', user.id)]</field>
        </record>

        <!-- ==================== CRM LEAD MEDICAL SECURITY RULES ==================== -->

        <!-- Admin / Owner Full Leads Visibility -->
        <record id="rule_crm_lead_medical_admin" model="ir.rule">
            <field name="name">Administrator / Owner CRM Leads All (Full Override)</field>
            <field name="model_id" ref="crm.model_crm_lead"/>
            <field name="groups" eval="[(4, ref('base.group_system')), (4, ref('group_medical_appointment_manager'))]"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="perm_read">1</field>
            <field name="perm_write">1</field>
            <field name="perm_create">1</field>
            <field name="perm_unlink">1</field>
        </record>

        <!-- Sales Manager: Can view own leads, unassigned leads, and leads of supervised reps/team -->
        <record id="rule_crm_lead_sales_manager" model="ir.rule">
            <field name="name">Sales Manager CRM Leads (Self &amp; Subordinate Leads)</field>
            <field name="model_id" ref="crm.model_crm_lead"/>
            <field name="groups" eval="[(4, ref('medical_employee_management.group_medical_sales_manager'))]"/>
            <field name="domain_force">['|', '|', '|', ('user_id', '=', user.id), ('user_id', '=', False), ('medical_staff_id.parent_id.user_id', '=', user.id), ('team_id.user_id', '=', user.id)]</field>
        </record>

        <!-- Regular Sales Rep: Can view own assigned leads and unassigned leads -->
        <record id="rule_crm_lead_sales_rep" model="ir.rule">
            <field name="name">Sales Rep CRM Leads (Self &amp; Unassigned Only)</field>
            <field name="model_id" ref="crm.model_crm_lead"/>
            <field name="groups" eval="[(4, ref('medical_employee_management.group_medical_sales'))]"/>
            <field name="domain_force">['|', ('user_id', '=', user.id), ('user_id', '=', False)]</field>
        </record>
    </data>
</odoo>
