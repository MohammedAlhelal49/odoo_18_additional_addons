<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">
        <!-- System Administrator & Medical Appointment Manager: Full Access (All Appointments) -->
        <record id="rule_medical_appointment_system_admin" model="ir.rule">
            <field name="name">Administrator: Full Appointment Access</field>
            <field name="model_id" ref="model_medical_appointment"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="perm_read">1</field>
            <field name="perm_write">1</field>
            <field name="perm_create">1</field>
            <field name="perm_unlink">1</field>
            <field name="groups" eval="[(4, ref('base.group_system')), (4, ref('base.group_erp_manager'))]"/>
        </record>

        <!-- Doctor: View only own assigned appointments -->
        <record id="rule_medical_appointment_doctor_view" model="ir.rule">
            <field name="name">Doctor: View Own Assigned Appointments Only</field>
            <field name="model_id" ref="model_medical_appointment"/>
            <field name="domain_force">['|', ('doctor_id.user_id', '=', user.id), ('doctor_user_id', '=', user.id)]</field>
            <field name="perm_read">1</field>
            <field name="perm_write">0</field>
            <field name="perm_create">0</field>
            <field name="perm_unlink">0</field>
            <field name="groups" eval="[(4, ref('medical_employee_management.group_medical_doctor'))]"/>
        </record>

        <!-- Doctor: Manage (create, edit, cancel, delete) only own assigned appointments -->
        <record id="rule_medical_appointment_doctor_edit" model="ir.rule">
            <field name="name">Doctor: Manage Own Assigned Appointments Only</field>
            <field name="model_id" ref="model_medical_appointment"/>
            <field name="domain_force">['|', ('doctor_id.user_id', '=', user.id), ('doctor_user_id', '=', user.id)]</field>
            <field name="perm_read">1</field>
            <field name="perm_write">1</field>
            <field name="perm_create">1</field>
            <field name="perm_unlink">1</field>
            <field name="groups" eval="[(4, ref('medical_employee_management.group_medical_doctor'))]"/>
        </record>

        <!-- Admin Doctor (Doctor Manager): View and Manage ALL Appointments -->
        <record id="rule_medical_appointment_doctor_manager" model="ir.rule">
            <field name="name">Doctor Manager (Admin Doctor): All Appointments</field>
            <field name="model_id" ref="model_medical_appointment"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="perm_read">1</field>
            <field name="perm_write">1</field>
            <field name="perm_create">1</field>
            <field name="perm_unlink">1</field>
            <field name="groups" eval="[(4, ref('medical_employee_management.group_medical_doctor_manager'))]"/>
        </record>

        <!-- Sales: View only own assigned / booked appointments -->
        <record id="rule_medical_appointment_sales_view" model="ir.rule">
            <field name="name">Sales: View Own Assigned Appointments Only</field>
            <field name="model_id" ref="model_medical_appointment"/>
            <field name="domain_force">['|', '|', '|', ('salesperson_id', '=', user.id), ('created_by_sales', '=', user.id), ('sales_employee_id.user_id', '=', user.id), ('lead_id.user_id', '=', user.id)]</field>
            <field name="perm_read">1</field>
            <field name="perm_write">0</field>
            <field name="perm_create">0</field>
            <field name="perm_unlink">0</field>
            <field name="groups" eval="[(4, ref('medical_employee_management.group_medical_sales'))]"/>
        </record>

        <!-- Sales: Manage (create, edit, cancel, delete) only own assigned / booked appointments -->
        <record id="rule_medical_appointment_sales_edit" model="ir.rule">
            <field name="name">Sales: Manage Own Assigned Appointments Only</field>
            <field name="model_id" ref="model_medical_appointment"/>
            <field name="domain_force">['|', '|', '|', ('salesperson_id', '=', user.id), ('created_by_sales', '=', user.id), ('sales_employee_id.user_id', '=', user.id), ('lead_id.user_id', '=', user.id)]</field>
            <field name="perm_read">1</field>
            <field name="perm_write">1</field>
            <field name="perm_create">1</field>
            <field name="perm_unlink">1</field>
            <field name="groups" eval="[(4, ref('medical_employee_management.group_medical_sales'))]"/>
        </record>

        <!-- Admin Sales (Sales Manager): View and Manage ALL Appointments -->
        <record id="rule_medical_appointment_sales_manager" model="ir.rule">
            <field name="name">Sales Manager (Admin Sales): All Appointments</field>
            <field name="model_id" ref="model_medical_appointment"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="perm_read">1</field>
            <field name="perm_write">1</field>
            <field name="perm_create">1</field>
            <field name="perm_unlink">1</field>
            <field name="groups" eval="[(4, ref('medical_employee_management.group_medical_sales_manager'))]"/>
        </record>

        <!-- Nurse: View appointments and patient history, edit only vitals -->
        <record id="rule_medical_appointment_nurse_view" model="ir.rule">
            <field name="name">Nurse: View Appointments</field>
            <field name="model_id" ref="model_medical_appointment"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="perm_read">1</field>
            <field name="perm_write">0</field>
            <field name="perm_create">0</field>
            <field name="perm_unlink">0</field>
            <field name="groups" eval="[(4, ref('medical_employee_management.group_medical_nurse'))]"/>
        </record>

        <!-- Nurse: Edit vitals for checked-in patients -->
        <record id="rule_medical_appointment_nurse_edit" model="ir.rule">
            <field name="name">Nurse: Record Vitals</field>
            <field name="model_id" ref="model_medical_appointment"/>
            <field name="domain_force">[('status', '=', 'checked_in')]</field>
            <field name="perm_read">1</field>
            <field name="perm_write">1</field>
            <field name="perm_create">0</field>
            <field name="perm_unlink">0</field>
            <field name="groups" eval="[(4, ref('medical_employee_management.group_medical_nurse'))]"/>
        </record>

        <!-- Receptionist: View all appointments -->
        <record id="rule_medical_appointment_receptionist_view" model="ir.rule">
            <field name="name">Receptionist: View All Appointments</field>
            <field name="model_id" ref="model_medical_appointment"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="perm_read">1</field>
            <field name="perm_write">0</field>
            <field name="perm_create">0</field>
            <field name="perm_unlink">0</field>
            <field name="groups" eval="[(4, ref('medical_employee_management.group_medical_receptionist'))]"/>
        </record>

        <!-- Receptionist: Create, confirm, check-in, reschedule appointments -->
        <record id="rule_medical_appointment_receptionist_edit" model="ir.rule">
            <field name="name">Receptionist: Manage Appointments</field>
            <field name="model_id" ref="model_medical_appointment"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="perm_read">1</field>
            <field name="perm_write">1</field>
            <field name="perm_create">1</field>
            <field name="perm_unlink">0</field>
            <field name="groups" eval="[(4, ref('medical_employee_management.group_medical_receptionist'))]"/>
        </record>

        <!-- HR Manager: Full access -->
        <record id="rule_medical_appointment_hr_manager" model="ir.rule">
            <field name="name">HR Manager: Full Appointment Access</field>
            <field name="model_id" ref="model_medical_appointment"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="perm_read">1</field>
            <field name="perm_write">1</field>
            <field name="perm_create">1</field>
            <field name="perm_unlink">0</field>
            <field name="groups" eval="[(4, ref('medical_employee_management.group_medical_hr_manager'))]"/>
        </record>
    </data>
</odoo>
