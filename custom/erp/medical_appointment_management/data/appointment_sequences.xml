<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Sequence for Medical Record Numbers (MRN) -->
        <record id="seq_medical_patient_mrn" model="ir.sequence">
            <field name="name">Medical Record Number</field>
            <field name="code">medical.patient.mrn</field>
            <field name="prefix">MRN/</field>
            <field name="number_next">10001</field>
            <field name="number_increment">1</field>
            <field name="padding">6</field>
            <field name="company_id" ref="base.main_company"/>
        </record>
    </data>
</odoo>
