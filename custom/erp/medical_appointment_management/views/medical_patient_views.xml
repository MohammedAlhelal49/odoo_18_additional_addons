<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Patient List View -->
    <record id="view_medical_patient_tree" model="ir.ui.view">
        <field name="name">medical.patient.list</field>
        <field name="model">res.partner</field>
        <field name="priority">20</field>
        <field name="arch" type="xml">
            <list string="Patients"
                  decoration-info="patient_status == 'follow_up'"
                  decoration-primary="patient_status == 'under_treatment'"
                  decoration-success="patient_status == 'active'"
                  decoration-muted="patient_status == 'discharged'"
                  decoration-warning="patient_status == 'inactive'">
                <field name="patient_number" string="MRN" class="fw-bold text-primary"/>
                <field name="name" string="Patient Name"/>
                <field name="phone"/>
                <field name="mobile" optional="show"/>
                <field name="email"/>
                <field name="registration_date"/>
                <field name="assigned_doctor_id"/>
                <field name="responsible_employee_id" optional="show"/>
                <field name="last_appointment_date" optional="show"/>
                <field name="next_appointment_date"/>
                <field name="patient_status" widget="badge"
                       decoration-success="patient_status == 'active'"
                       decoration-primary="patient_status == 'under_treatment'"
                       decoration-info="patient_status == 'follow_up'"
                       decoration-muted="patient_status == 'discharged'"
                       decoration-warning="patient_status == 'inactive'"/>
                <field name="appointment_count" optional="show"/>
            </list>
        </field>
    </record>

    <!-- Patient Kanban View -->
    <record id="view_medical_patient_kanban" model="ir.ui.view">
        <field name="name">medical.patient.kanban</field>
        <field name="model">res.partner</field>
        <field name="priority">20</field>
        <field name="arch" type="xml">
            <kanban class="o_kanban_mobile">
                <field name="id"/>
                <field name="name"/>
                <field name="patient_number"/>
                <field name="phone"/>
                <field name="email"/>
                <field name="assigned_doctor_id"/>
                <field name="patient_status"/>
                <field name="avatar_128"/>
                <templates>
                    <t t-name="card">
                        <div class="oe_kanban_global_click o_kanban_record_has_image_fill">
                            <div class="o_kanban_image d-none d-md-block"
                                 t-attf-style="background-image:url('#{kanban_image('res.partner', 'avatar_128', record.id.raw_value)}')"/>
                            <div class="oe_kanban_details d-flex flex-column justify-content-between">
                                <div>
                                    <strong class="o_kanban_record_title">
                                        <field name="name"/>
                                    </strong>
                                    <div class="text-muted fw-bold">
                                        <field name="patient_number"/>
                                    </div>
                                    <div t-if="record.phone.raw_value">
                                        📞 <field name="phone"/>
                                    </div>
                                    <div t-if="record.assigned_doctor_id.raw_value">
                                        👨‍⚕️ <field name="assigned_doctor_id"/>
                                    </div>
                                </div>
                                <div class="o_kanban_record_bottom">
                                    <div class="oe_kanban_bottom_left">
                                        <field name="patient_status" widget="badge"
                                               decoration-success="patient_status == 'active'"
                                               decoration-primary="patient_status == 'under_treatment'"
                                               decoration-info="patient_status == 'follow_up'"
                                               decoration-muted="patient_status == 'discharged'"/>
                                    </div>
                                    <div class="oe_kanban_bottom_right">
                                        <span class="badge text-bg-light">
                                            📅 <field name="appointment_count"/> Visits
                                        </span>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- Patient Search & Filter View -->
    <record id="view_medical_patient_search" model="ir.ui.view">
        <field name="name">medical.patient.search</field>
        <field name="model">res.partner</field>
        <field name="priority">20</field>
        <field name="arch" type="xml">
            <search string="Search Patients">
                <field name="name" string="Patient Name"
                       filter_domain="['|', '|', ('name', 'ilike', self), ('phone', 'ilike', self), ('patient_number', 'ilike', self)]"/>
                <field name="patient_number" string="MRN / Patient Number"/>
                <field name="phone" string="Phone / Mobile"
                       filter_domain="['|', ('phone', 'ilike', self), ('mobile', 'ilike', self)]"/>
                <field name="email" string="Email"/>
                <field name="assigned_doctor_id" string="Doctor"/>
                <field name="responsible_employee_id" string="Responsible Staff"/>

                <separator/>
                <filter string="Active Patients" name="filter_active" domain="[('patient_status', '=', 'active')]"/>
                <filter string="Under Treatment" name="filter_treatment" domain="[('patient_status', '=', 'under_treatment')]"/>
                <filter string="Under Follow-up" name="filter_followup" domain="[('patient_status', '=', 'follow_up')]"/>
                <filter string="Discharged" name="filter_discharged" domain="[('patient_status', '=', 'discharged')]"/>

                <separator/>
                <filter string="Registered This Month" name="filter_registered_month"
                        domain="[('registration_date', '&gt;=', (context_today().replace(day=1)).strftime('%Y-%m-%d'))]"/>
                <filter string="Has Upcoming Appointment" name="filter_upcoming_appt"
                        domain="[('next_appointment_date', '!=', False)]"/>

                <group expand="0" string="Group By">
                    <filter string="Assigned Doctor" name="group_doctor" context="{'group_by': 'assigned_doctor_id'}"/>
                    <filter string="Patient Status" name="group_status" context="{'group_by': 'patient_status'}"/>
                    <filter string="Registration Month" name="group_reg_month" context="{'group_by': 'registration_date:month'}"/>
                    <filter string="Responsible Staff" name="group_responsible" context="{'group_by': 'responsible_employee_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Patient Form View -->
    <record id="view_medical_patient_form" model="ir.ui.view">
        <field name="name">medical.patient.form</field>
        <field name="model">res.partner</field>
        <field name="priority">20</field>
        <field name="arch" type="xml">
            <form string="Patient Record">
                <header>
                    <button name="action_book_new_appointment" string="+ Book Appointment" type="object" class="btn-primary"/>
                    <field name="patient_status" widget="statusbar" statusbar_visible="active,under_treatment,follow_up,discharged"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_patient_appointments" type="object" class="oe_stat_button" icon="fa-calendar">
                            <field name="appointment_count" widget="statinfo" string="Appointments"/>
                        </button>
                        <button name="action_view_patient_leads" type="object" class="oe_stat_button" icon="fa-star" invisible="crm_lead_count == 0"
                                groups="medical_employee_management.group_medical_sales,medical_employee_management.group_medical_receptionist,base.group_system">
                            <field name="crm_lead_count" widget="statinfo" string="CRM Leads"/>
                        </button>
                    </div>

                    <field name="avatar_128" widget="image" class="oe_avatar" options="{'preview_image': 'avatar_128'}"/>
                    <div class="oe_title">
                        <div class="d-flex align-items-center mb-1">
                            <span class="badge text-bg-primary fs-6 me-2">MRN: <field name="patient_number" readonly="1" class="text-white"/></span>
                            <span class="badge text-bg-light"><field name="patient_status"/></span>
                        </div>
                        <h1>
                            <field name="name" placeholder="Patient Full Name" required="1"/>
                        </h1>
                    </div>

                    <group>
                        <group string="Contact &amp; Registration">
                            <field name="phone" widget="phone"/>
                            <field name="mobile" widget="phone"/>
                            <field name="email" widget="email"/>
                            <field name="registration_date" readonly="1"/>
                            <field name="assigned_doctor_id" options="{'no_create': True}"/>
                            <field name="responsible_employee_id" options="{'no_create': True}"/>
                        </group>
                        <group string="Demographics &amp; Health Info">
                            <field name="gender"/>
                            <field name="date_of_birth"/>
                            <field name="blood_group"/>
                            <field name="allergies" placeholder="Known allergies (drugs, foods, environmental)..."/>
                            <field name="emergency_contact_name"/>
                            <field name="emergency_contact_phone" widget="phone"/>
                            <field name="lead_id" readonly="1" invisible="not lead_id"/>
                        </group>
                    </group>

                    <notebook>
                        <!-- Chronological Interaction Timeline -->
                        <page string="Medical History Timeline" name="timeline">
                            <div class="alert alert-info text-center py-2" role="status" invisible="patient_history_ids">
                                ℹ️ No previous interaction history recorded for this patient.
                            </div>
                            <field name="patient_history_ids" readonly="1" invisible="not patient_history_ids">
                                <list string="Chronological Timeline"
                                      decoration-primary="entry_type == 'consultation'"
                                      decoration-info="entry_type == 'appointment'"
                                      decoration-warning="entry_type == 'call'"
                                      decoration-success="entry_type == 'lead'"
                                      decoration-danger="entry_type == 'cancellation'">
                                    <field name="date" string="Date &amp; Time"/>
                                    <field name="entry_type" widget="badge"/>
                                    <field name="responsible_name" string="Staff / Doctor"/>
                                    <field name="summary"/>
                                    <field name="status" widget="badge"/>
                                    <field name="clinical_details" groups="medical_employee_management.group_medical_doctor,medical_employee_management.group_medical_nurse,base.group_system"/>
                                </list>
                            </field>
                        </page>

                        <!-- Appointments History -->
                        <page string="Appointments &amp; Visits" name="appointments">
                            <field name="appointment_ids" readonly="1">
                                <list string="Appointments"
                                      decoration-success="status == 'completed'"
                                      decoration-primary="status == 'confirmed'"
                                      decoration-warning="status in ('checked_in', 'ready_for_doctor')"
                                      decoration-muted="status == 'in_consultation'"
                                      decoration-danger="status in ('cancelled', 'no_show')">
                                    <field name="appointment_date"/>
                                    <field name="name" string="Appointment Ref"/>
                                    <field name="doctor_id"/>
                                    <field name="service_ids" widget="many2many_tags"/>
                                    <field name="appointment_total" widget="monetary" string="Fee"/>
                                    <field name="company_currency_id" column_invisible="True"/>
                                    <field name="status" widget="badge"/>
                                    <field name="diagnosis" groups="medical_employee_management.group_medical_doctor,medical_employee_management.group_medical_nurse,base.group_system"/>
                                    <field name="prescription" groups="medical_employee_management.group_medical_doctor,medical_employee_management.group_medical_nurse,base.group_system"/>
                                    <field name="cancellation_reason"/>
                                </list>
                            </field>
                        </page>

                        <!-- Confidential Clinical Notes (Doctors, Nurses & System Admins) -->
                        <page string="Clinical Notes &amp; Records" name="clinical_records"
                              groups="medical_employee_management.group_medical_doctor,medical_employee_management.group_medical_nurse,base.group_system">
                            <group>
                                <field name="medical_history_summary" placeholder="Chronic diseases, prior surgeries, relevant family history..."/>
                                <field name="clinical_notes" placeholder="Confidential clinical notes, ongoing treatment observations..."/>
                            </group>
                        </page>

                        <!-- CRM Leads & Outreach -->
                        <page string="CRM Leads &amp; Calls" name="crm_leads">
                            <group string="Originating Inquiries">
                                <field name="crm_lead_ids" readonly="1">
                                    <list string="CRM Leads">
                                        <field name="name"/>
                                        <field name="create_date"/>
                                        <field name="user_id"/>
                                        <field name="stage_id"/>
                                        <field name="source_platform"/>
                                        <field name="campaign_name"/>
                                    </list>
                                </field>
                            </group>
                        </page>

                        <!-- Acquisition & Lead Attribution -->
                        <page string="Lead Attribution" name="attribution">
                            <group>
                                <group string="Acquisition Channel">
                                    <field name="source_type" readonly="1"/>
                                    <field name="source_platform" readonly="1"/>
                                </group>
                                <group string="Campaign &amp; Advertisement">
                                    <field name="campaign_name" readonly="1"/>
                                    <field name="advertisement_name" readonly="1"/>
                                </group>
                            </group>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- Action for Patients Menu -->
    <record id="action_medical_patient" model="ir.actions.act_window">
        <field name="name">Patients</field>
        <field name="res_model">res.partner</field>
        <field name="view_mode">list,kanban,form</field>
        <field name="domain">[('is_patient', '=', True)]</field>
        <field name="context">{'default_is_patient': True}</field>
        <field name="search_view_id" ref="view_medical_patient_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No patients registered yet!
            </p>
            <p>
                Patients are automatically registered when a lead starts their first appointment, or you can register a new patient directly here.
            </p>
        </field>
    </record>

    <record id="action_medical_patient_view_tree" model="ir.actions.act_window.view">
        <field name="sequence" eval="1"/>
        <field name="view_mode">list</field>
        <field name="view_id" ref="view_medical_patient_tree"/>
        <field name="act_window_id" ref="action_medical_patient"/>
    </record>

    <record id="action_medical_patient_view_kanban" model="ir.actions.act_window.view">
        <field name="sequence" eval="2"/>
        <field name="view_mode">kanban</field>
        <field name="view_id" ref="view_medical_patient_kanban"/>
        <field name="act_window_id" ref="action_medical_patient"/>
    </record>

    <record id="action_medical_patient_view_form" model="ir.actions.act_window.view">
        <field name="sequence" eval="3"/>
        <field name="view_mode">form</field>
        <field name="view_id" ref="view_medical_patient_form"/>
        <field name="act_window_id" ref="action_medical_patient"/>
    </record>
</odoo>
