<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Receptionist Dashboard Form View -->
    <record id="view_medical_receptionist_dashboard_form" model="ir.ui.view">
        <field name="name">medical.receptionist.dashboard.form</field>
        <field name="model">medical.receptionist.dashboard</field>
        <field name="arch" type="xml">
            <form string="Reception Desk Dashboard" create="false" delete="false">
                <header>
                    <button name="action_view_today_appointments" string="📅 Today's Appointments" type="object" class="btn-primary"/>
                    <button name="action_view_tomorrow_confirmations" string="📞 Tomorrow's Confirmations" type="object" class="btn-secondary"/>
                    <button name="action_view_waiting_room" string="🪑 Waiting Room Queue" type="object" class="btn-secondary"/>
                    <button name="action_view_cancellations_today" string="❌ Cancellations" type="object" class="btn-secondary"/>
                    <button name="action_refresh" string="🔄 Refresh" type="object" class="btn-link"/>
                </header>
                <sheet>
                    <field name="today_date" invisible="1"/>
                    <field name="tomorrow_date" invisible="1"/>
                    <field name="kpi_today_total" invisible="1"/>
                    <field name="kpi_tomorrow_pending" invisible="1"/>
                    <field name="kpi_patients_waiting" invisible="1"/>
                    <field name="kpi_patients_arrived" invisible="1"/>
                    <field name="kpi_cancellations_today" invisible="1"/>
                    <div class="w-100">
                        <field name="dashboard_html" widget="html" readonly="1" nolabel="1" class="w-100 d-block"/>
                    </div>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Receptionist Dashboard Window Action -->
    <record id="action_medical_receptionist_dashboard" model="ir.actions.act_window">
        <field name="name">Reception Operations Dashboard</field>
        <field name="res_model">medical.receptionist.dashboard</field>
        <field name="view_mode">form</field>
        <field name="target">current</field>
    </record>

    <!-- Server Action to open singleton dashboard -->
    <record id="action_medical_receptionist_dashboard_init" model="ir.actions.server">
        <field name="name">Reception Operations Dashboard</field>
        <field name="model_id" ref="model_medical_receptionist_dashboard"/>
        <field name="state">code</field>
        <field name="code">
action = model.action_open_dashboard()
        </field>
    </record>
</odoo>
