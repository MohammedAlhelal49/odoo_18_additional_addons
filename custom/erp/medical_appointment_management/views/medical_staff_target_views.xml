<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Medical Staff Target List View -->
    <record id="view_medical_staff_target_tree" model="ir.ui.view">
        <field name="name">medical.staff.target.list</field>
        <field name="model">medical.staff.target</field>
        <field name="arch" type="xml">
            <list string="Performance Targets &amp; Goals">
                <field name="name"/>
                <field name="target_type"/>
                <field name="employee_id"/>
                <field name="department_id"/>
                <field name="role"/>
                <field name="date_start"/>
                <field name="date_end"/>
                <field name="revenue_target" widget="monetary"/>
                <field name="completed_appointment_target"/>
                <field name="lead_conversion_target"/>
                <field name="max_cancellation_rate"/>
                <field name="max_no_show_rate"/>
                <field name="company_id" groups="base.group_multi_company"/>
            </list>
        </field>
    </record>

    <!-- Medical Staff Target Form View -->
    <record id="view_medical_staff_target_form" model="ir.ui.view">
        <field name="name">medical.staff.target.form</field>
        <field name="model">medical.staff.target</field>
        <field name="arch" type="xml">
            <form string="Performance Target">
                <sheet>
                    <div class="oe_title">
                        <label for="name" string="Target Title"/>
                        <h1>
                            <field name="name" placeholder="e.g. Dr. John Smith - October 2026 Target"/>
                        </h1>
                    </div>
                    <group>
                        <group string="Scope &amp; Assignment">
                            <field name="target_type" widget="radio"/>
                            <field name="employee_id" invisible="target_type != 'employee'" required="target_type == 'employee'"/>
                            <field name="department_id" invisible="target_type != 'department'" required="target_type == 'department'"/>
                            <field name="role" invisible="target_type != 'role'" required="target_type == 'role'"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="active" widget="boolean_toggle"/>
                        </group>
                        <group string="Period &amp; Timeline">
                            <field name="period_type"/>
                            <field name="period_name" placeholder="e.g. October 2026, Q4 2026"/>
                            <field name="date_start"/>
                            <field name="date_end"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Performance KPI Targets" name="kpi_targets">
                            <group>
                                <group string="Revenue &amp; Production Goals">
                                    <field name="revenue_target" widget="monetary"/>
                                    <field name="completed_appointment_target"/>
                                </group>
                                <group string="Conversion &amp; Quality Thresholds">
                                    <field name="lead_conversion_target"/>
                                    <field name="max_cancellation_rate"/>
                                    <field name="max_no_show_rate"/>
                                </group>
                            </group>
                        </page>
                        <page string="Notes &amp; Description" name="notes">
                            <field name="notes" placeholder="Additional KPI context, incentive structure, or department guidelines..."/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Medical Staff Target Search View -->
    <record id="view_medical_staff_target_search" model="ir.ui.view">
        <field name="name">medical.staff.target.search</field>
        <field name="model">medical.staff.target</field>
        <field name="arch" type="xml">
            <search string="Search Targets">
                <field name="name"/>
                <field name="employee_id"/>
                <field name="department_id"/>
                <field name="role"/>
                <filter string="Specific Employees" name="employee_targets" domain="[('target_type', '=', 'employee')]"/>
                <filter string="Department Targets" name="department_targets" domain="[('target_type', '=', 'department')]"/>
                <filter string="Role Targets" name="role_targets" domain="[('target_type', '=', 'role')]"/>
                <separator/>
                <filter string="Archived" name="inactive" domain="[('active', '=', False)]"/>
                <group expand="0" string="Group By">
                    <filter string="Target Type" name="group_type" context="{'group_by': 'target_type'}"/>
                    <filter string="Employee" name="group_employee" context="{'group_by': 'employee_id'}"/>
                    <filter string="Department" name="group_department" context="{'group_by': 'department_id'}"/>
                    <filter string="Role" name="group_role" context="{'group_by': 'role'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Medical Staff Target Action -->
    <record id="action_medical_staff_target" model="ir.actions.act_window">
        <field name="name">Performance Targets &amp; Goals</field>
        <field name="res_model">medical.staff.target</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_medical_staff_target_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create your first Staff Performance Target!
            </p>
            <p>
                Set monthly, quarterly, or annual goals for revenue, completed appointments, lead conversion rates, and max cancellation thresholds.
            </p>
        </field>
    </record>
</odoo>
