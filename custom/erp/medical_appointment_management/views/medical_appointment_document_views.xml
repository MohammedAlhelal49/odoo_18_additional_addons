<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- Document Form View -->
        <record id="medical_appointment_document_form_view" model="ir.ui.view">
            <field name="name">medical.appointment.document.form</field>
            <field name="model">medical.appointment.document</field>
            <field name="arch" type="xml">
                <form string="Appointment Document">
                    <sheet>
                        <group>
                            <group>
                                <field name="name"/>
                                <field name="document_type"/>
                            </group>
                            <group>
                                <field name="appointment_id" readonly="1"/>
                                <field name="created_by" readonly="1"/>
                            </group>
                        </group>
                        <group>
                            <field name="description" colspan="2" nolabel="1"/>
                        </group>
                        <group>
                            <field name="document" filename="filename" widget="binary"/>
                            <field name="filename" invisible="1"/>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

        <!-- Document List View -->
        <record id="medical_appointment_document_list_view" model="ir.ui.view">
            <field name="name">medical.appointment.document.list</field>
            <field name="model">medical.appointment.document</field>
            <field name="arch" type="xml">
                <list string="Appointment Documents">
                    <field name="name"/>
                    <field name="document_type" widget="badge"/>
                    <field name="appointment_id"/>
                    <field name="created_by"/>
                    <field name="create_date"/>
                </list>
            </field>
        </record>

        <!-- Document Search View -->
        <record id="medical_appointment_document_search_view" model="ir.ui.view">
            <field name="name">medical.appointment.document.search</field>
            <field name="model">medical.appointment.document</field>
            <field name="arch" type="xml">
                <search string="Search Documents">
                    <field name="name" string="Name"/>
                    <field name="appointment_id" string="Appointment"/>
                    <field name="document_type" string="Document Type"/>
                    <separator/>
                    <filter name="prescription" string="Prescription" domain="[('document_type', '=', 'prescription')]"/>
                    <filter name="lab_report" string="Lab Report" domain="[('document_type', '=', 'lab_report')]"/>
                    <filter name="medical_report" string="Medical Report" domain="[('document_type', '=', 'medical_report')]"/>
                    <filter name="certificate" string="Medical Certificate" domain="[('document_type', '=', 'certificate')]"/>
                    <separator/>
                    <group string="Group By">
                        <filter name="group_by_type" string="Document Type" context="{'group_by': 'document_type'}"/>
                        <filter name="group_by_appointment" string="Appointment" context="{'group_by': 'appointment_id'}"/>
                    </group>
                </search>
            </field>
        </record>

        <!-- Action Window -->
        <record id="action_medical_appointment_document" model="ir.actions.act_window">
            <field name="name">Appointment Documents</field>
            <field name="res_model">medical.appointment.document</field>
            <field name="view_mode">list,form</field>
            <field name="search_view_id" ref="medical_appointment_document_search_view"/>
            <field name="context">{'search_default_group_by_type': 1}</field>
        </record>

    </data>
</odoo>
