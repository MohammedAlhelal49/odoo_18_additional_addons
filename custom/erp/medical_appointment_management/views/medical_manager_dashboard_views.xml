<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Manager Operations Dashboard Form View -->
    <record id="view_medical_manager_dashboard_form" model="ir.ui.view">
        <field name="name">medical.manager.dashboard.form</field>
        <field name="model">medical.manager.dashboard</field>
        <field name="arch" type="xml">
            <form string="Medical Center Manager Operations" create="false" delete="false">
                <header>
                    <button name="action_view_all_today_appointments" string="📅 All Appointments Today" type="object" class="btn-primary"/>
                    <button name="action_view_overdue_leads" string="⚠️ Overdue Follow-ups" type="object" class="btn-secondary"/>
                    <button name="action_view_doctor_conflicts" string="⚠️ Doctor Conflicts" type="object" class="btn-secondary"/>
                    <button name="action_view_today_invoices" string="🧾 Invoices &amp; Revenue" type="object" class="btn-secondary"/>
                    <button name="action_refresh" string="🔄 Refresh" type="object" class="btn-link"/>
                </header>
                <sheet>
                    <field name="dashboard_date" invisible="1"/>
                    <field name="kpi_appointments_today" invisible="1"/>
                    <field name="kpi_completed_in_progress" invisible="1"/>
                    <field name="kpi_cancelled_no_show" invisible="1"/>
                    <field name="kpi_tomorrow_unconfirmed" invisible="1"/>
                    <field name="kpi_new_leads_today" invisible="1"/>
                    <field name="kpi_overdue_leads" invisible="1"/>
                    <field name="kpi_patients_registered" invisible="1"/>
                    <field name="kpi_doctor_conflicts_count" invisible="1"/>
                    <field name="kpi_revenue_today" invisible="1"/>
                    <div class="w-100">
                        <field name="dashboard_html" widget="html" readonly="1" nolabel="1" class="w-100 d-block"/>
                    </div>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Manager Operations Dashboard Window Action -->
    <record id="action_medical_manager_dashboard" model="ir.actions.act_window">
        <field name="name">Manager Operations Dashboard</field>
        <field name="res_model">medical.manager.dashboard</field>
        <field name="view_mode">form</field>
        <field name="target">current</field>
    </record>

    <!-- Server Action to open singleton manager dashboard -->
    <record id="action_medical_manager_dashboard_init" model="ir.actions.server">
        <field name="name">Operations Executive Dashboard</field>
        <field name="model_id" ref="model_medical_manager_dashboard"/>
        <field name="state">code</field>
        <field name="code">
action = model.action_open_dashboard()
        </field>
    </record>
</odoo>
