<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">
    <!-- المتبقي بالمخزون: بيظهر بسطر الطلب بشاشة البيع بس، مش بإيصال الزبون -->
    <t t-name="pos_stock_warning.OrderSummary" t-inherit="point_of_sale.OrderSummary" t-inherit-mode="extension">
        <xpath expr="//Orderline" position="inside">
            <t t-set="stockRemaining" t-value="getStockRemaining(line)"/>
            <li t-if="stockRemaining" class="pos-stock-remaining small" t-att-class="stockRemaining.cssClass" t-att-style="stockRemaining.style">
                <i class="fa fa-cubes me-1" role="img" aria-hidden="true"/>
                <t t-esc="stockRemaining.label"/>: <strong t-esc="stockRemaining.value"/>
            </li>
        </xpath>
    </t>
</templates>
