<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Medical CRM Stages -->
        <!-- These are created alongside standard CRM stages and can be used by teams specifically focused on medical context -->

        <record id="stage_new_medical" model="crm.stage">
            <field name="name">New</field>
            <field name="sequence">1</field>
            <field name="is_won">0</field>
        </record>

        <record id="stage_contact_attempted" model="crm.stage">
            <field name="name">Contact Attempted</field>
            <field name="sequence">2</field>
            <field name="is_won">0</field>
        </record>

        <record id="stage_contacted" model="crm.stage">
            <field name="name">Contacted</field>
            <field name="sequence">3</field>
            <field name="is_won">0</field>
        </record>

        <record id="stage_qualified" model="crm.stage">
            <field name="name">Qualified</field>
            <field name="sequence">4</field>
            <field name="is_won">0</field>
        </record>

        <record id="stage_booked" model="crm.stage">
            <field name="name">Booked</field>
            <field name="sequence">5</field>
            <field name="is_won">0</field>
        </record>

        <record id="stage_lost" model="crm.stage">
            <field name="name">Lost</field>
            <field name="sequence">6</field>
            <field name="is_won">0</field>
            <field name="fold">1</field>
        </record>

        <!-- Default Lost Reason for medical context -->
        <record id="crm_lead_lost_reason_not_interested" model="crm.lost.reason">
            <field name="name">Not Interested</field>
        </record>

        <record id="crm_lead_lost_reason_competitor" model="crm.lost.reason">
            <field name="name">Chose Competitor</field>
        </record>

        <record id="crm_lead_lost_reason_budget" model="crm.lost.reason">
            <field name="name">Budget Constraints</field>
        </record>

        <record id="crm_lead_lost_reason_timing" model="crm.lost.reason">
            <field name="name">Wrong Timing</field>
        </record>
    </data>
</odoo>
