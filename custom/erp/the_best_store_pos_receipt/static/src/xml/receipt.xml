<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">

    <t t-name="the_best_store_pos_receipt.OrderReceipt">
        <div class="pos-receipt p-2">

            <!-- ====== HEADER ====== -->
            <img t-attf-src="/web/image?model=res.company&amp;id={{props.data.headerData.company.id}}&amp;field=logo"
                 alt="Logo" class="pos-receipt-logo"/>
            <br/>
            <div class="d-flex flex-column align-items-center">
                <div class="pos-receipt-contact">
                    <div class="pos-receipt-title">
                        <t t-esc="props.data.headerData.company.name"/>
                    </div>
                    <t t-if="props.data.headerData.company.vat">
                        <div class="fw-bold fs-6">
                            TRN: <t t-esc="props.data.headerData.company.vat"/>
                        </div>
                    </t>
                    <t t-if="props.data.headerData.company.phone">
                        <div>&#128222; <t t-esc="props.data.headerData.company.phone"/></div>
                    </t>
                    <t t-if="props.data.headerData.company.email">
                        <div>&#9993; <t t-esc="props.data.headerData.company.email"/></div>
                    </t>
                    <!-- TAX INVOICE -->
                  <div class="pos-receipt-title mt-1" t-esc="props.data.headerData.company.id === 7 ? 'SALES INVOICE' : 'TAX INVOICE'"/>
                </div>
            </div>

            <div class="text-center">--------------------------------</div>

            <!-- ====== SERVED BY ====== -->
            <div class="pos-receipt-order-data">
                Served by: <t t-esc="props.data.cashier"/>
            </div>

            <!-- ====== ORDER NUMBER ====== -->
            <div class="text-center fw-bold" style="font-size: 200%;">
                <t t-esc="props.data.headerData.trackingNumber"/>
            </div>

            <!-- ====== INVOICE NUMBER ====== -->
            <t t-if="props.data.invoice_name">
                <div class="pos-receipt-order-data fw-bold">
                    Invoice: <t t-esc="props.data.invoice_name"/>
                </div>
            </t>

            <!-- ====== CUSTOMER + DATE ====== -->
            <t t-if="props.data.partner_name">
                <div class="pos-receipt-order-data fw-bold">
                    Customer: <t t-esc="props.data.partner_name"/>
                </div>
            </t>
            <div class="pos-receipt-order-data">
                Date: <t t-esc="props.data.date"/>
            </div>

            <div class="text-center">--------------------------------</div>

            <!-- ====== ORDER LINES ====== -->
            <table class="tbs-table">
                <thead>
                    <tr>
                        <th class="tbs-th-desc">Description</th>
                        <th class="tbs-th-qty">Qty</th>
                        <th class="tbs-th-num">Price</th>
                        <th class="tbs-th-num">VAT 5%</th>
                        <th class="tbs-th-num" t-esc="props.data.headerData.company.id === 7 ? 'Total' : 'Total Inc. VAT'"/>


                    </tr>
                    <tr><td colspan="5"><div class="tbs-hr"/></td></tr>
                </thead>
                <tbody>
                    <t t-foreach="props.data.orderlines" t-as="line" t-key="line_index">
                        <tr>
                            <td class="tbs-td-desc"><t t-esc="line.productName"/></td>
                            <td class="tbs-td-qty"><t t-esc="line.rawQty"/></td>
                            <td class="tbs-td-num"><t t-esc="line.rawUnitPrice"/></td>
                            <td class="tbs-td-num"><t t-esc="line.rawTax"/></td>
                            <td class="tbs-td-num"><t t-esc="line.rawPriceIncVat"/></td>
                        </tr>
                    </t>
                </tbody>
            </table>

            <!-- ====== TAX TOTALS ====== -->
            <t t-set="taxTotals" t-value="props.data.taxTotals"/>
            <div t-if="taxTotals and taxTotals.has_tax_groups and props.data.headerData.company.id != 7" class="pos-receipt-taxes">
                <div class="text-center">--------------------------------</div>
                <t t-foreach="taxTotals.subtotals" t-as="subtotal" t-key="subtotal.name">
                    <div class="d-flex">
                        <span class="fw-bolder" t-out="subtotal.name"/>
                        <span t-esc="props.formatCurrency(subtotal.base_amount_currency)" class="ms-auto"/>
                    </div>
                    <t t-foreach="subtotal.tax_groups" t-as="tax_group" t-key="tax_group.id">
                        <div class="d-flex">
                            <span>
                                <span t-esc="tax_group.group_name"/>
                                <t t-if="!taxTotals.same_tax_base">
                                    on <span t-esc="props.formatCurrency(tax_group.base_amount_currency)"/>
                                </t>
                            </span>
                            <span t-esc="props.formatCurrency(tax_group.tax_amount_currency)" class="ms-auto"/>
                        </div>
                    </t>
                </t>
            </div>

            <div class="text-center">--------------------------------</div>
            <div class="pos-receipt-amount receipt-total">
                <t t-out="props.data.label_total"/>
                <span t-esc="props.formatCurrency(taxTotals.order_total)" class="pos-receipt-right-align"/>
            </div>

            <!-- ====== PAYMENT LINES ====== -->
            <div class="paymentlines text-start" t-foreach="props.data.paymentlines" t-as="line" t-key="line_index">
                <t t-esc="line.name"/>
                <span t-esc="props.formatCurrency(line.amount)" class="pos-receipt-right-align"/>
            </div>

            
            <div class="pos-receipt-center-align fw-bold">
                Thank You &amp; Come Again!
            </div>
            <br/>

        </div>
    </t>

</templates>
