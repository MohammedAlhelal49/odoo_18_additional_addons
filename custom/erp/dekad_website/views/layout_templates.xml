    <!-- ===== MAIN LAYOUT: wraps website.layout, own header/footer ===== -->
    <template id="layout" name="Dekad Layout">
        <t t-name="dekad_website.layout">
            <!-- Capture the page's own content BEFORE entering the
                 website.layout call below - "0" only refers to our
                 direct caller's body at this nesting level, so it has
                 to be saved into a variable here or it becomes
                 unreachable once we're inside the nested t-call. -->
            <t t-set="page_content"><t t-out="0"/></t>

            <t t-call="website.layout">
                <!-- Header, footer, floating contact buttons, dekad.js and
                     the Arabic webfont are injected into website.layout
                     itself (see website_layout_dekad_chrome below), so
                     they're shared by every page of the site - ours and
                     Odoo's (/my, /shop, /blog...). This flag only tells
                     that inherit our pages handle the fixed-header offset
                     themselves (their hero sections are padded for it). -->
                <t t-set="dk_custom_page" t-value="True"/>

                <!-- Preloader -->
                <div class="preloader d-flex align-items-center justify-content-center">
                    <div class="ve-loader-dots">
                        <span></span>
                        <span></span>
                        <span></span>
                    </div>
                </div>
                <!-- Safety-net: hide the preloader even if a vendor
                     script errors out and active.js never gets to run
                     its own $('.preloader').fadeOut(...) call. -->
                <script>
                    (function () {
                        var veLoaderStart = Date.now();
                        var veLoaderMinMs = 1500; // let the ring animation play at least once
                        var veLoaderHidden = false;
                        function reallyHidePreloader() {
                            if (veLoaderHidden) { return; }
                            veLoaderHidden = true;
                            var el = document.querySelector('.preloader');
                            if (!el) { return; }
                            el.style.transition = 'opacity .4s ease';
                            el.style.opacity = '0';
                            setTimeout(function () { if (el.parentNode) { el.parentNode.removeChild(el); } }, 400);
                        }
                        function hidePreloader() {
                            var elapsed = Date.now() - veLoaderStart;
                            var remaining = veLoaderMinMs - elapsed;
                            if (remaining > 0) {
                                setTimeout(reallyHidePreloader, remaining);
                            } else {
                                reallyHidePreloader();
                            }
                        }
                        window.addEventListener('load', hidePreloader);
                        setTimeout(hidePreloader, 2500);
                    })();
                </script>

                <!-- reCAPTCHA v3 (invisible) - only loaded once the site
                     key is configured (Settings > Technical > System
                     Parameters > dekad_website.recaptcha_site_key). Any
                     form with class "ve-contact-form" or "ve-nl-form" is
                     protected automatically - no per-form JS needed. -->
                <script t-if="recaptcha_site_key"
                        t-attf-src="https://www.google.com/recaptcha/api.js?render=#{recaptcha_site_key}"/>
                <script t-if="recaptcha_site_key">
                    (function () {
                        var SITE_KEY = "<t t-esc="recaptcha_site_key"/>";
                        function protect(form) {
                            if (form.dataset.veRecaptchaBound) { return; }
                            form.dataset.veRecaptchaBound = '1';
                            form.addEventListener('submit', function (e) {
                                if (form.dataset.veRecaptchaSubmitting) { return; }
                                e.preventDefault();
                                grecaptcha.ready(function () {
                                    grecaptcha.execute(SITE_KEY, {action: 'submit'}).then(function (token) {
                                        var input = form.querySelector('input[name="g-recaptcha-response"]');
                                        if (!input) {
                                            input = document.createElement('input');
                                            input.type = 'hidden';
                                            input.name = 'g-recaptcha-response';
                                            form.appendChild(input);
                                        }
                                        input.value = token;
                                        form.dataset.veRecaptchaSubmitting = '1';
                                        form.submit();
                                    });
                                });
                            });
                        }
                        document.querySelectorAll('.ve-contact-form, .ve-nl-form').forEach(protect);
                    })();
                </script>

                <!-- website.layout already wraps us in <main> -->
                <t t-out="page_content"/>

                <!-- Image lightbox: click any .ve-feature-card-img image to
                     view it full-size. Site-wide, plain vanilla JS (no
                     jQuery/Bootstrap), so it works the same everywhere and
                     can't be broken by a jQuery conflict elsewhere. -->
                <div class="ve-lightbox-overlay" id="ve-lightbox">
                    <button type="button" class="ve-lightbox-close" aria-label="Close">&#215;</button>
                    <img class="ve-lightbox-img" id="ve-lightbox-img" src="" alt=""/>
                </div>
                <script>
                    (function () {
                        function initLightbox() {
                            var overlay = document.getElementById('ve-lightbox');
                            var img = document.getElementById('ve-lightbox-img');
                            if (!overlay || !img) { return; }

                            function hide() {
                                overlay.classList.remove('ve-modal-open');
                                document.body.style.overflow = '';
                                img.src = '';
                            }
                            function show(src, alt) {
                                img.src = src;
                                img.alt = alt || '';
                                overlay.classList.add('ve-modal-open');
                                document.body.style.overflow = 'hidden';
                            }

                            document.addEventListener('click', function (e) {
                                var target = e.target.closest('.ve-feature-card-img img');
                                if (target) {
                                    show(target.getAttribute('src'), target.getAttribute('alt'));
                                }
                            });
                            overlay.addEventListener('click', function (e) {
                                if (e.target === overlay) { hide(); }
                            });
                            overlay.querySelector('.ve-lightbox-close').addEventListener('click', hide);
                            document.addEventListener('keydown', function (e) {
                                if (e.key === 'Escape') { hide(); }
                            });
                        }
                        if (document.readyState === 'loading') {
                            document.addEventListener('DOMContentLoaded', initLightbox);
                        } else {
                            initLightbox();
                        }
                    })();
                </script>

                <!-- Load our own scripts directly, instead of putting
                     them in the web.assets_frontend bundle (that would
                     wrap each one in odoo.define(...), which these old
                     jQuery plugins don't expect, and forcing the whole
                     bundle to re-run risks double-initializing Odoo's
                     own frontend widgets). Plain sequential <script>
                     tags, in the exact order these plugins need
                     (jQuery first, our own dekad.js last),
                     rendered here - already deep inside <body> - so
                     document.body always exists by the time they run. -->
                <!-- jQuery must be our own bundled copy: Odoo's website
                     frontend does NOT reliably expose a global jQuery at
                     the point these deferred scripts run here (confirmed
                     - removing this caused "jQuery is not defined"
                     everywhere below). -->
                <script type="text/javascript" src="/dekad_website/static/src/js/jquery-2.2.4.min.js" defer="defer"/>
                <script type="text/javascript" src="/dekad_website/static/src/js/popper.min.js" defer="defer"/>
                <script type="text/javascript" src="/dekad_website/static/src/js/bootstrap.min.js" defer="defer"/>
                <script type="text/javascript" src="/dekad_website/static/src/js/plugins.js" defer="defer"/>
                <script type="text/javascript" src="/dekad_website/static/src/js/active.js" defer="defer"/>
                <!-- dekad.js is loaded site-wide from website_layout_dekad_chrome (after the footer), so it still runs after these. -->
            </t>
        </t>
    </template>


    <!-- ===== SITE-WIDE CHROME =====
         Replaces website.layout's own header and footer with ours, so EVERY
         frontend page - our custom pages and Odoo's own (/my/*, /shop,
         /blog, /web/login, ...) - gets the same header (with the EN | AR
         top bar), footer and floating contact buttons. Odoo's language
         selector disappears with Odoo's header/footer.
         priority=99: applied after all of Website's own header/footer
         customizations (template options, website_sale cart, ...), which
         xpath INTO <header>/<footer> - they're applied first, then the
         whole element is swapped, so nothing fails to locate its target. -->
    <template id="website_layout_dekad_chrome" inherit_id="website.layout" name="Dekad Site-wide Header/Footer" priority="99">
        <!-- Arabic webfont, loaded only for RTL visitors -->
        <xpath expr="//head" position="inside">
            <t t-if="request.env['res.lang']._get_data(code=request.env.lang).direction == 'rtl'">
                <link rel="preconnect" href="https://fonts.googleapis.com"/>
                <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin=""/>
                <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Tajawal:wght@300;400;500;700;800;900&amp;display=swap"/>
            </t>
        </xpath>
        <xpath expr="//header[@id='top']" position="replace">
            <t t-if="not no_header">
                <t t-call="dekad_website.header"/>
                <!-- Odoo's pages aren't designed for a fixed header: push
                     their content below it. Our own pages don't need it. -->
                <div t-if="not dk_custom_page" class="dk-header-offset" aria-hidden="true"/>
            </t>
        </xpath>
        <xpath expr="//footer[@id='bottom']" position="replace">
            <t t-if="not no_footer">
                <t t-call="dekad_website.footer"/>
            </t>
                <!-- Floating contact buttons (WhatsApp + Call) - fixed
                 bottom-left, shown on every page via the shared layout. -->
            <div class="ve-floating-contact">
                <a href="https://wa.me/971569559537" target="_blank" rel="noopener"
                   class="ve-float-btn ve-float-whatsapp" aria-label="Chat on WhatsApp">
                    <i class="fa fa-whatsapp"/>
                </a>
                <a dir="ltr" href="tel:+971569559537" class="ve-float-btn ve-float-call" aria-label="Call us">
                    <i class="fa fa-phone"/>
                </a>
            </div>

            <script type="text/javascript" src="/dekad_website/static/src/js/dekad.js" defer="defer"/>
        </xpath>
    </template>

</odoo>