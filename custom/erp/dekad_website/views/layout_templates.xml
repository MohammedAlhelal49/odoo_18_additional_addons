    <!-- ===== EN | AR LANGUAGE SWITCH =====
         Shared by the top bar (dark) and the footer bottom bar
         (light variant via dk_lang_class). Uses the exact same
         `frontend_languages` Odoo 18's own selector (portal.language_selector)
         iterates, EN always first, and renders nothing when the website has
         a single language. Each link carries the same href / data-url_code
         as Odoo's selector; dekad.js routes the click through
         /website/lang/<code> exactly like Odoo does. -->
    <template id="lang_switch" name="Dekad Language Switch">
        <t t-set="dk_switch_langs" t-value="sorted((frontend_languages or {}).values(), key=lambda lg: lg.code[:2] != 'en')"/>
        <div t-if="len(dk_switch_langs) &gt; 1" t-attf-class="dk-lang-switch #{dk_lang_class or ''}" dir="ltr" role="navigation" aria-label="Language">
            <t t-foreach="dk_switch_langs" t-as="lg">
                <span t-if="not lg_first" class="dk-lang-sep" aria-hidden="true">|</span>
                <a t-att-href="url_localized(lang_code=lg.code, prefetch_langs=True, force_default_lang=True)"
                   t-attf-class="dk-lang-link #{lg.code == lang and 'active' or ''}"
                   t-att-data-url_code="lg.url_code"
                   t-att-lang="lg.code.replace('_', '-')"
                   t-att-title="lg.name.split('/').pop()"
                   t-att-aria-current="lg.code == lang and 'true' or None">
                    <t t-esc="lg.url_code.split('_')[0].upper()"/>
                </a>
            </t>
        </div>
    </template>

