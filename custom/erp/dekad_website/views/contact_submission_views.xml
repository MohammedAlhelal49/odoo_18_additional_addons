<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_vaultedge_contact_submission_list" model="ir.ui.view">
        <field name="name">dekad.contact.submission.list</field>
        <field name="model">dekad.contact.submission</field>
        <field name="arch" type="xml">
            <list string="Website Submissions" create="false">
                <field name="create_date" string="Received"/>
                <field name="submission_type" widget="badge"/>
                <field name="name"/>
                <field name="email"/>
                <field name="phone"/>
                <field name="company"/>
                <field name="service"/>
                <field name="state" widget="badge" decoration-info="state == 'new'" decoration-success="state == 'done'"/>
            </list>
        </field>
    </record>

    <record id="view_vaultedge_contact_submission_form" model="ir.ui.view">
        <field name="name">dekad.contact.submission.form</field>
        <field name="model">dekad.contact.submission</field>
        <field name="arch" type="xml">
            <form string="Website Submission" create="false">
                <header>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="submission_type"/>
                            <field name="name"/>
                            <field name="email"/>
                            <field name="phone"/>
                        </group>
                        <group>
                            <field name="company"/>
                            <field name="service"/>
                        </group>
                    </group>
                    <group>
                        <field name="message"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_vaultedge_contact_submission_search" model="ir.ui.view">
        <field name="name">dekad.contact.submission.search</field>
        <field name="model">dekad.contact.submission</field>
        <field name="arch" type="xml">
            <search string="Search Submissions">
                <field name="name"/>
                <field name="email"/>
                <field name="company"/>
                <filter string="New" name="filter_new" domain="[('state', '=', 'new')]"/>
                <group expand="0" string="Group By">
                    <filter string="Type" name="group_type" context="{'group_by': 'submission_type'}"/>
                    <filter string="Status" name="group_state" context="{'group_by': 'state'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- All submissions -->
    <record id="action_vaultedge_submission_all" model="ir.actions.act_window">
        <field name="name">All Submissions</field>
        <field name="res_model">dekad.contact.submission</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_vaultedge_contact_submission_search"/>
    </record>

    <!-- Contact page messages only -->
    <record id="action_vaultedge_submission_contact" model="ir.actions.act_window">
        <field name="name">Contact Messages</field>
        <field name="res_model">dekad.contact.submission</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('submission_type', '=', 'contact')]</field>
        <field name="context">{'default_submission_type': 'contact'}</field>
        <field name="search_view_id" ref="view_vaultedge_contact_submission_search"/>
    </record>

    <!-- Request Demo submissions only -->
    <record id="action_vaultedge_submission_demo" model="ir.actions.act_window">
        <field name="name">Demo Requests</field>
        <field name="res_model">dekad.contact.submission</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('submission_type', '=', 'demo')]</field>
        <field name="context">{'default_submission_type': 'demo'}</field>
        <field name="search_view_id" ref="view_vaultedge_contact_submission_search"/>
    </record>

    <!-- Free Consultation submissions only -->
    <record id="action_vaultedge_submission_consultation" model="ir.actions.act_window">
        <field name="name">Consultation Requests</field>
        <field name="res_model">dekad.contact.submission</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('submission_type', '=', 'consultation')]</field>
        <field name="context">{'default_submission_type': 'consultation'}</field>
        <field name="search_view_id" ref="view_vaultedge_contact_submission_search"/>
    </record>

    <!-- Newsletter subscriptions only -->
    <record id="action_vaultedge_submission_newsletter" model="ir.actions.act_window">
        <field name="name">Newsletter Subscribers</field>
        <field name="res_model">dekad.contact.submission</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('submission_type', '=', 'newsletter')]</field>
        <field name="context">{'default_submission_type': 'newsletter'}</field>
        <field name="search_view_id" ref="view_vaultedge_contact_submission_search"/>
    </record>

    <menuitem id="menu_vaultedge_root" name="Dekad Site" sequence="90"/>
    <menuitem id="menu_vaultedge_submissions_root"
              name="Submissions"
              parent="menu_vaultedge_root"
              sequence="10"/>
    <menuitem id="menu_vaultedge_submission_all"
              name="All Submissions"
              parent="menu_vaultedge_submissions_root"
              action="action_vaultedge_submission_all"
              sequence="10"/>
    <menuitem id="menu_vaultedge_submission_contact"
              name="Contact Messages"
              parent="menu_vaultedge_submissions_root"
              action="action_vaultedge_submission_contact"
              sequence="20"/>
    <menuitem id="menu_vaultedge_submission_demo"
              name="Demo Requests"
              parent="menu_vaultedge_submissions_root"
              action="action_vaultedge_submission_demo"
              sequence="30"/>
    <menuitem id="menu_vaultedge_submission_consultation"
              name="Consultation Requests"
              parent="menu_vaultedge_submissions_root"
              action="action_vaultedge_submission_consultation"
              sequence="40"/>
    <menuitem id="menu_vaultedge_submission_newsletter"
              name="Newsletter Subscribers"
              parent="menu_vaultedge_submissions_root"
              action="action_vaultedge_submission_newsletter"
              sequence="50"/>

</odoo>