<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_dekad_client_import_wizard_form" model="ir.ui.view">
        <field name="name">dekad.client.import.wizard.form</field>
        <field name="model">dekad.client.import.wizard</field>
        <field name="arch" type="xml">
            <form string="Import Clients from HTML + Logo Folder">
                <p>
                    Upload the HTML file that contains one
                    <code>&lt;div class="company-card" data-title="..." data-image="..." data-text="..."&gt;</code>
                    per client, and give the absolute path (on this Odoo
                    server's own filesystem) of the folder where the logo
                    image files are already placed. Each client's
                    <code>data-image</code> filename is looked up in that
                    folder by name.
                    <br/>
                    Clients are created <strong>unpublished</strong>, in the
                    same order they appear in the HTML file.
                </p>
                <group>
                    <field name="html_file" filename="html_filename"/>
                    <field name="html_filename" invisible="1"/>
                    <field name="logo_folder_path" placeholder="/home/odoo/client_logos"/>
                </group>
                <field name="result_summary" invisible="not result_summary" widget="text"
                       readonly="1"/>
                <footer>
                    <button name="action_import" type="object" string="Import" class="btn-primary"/>
                    <button string="Close" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_dekad_client_import_wizard" model="ir.actions.act_window">
        <field name="name">Import Clients</field>
        <field name="res_model">dekad.client.import.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

    <menuitem id="menu_dekad_client_import"
              name="Import Clients"
              parent="menu_vaultedge_root"
              action="action_dekad_client_import_wizard"
              sequence="25"/>

</odoo>