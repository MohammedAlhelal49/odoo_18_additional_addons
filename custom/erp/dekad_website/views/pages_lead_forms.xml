<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ===== REQUEST DEMO ===== -->
    <template id="page_request_demo" name="Dekad - Request Demo">
<t t-call="dekad_website.layout">
    <section class="ve-page-hero" style="background-image:url(/dekad_website/static/src/img/contact_us.jpg);">
        <div class="ve-page-hero-overlay"></div>
        <div class="container ve-page-hero-content">
            <span class="ve-section-tag ve-tag-onlight">See It In Action</span>
            <h1>Request a Demo</h1>
            <nav aria-label="breadcrumb"><ol class="ve-breadcrumb"><li><a href="/">Home</a></li><li class="active">Request Demo</li></ol></nav>
        </div>
    </section>

    <section class="ve-section ve-contact-section">
        <div class="container">
            <div class="row justify-content-center">
                <div class="col-12 col-lg-8">
                    <div class="ve-contact-form-wrap">
                        <span class="ve-section-tag">Let's Get Started</span>
                        <h2>Tell Us About Your Business</h2>
                        <p>Share a few details and our team will schedule a live walkthrough of the platform tailored to your needs.</p>
                        <t t-if="form_sent">
                            <t t-call="dekad_website.success_modal">
                                <t t-set="modal_title">Demo Requested!</t>
                                <t t-set="modal_message">Thank you! Your demo request has been received — our team will reach out shortly to schedule it.</t>
                            </t>
                        </t>
                        <t t-if="form_error">
                            <div class="alert alert-danger" role="alert">Please fill in your name and a valid email address.</div>
                        </t>
                        <form class="ve-contact-form" action="/request-demo" method="post">
                            <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                            <input type="text" class="ve-hp-field" tabindex="-1" autocomplete="off" name="company_url"/>
                            <div class="ve-form-row">
                                <div class="ve-form-group"><label>Full Name</label><input type="text" name="name" placeholder="Your full name" required="required"/></div>
                                <div class="ve-form-group"><label>Email Address</label><input type="email" name="email" placeholder="Your email" required="required"/></div>
                            </div>
                            <div class="ve-form-row">
                                <div class="ve-form-group"><label>Phone Number</label><input type="tel" name="phone" placeholder="Your phone"/></div>
                                <div class="ve-form-group"><label>Company Name</label><input type="text" name="company" placeholder="Your company"/></div>
                            </div>
                            <div class="ve-form-group"><label>What would you like to see in the demo?</label><textarea name="message" rows="5" placeholder="Tell us about your business needs..."></textarea></div>
                            <button type="submit" class="ve-btn-primary">Request Demo <i class="fa fa-paper-plane"/></button>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </section>
</t>
    </template>

    <!-- ===== FREE CONSULTATION ===== -->
    <template id="page_free_consultation" name="Dekad- Free Consultation">
<t t-call="dekad_website.layout">
    <section class="ve-page-hero" style="background-image:url(/dekad_website/static/src/img/contact_us.jpg);">
        <div class="ve-page-hero-overlay"></div>
        <div class="container ve-page-hero-content">
            <span class="ve-section-tag ve-tag-onlight">Free &amp; No Obligation</span>
            <h1>Book a Free Consultation</h1>
            <nav aria-label="breadcrumb"><ol class="ve-breadcrumb"><li><a href="/">Home</a></li><li class="active">Free Consultation</li></ol></nav>
        </div>
    </section>

    <section class="ve-section ve-contact-section">
        <div class="container">
            <div class="row justify-content-center">
                <div class="col-12 col-lg-8">
                    <div class="ve-contact-form-wrap">
                        <span class="ve-section-tag">Let's Talk</span>
                        <h2>Book Your Free Consultation</h2>
                        <p>Fill in the form below and one of our Odoo experts will reach out to schedule your free consultation.</p>
                        <t t-if="form_sent">
                            <t t-call="dekad_website.success_modal">
                                <t t-set="modal_title">Consultation Booked!</t>
                                <t t-set="modal_message">Thank you! Your consultation request has been received — we'll be in touch shortly to schedule it.</t>
                            </t>
                        </t>
                        <t t-if="form_error">
                            <div class="alert alert-danger" role="alert">Please fill in your name and a valid email address.</div>
                        </t>
                        <form class="ve-contact-form" action="/free-consultation" method="post">
                            <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                            <input type="text" class="ve-hp-field" tabindex="-1" autocomplete="off" name="company_url"/>
                            <div class="ve-form-row">
                                <div class="ve-form-group"><label>Full Name</label><input type="text" name="name" placeholder="Your full name" required="required"/></div>
                                <div class="ve-form-group"><label>Email Address</label><input type="email" name="email" placeholder="Your email" required="required"/></div>
                            </div>
                            <div class="ve-form-row">
                                <div class="ve-form-group"><label>Phone Number</label><input type="tel" name="phone" placeholder="Your phone"/></div>
                                <div class="ve-form-group"><label>Company Name</label><input type="text" name="company" placeholder="Your company"/></div>
                            </div>
                            <div class="ve-form-group"><label>What would you like to discuss?</label><textarea name="message" rows="5" placeholder="Tell us about your goals..."></textarea></div>
                            <button type="submit" class="ve-btn-primary">Book Free Consultation <i class="fa fa-paper-plane"/></button>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </section>
</t>
    </template>

</odoo>