<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ===== INDUSTRY DETAIL PAGE ===== -->
    <template id="master_industry_template" name="Dekad Industry Detail">
        <t t-call="dekad_website.layout">

            <!-- Hero -->
            <section class="ve-app-hero bg-img" t-attf-style="background-image:url('#{page.get('hero_bg_image', '')}');">
                <div class="ve-app-hero-overlay"/>
                <div class="container ve-app-hero-content">
                    <h1><t t-esc="page.get('hero_title')"/></h1>
                    <p class="ve-app-hero-subtitle"><t t-esc="page.get('hero_desc')"/></p>
                </div>
            </section>

            <!-- Showcase: features list + image -->
            <section class="ve-section ve-industry-showcase" t-if="page.get('showcase_features')">
                <div class="container">
                    <div class="row align-items-center">
                        <div class="col-lg-6 mb-4 mb-lg-0">
                            <h2 class="ve-app-overview-title"><t t-esc="page.get('showcase_title')"/></h2>
                            <t t-foreach="page.get('showcase_features', [])" t-as="feature">
                                <div class="ve-industry-feature">
                                    <i t-attf-class="fa #{feature.get('icon', 'fa-check')}"/>
                                    <div>
                                        <h5><t t-esc="feature.get('title')"/></h5>
                                        <p><t t-esc="feature.get('desc')"/></p>
                                    </div>
                                </div>
                            </t>
                        </div>
                        <div class="col-lg-6" t-if="page.get('showcase_image')">
                            <img t-att-src="page.get('showcase_image')" alt="Showcase" class="img-fluid ve-app-overview-img"/>
                        </div>
                    </div>
                </div>
            </section>

            <!-- Cards grid -->
            <section class="ve-section ve-services-section" t-if="page.get('cards')">
                <div class="container">
                    <div class="ve-section-header text-center">
                        <h2><t t-esc="page.get('cards_title')"/></h2>
                    </div>
                    <div class="row">
                        <t t-foreach="page.get('cards', [])" t-as="card">
                            <div class="col-lg-6 mb-4">
                                <div class="ve-feature-card">
                                    <div class="ve-feature-card-img" t-if="card.get('image')">
                                        <img t-att-src="card.get('image')" t-att-alt="card.get('title')"/>
                                    </div>
                                    <div class="ve-feature-card-body">
                                        <h5><t t-esc="card.get('title')"/></h5>
                                        <p><t t-esc="card.get('desc')"/></p>
                                    </div>
                                </div>
                            </div>
                        </t>
                    </div>
                </div>
            </section>

            <!-- Highlight strip (simplified from the masonry block) -->
            <section class="ve-section ve-industry-highlight" t-if="page.get('masonry_image')">
                <div class="container">
                    <div class="row align-items-stretch">
                        <div class="col-lg-5 mb-4 mb-lg-0">
                            <div class="ve-industry-highlight-img bg-img"
                                 t-attf-style="background-image:url('#{page.get('masonry_image', '')}');">
                                <div class="ve-industry-highlight-overlay">
                                    <h3><t t-esc="page.get('masonry_overlay_text')"/></h3>
                                </div>
                            </div>
                        </div>
                        <div class="col-lg-7">
                            <div class="ve-industry-highlight-blocks">
                                <t t-foreach="page.get('masonry_blocks', [])" t-as="m_block">
                                    <div class="ve-industry-highlight-block">
                                        <h4><t t-esc="m_block.get('title')"/></h4>
                                        <p><t t-esc="m_block.get('desc')"/></p>
                                    </div>
                                </t>
                            </div>
                        </div>
                    </div>
                </div>
            </section>

        </t>
    </template>

    <!-- ===== INDUSTRIES INDEX (/industries with no slug) ===== -->
    <template id="industries_index_template" name="Dekad Industries Index">
        <t t-call="dekad_website.layout">
            <section class="ve-section ve-apps-index-section">
                <div class="container">
                    <div class="ve-section-header text-center">
                        <span class="ve-section-tag">Industries</span>
                        <h2>Solutions Tailored For <span>Every Sector</span></h2>
                    </div>
                    <div class="ve-services-grid">
                        <t t-foreach="industries.items()" t-as="entry">
                            <t t-set="slug" t-value="entry[0]"/>
                            <t t-set="industry" t-value="entry[1]"/>
                            <a t-attf-href="/industries/#{slug}" class="ve-service-card ve-app-index-card">
                                <h4><t t-esc="industry.get('hero_title')"/></h4>
                                <p><t t-esc="industry.get('hero_desc')"/></p>
                                <span class="ve-card-link">See more <i class="fa fa-long-arrow-right"/></span>
                            </a>
                        </t>
                    </div>
                </div>
            </section>
        </t>
    </template>

</odoo>