msgstr "تتبع الحضور والإجازات"

#. module: dekad_website
#. odoo-python
#: code:addons/dekad_website/data/app_data.py:0
msgid "Attendance Kiosk & Check‑In/Out"
msgstr "كشك الحضور وتسجيل الدخول/الخروج"

#. module: dekad_website
#. odoo-python
#: code:addons/dekad_website/data/app_data.py:0
msgid "Audience Segmentation & Lists"
msgstr "تقسيم الجمهور والقوائم"

#. module: dekad_website
#. odoo-python
#: code:addons/dekad_website/data/app_data.py:0
msgid "Audience Targeting & Filters"
msgstr "استهداف الجمهور والفلاتر"

#. module: dekad_website
#. odoo-python
#: code:addons/dekad_website/data/industry_data.py:0
msgid "Audit & Certification Management"
msgstr "إدارة التدقيق وإصدار الشهادات"

#. module: dekad_website
#. odoo-python
#: code:addons/dekad_website/data/industry_data.py:0
msgid "Audit Scheduling"
msgstr "جدولة عمليات التدقيق"

#. module: dekad_website
#. odoo-python
#: code:addons/dekad_website/data/app_data.py:0
msgid ""
"Audit-friendly version control, logs, and controlled sharing ensure "
"compliance and data security."
msgstr ""
"التحكم بالإصدارات والسجلات والمشاركة المضبوطة بما يناسب التدقيق يضمن "
"الامتثال وأمن البيانات."

#. module: dekad_website
#. odoo-python
#: code:addons/dekad_website/data/app_data.py:0
msgid ""
"Authenticate signers via SMS or itsme®, capture IP address/time stamps, and "
"embed cryptographic traces in audit logs."
msgstr ""
"تحقّق من هوية الموقّعين عبر SMS أو itsme®، وسجّل عنوان IP والطوابع الزمنية، "
"وضمّن آثاراً مشفّرة في سجلات التدقيق."

#. module: dekad_website
#. odoo-python
#: code:addons/dekad_website/data/app_data.py:0
msgid "Auto WebP Conversion & Compression"
msgstr "تحويل تلقائي إلى WebP مع الضغط"

#. module: dekad_website
#. odoo-python
#: code:addons/dekad_website/data/industry_data.py:0
msgid "Automate Compliance"
msgstr "أتمتة الامتثال"

#. module: dekad_website
#. odoo-python
#: code:addons/dekad_website/data/app_data.py:0
msgid ""
"Automate campaigns to target lost leads with custom filters, optimizing "
"opportunities for re-engagement"
