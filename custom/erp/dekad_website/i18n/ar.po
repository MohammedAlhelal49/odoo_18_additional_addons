#. module: dekad_website
#: model_terms:ir.ui.view,arch_db:dekad_website.view_dekad_client_import_wizard_form
msgid ""
"Upload the HTML file that contains one\n"
"                    <code>&lt;div class=\"company-card\" data-title=\"...\" data-image=\"...\" data-text=\"...\"&gt;</code>\n"
