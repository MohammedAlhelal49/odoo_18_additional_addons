    <!-- ============================================================ -->
    <!-- العنوان والوصف العربي الافتراضي                              -->
    <!-- بيطبق على الصفحات العربية بس، وبس إذا الصفحة ما إلها عنوان/وصف -->
    <!-- محدد من Promote (SEO) بالـ backend، هيك ما منكسر إعدادات الصفحات -->
    <!-- ============================================================ -->
    <template id="alomran_seo_title_desc" inherit_id="website.layout" name="Alomran Arabic SEO Title and Description">
        <!-- og:title / og:description للصفحات اللي إلها عنوان خاص من الكونترولر (بدل اسم الـ template) -->
        <xpath expr="//t[@t-set='opengraph_meta']" position="after">
            <t t-if="alomran_page_title and opengraph_meta and not (seo_object and 'website_meta_title' in seo_object and seo_object.website_meta_title)"
               t-set="opengraph_meta" t-value="{**opengraph_meta, 'og:title': alomran_page_title, 'og:description': alomran_page_description or opengraph_meta.get('og:description')}"/>
        </xpath>
        <xpath expr="//t[@t-set='twitter_meta']" position="after">
            <t t-if="alomran_page_title and twitter_meta and not (seo_object and 'website_meta_title' in seo_object and seo_object.website_meta_title)"
               t-set="twitter_meta" t-value="{**twitter_meta, 'twitter:title': alomran_page_title, 'twitter:description': alomran_page_description or twitter_meta.get('twitter:description')}"/>
        </xpath>
        <xpath expr="//head/title" position="replace">
            <t t-set="alomran_is_ar" t-value="request and request.env.lang and request.env.lang.startswith('ar')"/>
            <t t-set="alomran_seo_obj" t-value="seo_object or main_object"/>
            <t t-set="alomran_has_title" t-value="alomran_seo_obj and 'website_meta_title' in alomran_seo_obj and alomran_seo_obj.website_meta_title"/>
            <!-- alomran_page_title: عنوان خاص بالصفحة بيبعته الكونترولر (بس إذا ما في عنوان من Promote) -->
            <title t-if="alomran_page_title and not alomran_has_title" t-out="alomran_page_title"/>
            <title t-elif="alomran_is_ar and not alomran_has_title">دورات لغة إنجليزية ومتابعة دراسية ودورات مهنية في الإمارات | مركز العمران</title>
            <title t-else="" t-esc="title or 'Odoo'"/>
        </xpath>
        <xpath expr="//head/meta[@name='description']" position="replace">
            <t t-set="alomran_is_ar" t-value="request and request.env.lang and request.env.lang.startswith('ar')"/>
            <t t-set="alomran_seo_obj" t-value="seo_object or main_object"/>
            <t t-set="alomran_has_desc" t-value="alomran_seo_obj and 'website_meta_description' in alomran_seo_obj and alomran_seo_obj.website_meta_description"/>
            <t t-if="alomran_page_description and not alomran_has_desc and not editable">
                <meta name="description" t-att-content="alomran_page_description"/>
            </t>
            <t t-elif="alomran_is_ar and not alomran_has_desc and not editable">
                <meta name="description" content="مركز العمران للتدريب والتطوير: دورات لغة إنجليزية وIELTS ومتابعة دراسية ودورات مهنية للنساء في العين ودبي وأبوظبي والشارقة. معتمد منذ 2010."/>
            </t>
            <t t-else="">
                <meta t-if="meta_description or editable" name="description" t-att-content="meta_description"/>
            </t>
        </xpath>
    </template>

    <!-- ============================================================ -->
    <!-- ChatGPT Ads (OpenAI) Measurement Pixel                       -->
    <!-- الإعدادات من System Parameters:                               -->
    <!--   alomran.openai_pixel_id / alomran.openai_pixel_debug        -->
    <!-- window.alomranTrackLead(event_id) بيبعت lead_created         -->
    <!-- ============================================================ -->
    <template id="alomran_openai_pixel" inherit_id="website.layout" name="Alomran ChatGPT Ads Pixel">
        <xpath expr="//head" position="inside">
            <!-- ملاحظة: request.env['ir.config_parameter'].sudo() هو recordset فاضي = False،
                 لهيك منفحص request لحاله (كان الـ Pixel ما عم ينرسم أبداً) -->
            <t t-set="alomran_oai_icp" t-value="request.env['ir.config_parameter'].sudo() if request else None"/>
            <!-- alomran_oai_pixel_override: Pixel خاص بالصفحة (مثلاً حملة الإنجليزي) بيبعته الكونترولر -->
            <t t-set="alomran_oai_pixel" t-value="alomran_oai_pixel_override or (request and (alomran_oai_icp.get_param('alomran.openai_pixel_id') or 'Hq3DiNGCoatRs8hZmvdVuz').strip())"/>
            <t t-set="alomran_oai_debug" t-value="request and (alomran_oai_icp.get_param('alomran.openai_pixel_debug') or 'False').strip().lower() in ('true', '1', 'yes')"/>
            <script t-if="alomran_oai_pixel" t-att-data-pixel-id="alomran_oai_pixel" t-att-data-debug="'1' if alomran_oai_debug else '0'">
                !function(w,d,s,u){if(w.oaiq)return;var q=function(){q.q.push(arguments)};q.q=[];w.oaiq=q;var j=d.createElement(s);j.async=1;j.src=u;var f=d.getElementsByTagName(s)[0];f.parentNode.insertBefore(j,f)}(window,document,"script","https://bzrcdn.openai.com/sdk/oaiq.min.js");
                (function () {
                    var el = document.currentScript;
                    oaiq("init", {pixelId: el.getAttribute('data-pixel-id'), debug: el.getAttribute('data-debug') === '1'});
                })();
            </script>
        </xpath>
    </template>

    <!-- ============================================================ -->
    <!-- Conversion Tracking (GA4 + Google Ads + ChatGPT Ads)          -->
    <!-- window.alomranTrackLead(event_id) — بتستدعيها كل فورمات الموقع -->
    <!--   ChatGPT Ads: lead_created                                   -->
    <!--   GA4: generate_lead (اعمله Key Event بـ GA4)                  -->
    <!--   Google Ads: conversion إذا الإعدادات موجودة                  -->
    <!-- نقرات واتساب والاتصال: whatsapp_click / phone_click             -->
    <!-- gclid / gbraid / wbraid بينحفظوا 90 يوم: alomranGetClickIds()  -->
    <!-- System Parameters (اختيارية):                                  -->
    <!--   alomran.gads_conversion_id   مثل AW-123456789              -->
    <!--   alomran.gads_lead_label      label تحويل الفورم             -->
    <!--   alomran.gads_whatsapp_label  label تحويل نقرة واتساب        -->
    <!--   alomran.gads_call_label      label تحويل نقرة الاتصال       -->
    <!-- ============================================================ -->
    <template id="alomran_conversion_tracking" inherit_id="website.layout" name="Alomran Conversion Tracking">
        <xpath expr="//head" position="inside">
            <t t-set="alomran_ct_icp" t-value="request.env['ir.config_parameter'].sudo() if request else None"/>
            <script t-att-data-aw="request and (alomran_ct_icp.get_param('alomran.gads_conversion_id') or '').strip()"
                    t-att-data-lead="request and (alomran_ct_icp.get_param('alomran.gads_lead_label') or '').strip()"
                    t-att-data-wa="request and (alomran_ct_icp.get_param('alomran.gads_whatsapp_label') or '').strip()"
                    t-att-data-call="request and (alomran_ct_icp.get_param('alomran.gads_call_label') or '').strip()">
                <![CDATA[
                (function () {
                    var el = document.currentScript;
                    var LABEL_RE = /^[A-Za-z0-9_\-]{1,64}$/;
                    var aw = el.getAttribute('data-aw') || '';
                    if (!/^AW-\d{6,15}$/.test(aw)) { aw = ''; }
                    function label(name) {
                        var v = el.getAttribute(name) || '';
                        return (aw && LABEL_RE.test(v)) ? v : '';
                    }
                    var leadLabel = label('data-lead'), waLabel = label('data-wa'), callLabel = label('data-call');

                    window.dataLayer = window.dataLayer || [];
                    function gt() { window.dataLayer.push(arguments); }
                    if (aw) { gt('config', aw); }

                    // ---- Ad click IDs (90 days) ----
                    var CLICK_KEY = 'alomran_click_ids', CLICK_TTL = 90 * 24 * 3600 * 1000;
                    try {
                        var params = new URLSearchParams(window.location.search), found = {}, has = false;
                        ['gclid', 'gbraid', 'wbraid'].forEach(function (k) {
                            var v = params.get(k);
                            if (v && /^[A-Za-z0-9_\-]{10,200}$/.test(v)) { found[k] = v; has = true; }
                        });
                        if (has) {
                            found.t = Date.now();
                            window.localStorage.setItem(CLICK_KEY, JSON.stringify(found));
                        }
                    } catch (e) {}
                    window.alomranGetClickIds = function () {
                        try {
                            var data = JSON.parse(window.localStorage.getItem(CLICK_KEY) || 'null');
                            if (!data || !data.t || Date.now() - data.t > CLICK_TTL) { return {}; }
                            return {gclid: data.gclid || '', gbraid: data.gbraid || '', wbraid: data.wbraid || ''};
                        } catch (e) { return {}; }
                    };

                    // ---- Lead conversion (all forms) ----
                    window.alomranTrackLead = function (eventId) {
                        if (!eventId) { return; }
                        eventId = String(eventId);
                        if (window.oaiq) {
                            try { window.oaiq("measure", "lead_created", {type: "customer_action"}, {event_id: eventId}); } catch (e) {}
                        }
                        gt('event', 'generate_lead', {lead_id: eventId, page_path: window.location.pathname});
                        if (leadLabel) {
                            gt('event', 'conversion', {send_to: aw + '/' + leadLabel, transaction_id: eventId});
                        }
                    };

                    // ---- WhatsApp / phone clicks (all pages) ----
                    document.addEventListener('click', function (ev) {
                        var a = ev.target && ev.target.closest ? ev.target.closest('a[href]') : null;
                        if (!a) { return; }
                        var href = a.getAttribute('href') || '';
                        if (/(wa\.me\/|api\.whatsapp\.com|whatsapp:\/\/)/i.test(href)) {
                            gt('event', 'whatsapp_click', {page_path: window.location.pathname});
                            if (waLabel) { gt('event', 'conversion', {send_to: aw + '/' + waLabel}); }
                        } else if (/^tel:/i.test(href)) {
                            gt('event', 'phone_click', {page_path: window.location.pathname});
                            if (callLabel) { gt('event', 'conversion', {send_to: aw + '/' + callLabel}); }
                        }
                    }, true);
                })();
                ]]>
            </script>
        </xpath>
    </template>

</odoo>