            <style type="text/css">
    <![CDATA[
    /* Global */
    * {
        margin: 0;
        padding: 0;
        box-sizing: border-box;
    }

    body {
        direction: ltr !important;
        font-family: 'Tajawal', sans-serif !important;
        overflow-x: hidden;
        background: #f8fafc;
    }

    html {
        scroll-behavior: smooth;
        overflow-x: hidden;
    }

    .container {
        max-width: 1200px;
        margin: 0 auto;
        padding: 0 15px;
    }

    /* Animations */
    @keyframes gradientShift {
        0% { background-position: 0% 50%; }
        50% { background-position: 100% 50%; }
        100% { background-position: 0% 50%; }
    }

    @keyframes float {
        0%, 100% { transform: translateY(0); }
        50% { transform: translateY(-20px); }
    }

    @keyframes glow {
        0%, 100% { box-shadow: 0 0 20px rgba(26, 84, 144, 0.3); }
        50% { box-shadow: 0 0 40px rgba(26, 84, 144, 0.6); }
    }

    @keyframes scaleUp {
        from { opacity: 0; transform: scale(0.8); }
        to { opacity: 1; transform: scale(1); }
    }

    .animate-float { animation: float 3s ease-in-out infinite; }
    .animate-glow { animation: glow 2s ease-in-out infinite; }
    .animate-scale { animation: scaleUp 0.8s ease-out both; }

    .delay-1 { animation-delay: 0.2s; }
    .delay-2 { animation-delay: 0.4s; }
    .delay-3 { animation-delay: 0.6s; }
    .delay-4 { animation-delay: 0.8s; }

    /* Hero Section */
     .hero-section {
        position: relative;
        background-image: url('/alomran_theme/static/src/img/hero-bg.jpg');
        background-size: cover;
        background-position: center;
        background-repeat: no-repeat;
        background-attachment: scroll;
        overflow: hidden;
        z-index: 1;
    }

    /* Overlay for text only */
    .hero-section::before {
        content: '';
        position: absolute;
        top: 0;
        left: 0;
        right: 0;
        bottom: 0;
        background: linear-gradient(
            to bottom,
            rgba(26, 84, 144, 0.3) 0%,
            rgba(26, 84, 144, 0.5) 50%,
            rgba(26, 84, 144, 0.7) 100%
        );
        z-index: 1;
    }

    .hero-content {
        position: relative;
        z-index: 10;
    }

    /* Text Shadow for clarity */
    .hero-content h1 {
        text-shadow:
            0 2px 10px rgba(0, 0, 0, 0.9),
            0 4px 20px rgba(0, 0, 0, 0.7);
        font-weight: 900 !important;
    }

    .hero-content p {
        text-shadow: 0 2px 8px rgba(0, 0, 0, 0.8);
    }

    .hero-content .glass-card {
        background: rgba(0, 0, 0, 0.4);
        backdrop-filter: blur(10px);
        border: 1px solid rgba(255, 255, 255, 0.3);
    }

    /* Glass Card */
    .glass-card {
        background: rgba(255, 255, 255, 0.15);
        backdrop-filter: blur(10px);
        border: 1px solid rgba(255, 255, 255, 0.2);
        border-radius: 24px;
        padding: 2rem;
        box-shadow: 0 8px 32px rgba(0, 0, 0, 0.1);
        transition: all 0.3s;
    }

    .glass-card:hover {
        transform: translateY(-5px);
    }

    /* Stat Card */
    .stat-card {
        background: white;
        border-radius: 24px;
        padding: 2.5rem;
        transition: all 0.4s;
        border: 2px solid transparent;
    }

    .stat-card:hover {
        transform: translateY(-15px) scale(1.05);
        border-color: #1a5490;
        box-shadow: 0 20px 50px rgba(26, 84, 144, 0.2);
    }

    .stat-card:hover i { animation: float 1s infinite; }

    /* Modern Card */
    .modern-card {
        background: white;
        border-radius: 20px;
        padding: 2rem;
        transition: all 0.4s;
    }

    .modern-card:hover {
        transform: translateY(-15px) scale(1.02);
        box-shadow: 0 20px 40px rgba(26, 84, 144, 0.15);
    }

    .modern-card:hover .card-icon {
        transform: scale(1.2) rotate(10deg);
    }

    .card-icon { transition: all 0.4s; }

    /* Course Card */
    .course-card {
        background: white;
        border-radius: 28px;
        overflow: hidden;
        transition: all 0.5s;
    }

    .course-card .course-header {
        height: 200px;
        background: linear-gradient(135deg, rgba(26, 84, 144, 0.9), rgba(45, 108, 179, 0.9));
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .course-card .course-header i {
        font-size: 5rem;
        color: white;
        transition: all 0.3s;
    }

    .course-card:hover {
        transform: translateY(-20px);
        box-shadow: 0 30px 60px rgba(26, 84, 144, 0.25);
    }

    .course-card:hover .course-header i {
        transform: scale(1.2) rotate(10deg);
        animation: float 2s infinite;
    }

    /* Buttons */
    .btn {
        font-weight: 600 !important;
        border-radius: 50px !important;
        transition: all 0.3s !important;
    }

    .btn:hover {
        transform: translateY(-3px) !important;
        box-shadow: 0 10px 30px rgba(0, 0, 0, 0.2) !important;
    }

    .btn-primary {
        background: linear-gradient(135deg, #1a5490, #2d6cb3) !important;
        border: none !important;
        color: white !important;
    }

    .btn-light {
        background: white !important;
        color: #1a5490 !important;
    }

    .btn-outline-light {
        border: 2px solid white !important;
        color: white !important;
        background: transparent !important;
    }

    .btn-outline-light:hover {
        background: white !important;
        color: #1a5490 !important;
    }

    /* Badge */
    .badge {
        font-weight: 600;
        padding: 0.5rem 1.5rem;
        border-radius: 50px;
        background: linear-gradient(135deg, #1a5490, #2d6cb3);
        box-shadow: 0 4px 15px rgba(26, 84, 144, 0.3);
    }

    /* Footer */
    footer {
        position: relative;
        z-index: 100;
    }

    footer .hover-primary:hover {
        color: #1a5490 !important;
        padding-left: 5px;
        transition: all 0.3s ease;
    }

    footer .btn-outline-light:hover {
        background: #1a5490 !important;
        border-color: #1a5490 !important;
        transform: translateY(-3px);
    }

    footer h5 {
        position: relative;
        padding-bottom: 10px;
    }

    footer h5::after {
        content: '';
        position: absolute;
        bottom: 0;
        left: 0;
        width: 50px;
        height: 3px;
        background: linear-gradient(135deg, #1a5490, #2d6cb3);
        border-radius: 2px;
    }
.branch-featured {
        position: relative;
        overflow: hidden;
        transition: all 0.4s ease;
    }

    .branch-featured:hover {
        transform: translateY(-10px);
        box-shadow: 0 15px 40px rgba(26, 84, 144, 0.2);
    }

    .branch-featured .branch-image {
        position: relative;
        overflow: hidden;
        border-radius: 12px;
    }

    .branch-featured .branch-image img {
        transition: transform 0.4s ease;
    }

    .branch-featured:hover .branch-image img {
        transform: scale(1.1);
    }

    .branch-featured .badge {
        font-size: 0.75rem;
        padding: 0.5rem 1rem;
    }
    /* Responsive */
    @media (max-width: 768px) {
        .hero-section h1 { font-size: 2rem !important; }
    }
    ]]>
</style>
        </xpath>

