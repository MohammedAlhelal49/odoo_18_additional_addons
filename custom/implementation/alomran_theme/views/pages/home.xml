<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- ============================================================ -->
    <!-- الصفحة الرئيسية — تصميم جديد (alh- classes بـ home_modern.scss) -->
    <!-- النصوص من controllers/home_content.py (المتغير h)              -->
    <!-- ============================================================ -->
    <template id="homepage" name="Homepage">
        <t t-call="website.layout">
            <t t-set="arrow_icon" t-value="'fa-arrow-right' if is_en else 'fa-arrow-left'"/>
            <div id="wrap" class="alh-page">

                <!-- ================= HERO ================= -->
                <section t-attf-class="alh-hero #{'alh-hero-media-on' if hero_media else ''} #{'has-photo' if home_images.get('hero') else ''}">
                    <!-- صورة المركز بالخلفية: طبقة كحلية للوضوح + زووم بطيء (CSS بس) -->
                    <div t-if="home_images.get('hero')" t-attf-class="alh-hero-photo #{'is-still' if hero_media else ''} #{'' if hero_media else 'is-center'}" aria-hidden="true">
                        <img t-att-src="home_images.get('hero')" alt="" fetchpriority="high" decoding="async"/>
                    </div>
                    <div class="alh-hero-deco" aria-hidden="true">
                        <span class="alh-blob alh-blob-1"/>
                        <span class="alh-blob alh-blob-2"/>
                        <span class="alh-grid"/>
                    </div>
                    <div class="container position-relative">
                        <div class="row align-items-center g-5">
                            <div t-attf-class="#{'col-lg-6' if hero_media else 'col-lg-9 mx-auto text-center alh-hero-center'}">
                                <span class="alh-badge">
                                    <i class="fa fa-award" aria-hidden="true"/>
                                    <span t-out="h['hero']['badge']"/>
                                </span>
                                <h1 class="alh-title">
                                    <span class="alh-title-accent" t-out="h['hero']['title_1']"/>
                                    <span class="d-block" t-out="h['hero']['title_2']"/>
                                </h1>
                                <p class="alh-lead" t-out="h['hero']['lead']"/>
                                <div class="alh-actions">
                                    <a href="#programs" class="alh-btn alh-btn-accent">
                                        <span t-out="h['hero']['cta_primary']"/>
                                        <i t-attf-class="fa #{arrow_icon}" aria-hidden="true"/>
                                    </a>
                                    <a t-att-href="wa_link" target="_blank" rel="noopener" class="alh-btn alh-btn-glass">
                                        <i class="fab fa-whatsapp" aria-hidden="true"/>
                                        <span t-out="h['hero']['cta_whatsapp']"/>
                                    </a>
                                </div>
                                <ul class="alh-trust list-unstyled">
                                    <t t-foreach="h['hero']['trust']" t-as="tr">
                                        <li>
                                            <i t-attf-class="fa #{tr['icon']}" aria-hidden="true"/>
                                            <span t-out="tr['text']"/>
                                        </li>
                                    </t>
                                </ul>
                            </div>

                            <!-- عمود الوسائط بس مع الفيديو — الصورة صارت بالخلفية -->
                            <div t-if="hero_media" class="col-lg-6">
                                <div class="alh-hero-visual">
                                    <!-- فيديو: alomran.home_hero_video_url أو static/src/video/home_hero.mp4 -->
                                    <div t-if="hero_media" class="alh-media ale-hero-video">
                                        <video autoplay="autoplay" muted="muted" loop="loop" playsinline="playsinline"
                                               disablepictureinpicture="disablepictureinpicture"
                                               preload="auto" aria-hidden="true" tabindex="-1"
                                               t-att-poster="hero_media['poster'] or home_images.get('hero') or None"
                                               class="ale-hero-autoplay">
                                            <source t-att-src="hero_media['url']" t-att-type="hero_media['type']"/>
                                        </video>
                                        <button type="button" class="ale-sound-toggle"
                                                aria-pressed="false"
                                                t-att-aria-label="h['video']['unmute']"
                                                t-att-data-label-unmute="h['video']['unmute']"
                                                t-att-data-label-mute="h['video']['mute']">
                                            <i class="fa fa-volume-xmark" aria-hidden="true"/>
                                            <span class="ale-sound-label" t-out="h['video']['unmute']"/>
                                        </button>
                                    </div>
                                    <div class="alh-float alh-float-1">
                                        <i class="fa fa-user-graduate" aria-hidden="true"/>
                                        <span>
                                            <strong dir="ltr" t-out="h['hero']['float_1']['value']"/>
                                            <small t-out="h['hero']['float_1']['label']"/>
                                        </span>
                                    </div>
                                    <div class="alh-float alh-float-2">
                                        <i class="fa fa-layer-group" aria-hidden="true"/>
                                        <span>
                                            <strong dir="ltr" t-out="h['hero']['float_2']['value']"/>
                                            <small t-out="h['hero']['float_2']['label']"/>
                                        </span>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </section>

                <!-- ================= STATS (فوق حافة الهيرو) ================= -->
                <div class="container alh-stats-wrap">
                    <ul class="alh-stats list-unstyled">
                        <t t-foreach="h['stats']" t-as="st">
                            <li>
                                <i t-attf-class="fa #{st['icon']}" aria-hidden="true"/>
                                <strong dir="ltr" t-out="st['value']"/>
                                <span t-out="st['label']"/>
                            </li>
                        </t>
                    </ul>
                </div>

                <!-- ================= PROGRAMS ================= -->
                <section id="programs" class="alh-section">
                    <div class="container">
                        <div class="alh-head">
                            <span class="alh-eyebrow" t-out="h['programs']['eyebrow']"/>
                            <h2 class="alh-h2" t-out="h['programs']['title']"/>
                            <p t-out="h['programs']['subtitle']"/>
                        </div>
                        <div class="row g-4">
                            <t t-foreach="h['programs']['items']" t-as="p">
                                <div class="col-lg-4 col-md-6" data-aos="fade-up" t-att-data-aos-delay="p_index * 100 or None">
                                    <a t-att-href="p['link']" t-attf-class="alh-program alh-program-#{p['key']}">
                                        <span class="alh-program-top">
                                            <span class="alh-program-icon"><i t-attf-class="fa #{p['icon']}" aria-hidden="true"/></span>
                                            <span class="alh-program-badge" t-out="p['badge']"/>
                                        </span>
                                        <span class="alh-program-title" t-out="p['title']"/>
                                        <span class="alh-program-text" t-out="p['text']"/>
                                        <span class="alh-tags">
                                            <t t-foreach="p['tags']" t-as="tg">
                                                <span t-out="tg"/>
                                            </t>
                                        </span>
                                        <span class="alh-program-cta">
                                            <span t-out="p['cta']"/>
                                            <i t-attf-class="fa #{arrow_icon}" aria-hidden="true"/>
                                        </span>
                                    </a>
                                </div>
                            </t>
                        </div>
                        <div class="text-center mt-5">
                            <a href="/courses" class="alh-btn alh-btn-outline">
                                <i class="fa fa-list" aria-hidden="true"/>
                                <span t-out="h['programs']['all']"/>
                            </a>
                        </div>
                    </div>
                </section>

                <!-- ================= WHY ================= -->
                <section class="alh-section alh-section-soft">
                    <div class="container">
                        <div class="row g-5 align-items-center">
                            <div class="col-lg-4">
                                <div class="alh-why-intro">
                                    <span class="alh-eyebrow" t-out="h['why']['eyebrow']"/>
                                    <h2 class="alh-h2" t-out="h['why']['title']"/>
                                    <p t-out="h['why']['subtitle']"/>
                                    <div class="alh-seal">
                                        <img t-if="home_images.get('logo')" t-att-src="home_images['logo']"
                                             t-att-alt="h['why']['logo_alt']" loading="lazy"/>
                                        <span t-else="" class="alh-seal-icon"><i class="fa fa-award" aria-hidden="true"/></span>
                                        <p t-out="h['why']['seal']"/>
                                    </div>
                                </div>
                            </div>
                            <div class="col-lg-8">
                                <div class="row g-3">
                                    <t t-foreach="h['why']['items']" t-as="w">
                                        <div class="col-md-6" data-aos="fade-up" t-att-data-aos-delay="(w_index % 2) * 100 or None">
                                            <div class="alh-feature">
                                                <span class="alh-feature-icon"><i t-attf-class="fa #{w['icon']}" aria-hidden="true"/></span>
                                                <span>
                                                    <strong t-out="w['title']"/>
                                                    <small t-out="w['text']"/>
                                                </span>
                                            </div>
                                        </div>
                                    </t>
                                </div>
                            </div>
                        </div>
                    </div>
                </section>

                <!-- ================= BRANCHES ================= -->
                <section class="alh-section alh-branches">
                    <div class="container position-relative">
                        <div class="alh-head alh-head-light">
                            <span class="alh-eyebrow" t-out="h['branches']['eyebrow']"/>
                            <h2 class="alh-h2" t-out="h['branches']['title']"/>
                            <p t-out="h['branches']['subtitle']"/>
                        </div>
                        <!-- بطاقة لكل إمارة: دبي / أبوظبي / العين (من بيانات الفروع) -->
                        <div class="row g-4 justify-content-center">
                            <t t-foreach="home_cities" t-as="hc">
                                <div class="col-lg-4 col-md-6" data-aos="zoom-in" t-att-data-aos-delay="hc_index * 100 or None">
                                    <div class="alh-branch alh-city">
                                        <span class="alh-branch-icon"><i t-attf-class="fa #{hc['icon']}" aria-hidden="true"/></span>
                                        <h3 t-out="hc['title']"/>
                                        <span class="alh-city-count" t-out="hc['count']"/>
                                        <ul class="alh-city-list list-unstyled">
                                            <t t-foreach="hc['branches']" t-as="cb">
                                                <li>
                                                    <a t-attf-href="/branch/#{cb['slug']}">
                                                        <i class="fa fa-location-dot" aria-hidden="true"/>
                                                        <span t-out="cb['title']"/>
                                                    </a>
                                                </li>
                                            </t>
                                        </ul>
                                        <a t-att-href="hc['url']" class="alh-city-cta">
                                            <span t-out="hc['cta']"/>
                                            <i t-attf-class="fa #{arrow_icon}" aria-hidden="true"/>
                                        </a>
                                    </div>
                                </div>
                            </t>
                        </div>
                        <div class="text-center mt-5">
                            <a href="/branches" class="alh-btn alh-btn-light">
                                <i class="fa fa-map-location-dot" aria-hidden="true"/>
                                <span t-out="h['branches']['all']"/>
                            </a>
                        </div>
                    </div>
                </section>

                <!-- ================= FINAL CTA ================= -->
                <section class="alh-section alh-cta-section">
                    <div class="container">
                        <div class="alh-cta">
                            <div>
                                <h2 class="alh-h2" t-out="h['cta']['title']"/>
                                <p t-out="h['cta']['text']"/>
                            </div>
                            <div class="alh-actions">
                                <a href="/contact" class="alh-btn alh-btn-accent">
                                    <i class="fa fa-phone" aria-hidden="true"/>
                                    <span t-out="h['cta']['contact']"/>
                                </a>
                                <a t-att-href="wa_link" target="_blank" rel="noopener" class="alh-btn alh-btn-wa">
                                    <i class="fab fa-whatsapp" aria-hidden="true"/>
                                    <span t-out="h['cta']['whatsapp']"/>
                                </a>
                            </div>
                        </div>
                    </div>
                </section>

            </div>
        </t>
    </template>
</odoo>