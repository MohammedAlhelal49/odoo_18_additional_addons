<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Company name + stamp, shown directly above the footer of every external layout -->
    <template id="company_stamp_block">
        <t t-set="hp_sign_doc" t-value="o if o and (o._name == 'sale.order' or o._name == 'stock.picking' and o.picking_type_code == 'outgoing' or o._name == 'account.move' and o.move_type in ('out_invoice', 'out_refund')) else False"/>
        <!-- deliveries: only "Checked by / Receiver Sign" (no payment terms / bank) -->
        <t t-set="hp_sign_only" t-value="bool(o and o._name == 'stock.picking' and o.picking_type_code == 'outgoing')"/>
        <!-- invoices + quotations / sales orders: extra room on top for the payment terms / sign block (hp_paperformat_invoice has more bottom margin) -->
        <div class="o_hp_company_stamp text-end mb-2" t-attf-style="padding-top: {{hp_sign_doc and not hp_sign_only and '148px' or '22px'}}; position: relative;">
            <!-- Customer invoice / credit note / quotation / sales order: payment terms + bank details + "Checked by / Receiver Sign" opposite the
                 company name + stamp, last page only (PDF: hidden on the other pages by the script below, wkhtmltopdf
                 passes sitepage / sitepages in the footer URL). Anchored at the bottom so it grows upwards. -->
            <div t-if="hp_sign_doc" name="hp_receiver_sign" class="o_hp_last_page_only text-start"
                 style="position: absolute; left: 0; bottom: 92px; width: 60%;">
                <t t-call="health_protection_implementation.hp_terms_sign_block">
                    <t t-set="payment_term" t-value="hp_sign_doc.payment_term_id if hp_sign_doc._name == 'sale.order' else hp_sign_doc.invoice_payment_term_id if hp_sign_doc._name == 'account.move' else False"/>
                    <t t-set="hp_terms_margin_top" t-value="'0'"/>
                </t>
            </div>
            <script t-if="hp_sign_doc and report_type == 'pdf'">
                (function () {
                    var vars = {};
                    document.location.search.substring(1).split(String.fromCharCode(38)).forEach(function (part) {
                        var kv = part.split('=', 2);
                        vars[kv[0]] = decodeURIComponent(kv[1] || '');
                    });
                    if (vars.sitepage &amp;&amp; vars.sitepage !== vars.sitepages) {
                        Array.prototype.forEach.call(document.getElementsByClassName('o_hp_last_page_only'), function (el) {
                            el.style.visibility = 'hidden';
                        });
                    }
                })();
            </script>
            <h5 class="mb-3" style="color: #000; font-weight: 600; font-size: 1.45rem;" t-out="company.name"/>
            <img t-if="company.stamp" t-att-src="image_data_uri(company.stamp)"
                 style="max-height: 115px; max-width: 280px;" alt="Stamp"/>
        </div>
    </template>

    <template id="external_layout_striped_stamp" inherit_id="web.external_layout_striped">
        <xpath expr="//div[hasclass('o_footer_content')]" position="before">
            <t t-call="health_protection_implementation.company_stamp_block"/>
        </xpath>
    </template>
    <template id="external_layout_boxed_stamp" inherit_id="web.external_layout_boxed">
        <xpath expr="//div[hasclass('o_footer_content')]" position="before">
            <t t-call="health_protection_implementation.company_stamp_block"/>
        </xpath>
    </template>
    <template id="external_layout_bold_stamp" inherit_id="web.external_layout_bold">
        <xpath expr="//div[hasclass('o_footer_content')]" position="before">
            <t t-call="health_protection_implementation.company_stamp_block"/>
        </xpath>
    </template>
    <template id="external_layout_standard_stamp" inherit_id="web.external_layout_standard">
        <xpath expr="//div[hasclass('o_footer_content')]" position="before">
            <t t-call="health_protection_implementation.company_stamp_block"/>
        </xpath>
    </template>
    <template id="external_layout_folder_stamp" inherit_id="web.external_layout_folder">
        <xpath expr="//div[hasclass('o_footer_content')]" position="before">
            <t t-call="health_protection_implementation.company_stamp_block"/>
        </xpath>
    </template>
    <template id="external_layout_wave_stamp" inherit_id="web.external_layout_wave">
        <xpath expr="//div[contains(@t-attf-class, 'o_footer_content')]" position="before">
            <t t-call="health_protection_implementation.company_stamp_block"/>
        </xpath>
    </template>
    <template id="external_layout_bubble_stamp" inherit_id="web.external_layout_bubble">
        <!-- Keep the document content (address + title) away from the header bubble -->
        <xpath expr="//div[contains(@t-attf-class, 'o_report_layout_bubble')]/div[1]" position="attributes">
            <attribute name="style">padding-top: 10px;</attribute>
        </xpath>
        <!-- Logo ~33% bigger than the default o_company_logo (6rem x 12rem) -->
        <xpath expr="//img[hasclass('o_company_logo')]" position="attributes">
            <attribute name="style">max-height: 8rem; max-width: 16rem;</attribute>
        </xpath>
        <!-- Company details in the header: bold, coloured company name (HEALTH / MEDICAL SUPPLY blue, PROTECTION dark, one line kept inside the bubble) + TRN; phone removed (already in the footer) -->
        <xpath expr="//div[@name='company_address']" position="attributes">
            <attribute name="style">color: #000; font-weight: bold;</attribute>
        </xpath>
        <xpath expr="//ul[@name='company_address_list']" position="replace">
            <div style="display: table; margin: 0 0 1rem auto;">
                <div style="text-transform: uppercase; font-size: 1.25rem; white-space: nowrap;"><span style="color: #3a7796;">Health</span> <span style="color: #22384d;">Protection</span> <span style="color: #3a7796;">Medical Supply</span></div>
                <!-- Tapered underline like the one under the logo wordmark, ~80% of the title width (PNG: wkhtmltopdf does not print CSS backgrounds in the header) -->
                <img alt="" style="display: block; width: 80%; height: 4px; margin: 4px auto 0;" src="data:image/png;base64,"/>
            </div>
            <p t-if="company.vat">TRN : <span t-out="company.vat"/></p>
        </xpath>
        <!-- QR code in the footer, under the phone number (far left), on every document: the document's portal link
             (quotation / order, customer invoice, purchase order, delivery -> its invoice or order), else the website -->
        <xpath expr="//div[contains(@t-attf-class, 'o_footer_content')]/div[@t-field='company.report_footer']" position="after">
            <t t-set="hp_qr_doc" t-value="o if o and len(o) == 1 else company"/>
            <div name="hp_portal_qr" style="position: relative; height: 0;">
                <img t-att-src="hp_qr_doc.hp_footer_qr_data_uri()" style="position: absolute; left: 0; top: -4mm; width: 11mm; height: 11mm;" alt="QR Code"/>
            </div>
        </xpath>
        <!-- No bottom bubble: only the top one is kept -->
        <xpath expr="//div[contains(@t-attf-class, 'footer o_company_')]/*[local-name()='svg']" position="replace"/>
        <!-- PDF: stamp sits above the fixed footer -->
        <xpath expr="//div[contains(@t-attf-class, 'o_footer_content')]" position="before">
            <t t-if="report_type == 'pdf'" t-call="health_protection_implementation.company_stamp_block"/>
        </xpath>
        <!-- HTML (portal / preview): the footer content is absolutely positioned at the bottom,
             so put the stamp inside it and give the footer enough height for both -->
        <xpath expr="//div[contains(@t-attf-class, 'o_footer_content')]/div[1]" position="before">
            <t t-if="report_type != 'pdf'" t-call="health_protection_implementation.company_stamp_block"/>
        </xpath>
        <xpath expr="//div[contains(@t-attf-class, 'footer o_company_')]" position="attributes">
            <attribute name="t-attf-style">{{report_type != 'pdf' and 'min-height: 430px;' or ''}}</attribute>
        </xpath>
    </template>

    <!-- Make room for the stamp block in the PDF footer area -->
    <function model="report.paperformat" name="write">
        <value eval="[ref('base.paperformat_euro')]"/>
        <value eval="{'margin_top': 57, 'header_spacing': 57, 'margin_bottom': 78}"/>
    </function>
</odoo>
