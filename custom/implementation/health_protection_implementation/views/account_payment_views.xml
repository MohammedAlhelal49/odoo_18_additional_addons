<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_account_payment_form_hp_cheque" model="ir.ui.view">
        <field name="name">account.payment.form.hp.cheque</field>
        <field name="model">account.payment</field>
        <field name="inherit_id" ref="account.view_account_payment_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='payment_method_line_id']" position="after">
                <field name="hp_is_cheque"/>
                <field name="hp_cheque_number" invisible="not hp_is_cheque"/>
                <field name="hp_cheque_bank" invisible="not hp_is_cheque"/>
                <field name="hp_cheque_date" invisible="not hp_is_cheque"/>
                <field name="hp_cheque_due_date" invisible="not hp_is_cheque"/>
            </xpath>
        </field>
    </record>
</odoo>
