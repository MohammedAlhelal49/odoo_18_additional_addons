<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_company_form_stamp" model="ir.ui.view">
        <field name="name">res.company.form.stamp</field>
        <field name="model">res.company</field>
        <field name="inherit_id" ref="base.view_company_form"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='general_info']/group" position="inside">
                <group string="Documents">
                    <field name="stamp" widget="image" options="{'size': [0, 120]}"/>
                    <field name="hp_bank_account"/>
                </group>
            </xpath>
        </field>
    </record>
</odoo>
