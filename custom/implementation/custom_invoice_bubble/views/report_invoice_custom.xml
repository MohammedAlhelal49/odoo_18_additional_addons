<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- 1. The Report Action -->
    <record id="action_report_custom_invoice_bubble" model="ir.actions.report">
        <field name="name">Tax Invoice</field>
        <field name="model">account.move</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">custom_invoice_bubble.report_invoice_bubble_main</field>
        <field name="report_file">custom_invoice_bubble.report_invoice_bubble_main</field>
        <field name="print_report_name">(object._get_report_base_filename() + ' - Bubble')</field>
        <field name="binding_model_id" ref="account.model_account_move"/>
        <field name="binding_type">report</field>
    </record>

    <!-- 2. The Main Template -->
    <template id="report_invoice_bubble_main">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t t-set="lang" t-value="o.partner_id.lang"/>
                <t t-call="custom_invoice_bubble.report_invoice_bubble_document" t-lang="lang"/>
            </t>
        </t>
    </template>

    <!-- 3. The Document Template -->
    <template id="report_invoice_bubble_document">

        <!-- Context Setup -->
        <t t-set="company" t-value="o.company_id or res_company"/>
        <t t-set="currency" t-value="o.currency_id"/>

        <!-- Dynamic Partner & TRN Fallbacks -->
        <t t-set="display_trn" t-value="o.invoice_trn or o.partner_id.vat"/>

        <t t-set="address">
            <div class="mb-0">
                <!-- Display override text if set, otherwise fall back to partner contact card -->
                <t t-if="o.invoice_company">
                    <strong>
                        <span t-esc="o.invoice_company"/>
                    </strong>
                    <div t-field="o.partner_id"
                         t-options='{"widget": "contact", "fields": ["address"], "no_marker": True}'/>
                </t>
                <t t-else="">
                    <address class="mb-0" t-field="o.partner_id"
                             t-options='{"widget": "contact", "fields": ["address", "name"], "no_marker": True}'/>
                </t>
            </div>

            <!-- TRN / Tax ID -->
            <div t-if="display_trn" class="mt-1">
                <t t-if="o.company_id.account_fiscal_country_id.vat_label"
                   t-esc="o.company_id.account_fiscal_country_id.vat_label" id="inv_tax_id_label"/>
                <t t-else="">Tax ID</t>:
                <span t-esc="display_trn"/>
            </div>
        </t>

        <!-- Force Native Bubble Layout -->
        <t t-call="web.external_layout_bubble">
            <t t-set="o" t-value="o.with_context(lang=lang)"/>

            <div class="page">
                <h2>
                    <span t-if="o.move_type == 'out_invoice' and o.state == 'posted'">Invoice</span>
                    <span t-if="o.move_type == 'out_invoice' and o.state == 'draft'">Draft Invoice</span>
                    <span t-if="o.move_type == 'out_invoice' and o.state == 'cancel'">Cancelled Invoice</span>
                    <span t-if="o.move_type == 'out_refund'">Credit Note</span>
                    <span t-if="o.move_type == 'in_refund'">Vendor Credit Note</span>
                    <span t-if="o.move_type == 'in_invoice'">Vendor Bill</span>
                    <span t-if="o.name != '/'" t-field="o.name"/>
                </h2>

                <!-- FIX 1: Changed col-auto to col so they distribute evenly across the page -->
                <div id="informations" class="row mt-4 mb-4">
                    <div class="col mb-2" t-if="o.invoice_date" name="invoice_date">
                        <strong>Invoice Date:</strong>
                        <p class="m-0" t-field="o.invoice_date"/>
                    </div>
                    <div class="col mb-2"
                         t-if="o.invoice_date_due and o.move_type == 'out_invoice' and o.state == 'posted'"
                         name="due_date">
                        <strong>Due Date:</strong>
                        <p class="m-0" t-field="o.invoice_date_due"/>
                    </div>
                    <div class="col mb-2" t-if="o.invoice_origin" name="origin">
                        <strong>Source:</strong>
                        <p class="m-0" t-field="o.invoice_origin"/>
                    </div>
                    <div class="col mb-2" t-if="o.partner_id.ref" name="customer_code">
                        <strong>Customer Code:</strong>
                        <p class="m-0" t-field="o.partner_id.ref"/>
                    </div>
                    <div class="col mb-2" t-if="o.ref" name="reference">
                        <strong>Reference:</strong>
                        <p class="m-0" t-field="o.ref"/>
                    </div>
                </div>

                <!-- Invoice Lines Table -->
                <table class="table table-sm o_main_table table-borderless mt-4" name="invoice_line_table">
                    <thead>
                        <tr>
                            <th name="th_description" class="text-start">
                                <span>Description</span>
                            </th>
                            <th name="th_quantity" class="text-end">
                                <span>Quantity</span>
                            </th>
                            <th name="th_priceunit" class="text-end">
                                <span>Unit Price</span>
                            </th>
                            <th name="th_taxes" class="text-start">
                                <span>Taxes</span>
                            </th>
                            <!-- FIX 3: Added VAT Amount Header -->
                            <th name="th_vat_amount" class="text-end">
                                <span>VAT Amount</span>
                            </th>
                            <th name="th_subtotal" class="text-end">
                                <span>Amount</span>
                            </th>
                        </tr>
                    </thead>
                    <tbody class="invoice_tbody">
                        <t t-set="lines"
                           t-value="o.line_ids.filtered(lambda l: l.display_type in ('product', 'line_section', 'line_note') or not l.display_type)"/>

                        <t t-foreach="lines" t-as="line">
                            <tr t-att-class="'bg-200 fw-bold o_line_section' if line.display_type == 'line_section' else 'fst-italic o_line_note' if line.display_type == 'line_note' else ''">

                                <!-- Standard Product Line -->
                                <t t-if="line.display_type == 'product' or not line.display_type">
                                    <td name="account_invoice_line_name">
                                        <span t-field="line.name" t-options="{'widget': 'text'}"/>
                                    </td>
                                    <td class="text-end">
                                        <span t-field="line.quantity"/>
                                        <span t-field="line.product_uom_id" groups="uom.group_uom"/>
                                    </td>
                                    <td class="text-end">
                                        <span class="text-nowrap" t-field="line.price_unit"/>
                                    </td>
                                    <!-- FIX 2: Properly looping taxes with t-out to resolve HTML tags safely -->
                                    <td class="text-start">
                                        <t t-foreach="line.tax_ids" t-as="tax">
                                            <span t-out="tax.description or tax.name"/>
                                            <t t-if="not tax_last">,</t>
                                        </t>
                                    </td>
                                    <!-- FIX 3: Added VAT Amount calculation per line -->
                                    <td class="text-end">
                                        <span t-esc="line.price_total - line.price_subtotal"
                                              t-options='{"widget": "monetary", "display_currency": o.currency_id}'/>
                                    </td>
                                    <td class="text-end o_price_total">
                                        <span class="text-nowrap" t-field="line.price_subtotal"/>
                                    </td>
                                </t>

                                <!-- Section Header -->
                                <t t-if="line.display_type == 'line_section'">
                                    <td colspan="99">
                                        <span t-field="line.name" t-options="{'widget': 'text'}"/>
                                    </td>
                                </t>

                                <!-- Note -->
                                <t t-if="line.display_type == 'line_note'">
                                    <td colspan="99">
                                        <span t-field="line.name" t-options="{'widget': 'text'}"/>
                                    </td>
                                </t>
                            </tr>
                        </t>
                    </tbody>
                </table>

                <!-- FIX 4: Wrapped the tax totals call in a <table> tag and used justify-content-end -->
                <div class="clearfix mt-4">
                    <div id="total" class="row justify-content-end">
                        <div class="col-5">
                            <table class="table table-sm table-borderless">
                                <t t-set="tax_totals" t-value="o.tax_totals"/>
                                <t t-call="account.document_tax_totals"/>
                            </table>
                        </div>
                    </div>
                </div>

                <!-- Notes & Terms -->
                <p t-if="o.invoice_payment_term_id" name="payment_term">
                    <span t-field="o.invoice_payment_term_id.note"/>
                </p>
                <p t-if="o.narration" name="comment">
                    <span t-field="o.narration"/>
                </p>
                <p t-if="o.fiscal_position_id.note" name="note">
                    <span t-field="o.fiscal_position_id.note"/>
                </p>
            </div>
        </t>
    </template>
</odoo>