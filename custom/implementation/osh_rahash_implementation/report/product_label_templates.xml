<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ===== the label itself (38 x 25 mm) ===== -->
    <template id="report_simple_label2x7" inherit_id="product.report_simple_label2x7">
        <!-- the A4 sizes are not used anymore (and table_style is not set by our 2x7 loop) -->
        <xpath expr="//t[@t-set='barcode_size']" position="replace"/>
        <xpath expr="//t[@t-set='table_style']" position="replace"/>
        <xpath expr="//td" position="replace">
            <t t-set="names" t-value="product._label_names()"/>
            <div style="position: relative; left: -3mm; top: 0; width: 100%; height: 100%; padding: 1.5mm 1.5mm 0 1.5mm; box-sizing: border-box; text-align: center; font-family: Arial, sans-serif; line-height: 1.15; color: #000;">
                <!-- English name, then Arabic under it (one line each) -->
                <div t-if="names['en']" style="font-size: 6.5pt; font-weight: bold; max-height: 1.15em; overflow: hidden;" t-out="names['en']"/>
                <div t-if="names['ar']" dir="rtl" style="font-size: 7pt; font-weight: bold; max-height: 1.2em; overflow: hidden;" t-out="names['ar']"/>
                <div style="height: 1mm;"/>
                <t t-if="barcode">
                    <div t-out="barcode" t-options="{'widget': 'barcode', 'symbology': 'auto', 'img_style': 'width: 34mm; height: 7mm;'}"/>
                    <div style="font-size: 6pt;" t-out="barcode"/>
                </t>
                <div style="font-size: 8pt; font-weight: bold; margin-top: 1.2mm;"
                     t-out="pricelist._get_product_price(product, 1, pricelist.currency_id or product.currency_id)"
                     t-options="{'widget': 'monetary', 'display_currency': pricelist.currency_id or product.currency_id}"/>
            </div>
        </xpath>
    </template>

    <!-- ===== the wrapper: 2x7 = one label per page, no A4 sheet, no table ===== -->
    <template id="report_productlabel" inherit_id="product.report_productlabel">
        <xpath expr="//t[@t-if='columns == 2 and rows == 7']/t[@t-set='padding_page']" position="replace"/>
        <xpath expr="//t[@t-foreach='range(page_numbers)']" position="before">
            <t t-if="report_to_call == '2x7'">
                <t t-set="osh_first" t-value="True"/>
                <t t-foreach="range(page_numbers * rows * columns)" t-as="slot">
                    <t t-if="not current_quantity and quantity and not (current_data and current_data[1])">
                        <t t-set="current_data" t-value="quantity.popitem()"/>
                        <t t-set="product" t-value="current_data[0]"/>
                        <t t-set="barcode_and_qty" t-value="current_data[1].pop()"/>
                        <t t-set="barcode" t-value="barcode_and_qty[0]"/>
                        <t t-set="current_quantity" t-value="barcode_and_qty[1]"/>
                    </t>
                    <t t-if="current_quantity">
                        <t t-set="make_invisible" t-value="False"/>
                        <t t-set="current_quantity" t-value="current_quantity - 1"/>
                    </t>
                    <t t-elif="current_data and current_data[1]">
                        <t t-set="make_invisible" t-value="False"/>
                        <t t-set="barcode_and_qty" t-value="current_data[1].pop()"/>
                        <t t-set="barcode" t-value="barcode_and_qty[0]"/>
                        <t t-set="current_quantity" t-value="barcode_and_qty[1] - 1"/>
                    </t>
                    <t t-else="">
                        <t t-set="make_invisible" t-value="True"/>
                    </t>
                    <!-- empty slots are not printed, so no blank labels -->
                    <t t-if="not make_invisible">
                        <div t-att-style="'width: 38mm; height: 24.6mm; margin: 0; padding: 0; overflow: hidden; page-break-inside: avoid;' + ('' if osh_first else ' page-break-before: always;')">
                            <t t-call="product.report_simple_label2x7"/>
                        </div>
                        <t t-set="osh_first" t-value="False"/>
                    </t>
                </t>
            </t>
        </xpath>
        <!-- 4x7 / 4x12 keep the original A4 sheet -->
        <xpath expr="//t[@t-foreach='range(page_numbers)']" position="attributes">
            <attribute name="t-if">report_to_call != '2x7'</attribute>
        </xpath>
    </template>

</odoo>
