<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- 38 x 25 mm thermal label (Zebra ZD220), one label per page -->
    <record id="paperformat_label_38x25" model="report.paperformat">
        <field name="name">Thermal Label 38 x 25 mm</field>
        <field name="default" eval="False"/>
        <field name="format">custom</field>
        <field name="page_height">25</field>
        <field name="page_width">38</field>
        <field name="orientation">Portrait</field>
        <field name="margin_top">0</field>
        <field name="margin_bottom">0</field>
        <field name="margin_left">0</field>
        <field name="margin_right">0</field>
        <field name="header_line" eval="False"/>
        <field name="header_spacing">0</field>
        <field name="disable_shrinking" eval="True"/>
        <field name="dpi">96</field>
    </record>

    <!-- only "2 x 7 with price" uses it; 4x7 / 4x12 stay on the A4 Label Sheet -->
    <record id="product.report_product_template_label_2x7" model="ir.actions.report">
        <field name="paperformat_id" ref="paperformat_label_38x25"/>
    </record>
</odoo>
