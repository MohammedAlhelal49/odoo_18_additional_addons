<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form_inherit_dekad_default_customer" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.dekad.default.customer</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="account.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <!-- Odoo 19 uses <block id="invoicing_settings"> (Customer Invoices section)
                 inside <app name="account">. We append a new <setting> right after
                 the existing "default_incoterm" setting inside that same block. -->
            <xpath expr="//block[@id='invoicing_settings']/setting[@id='default_incoterm']" position="after">
                <setting id="dekad_default_customer" string="Default Customer"
                         help="Automatically set on new Customer Invoices / Credit Notes when the Customer field is left empty">
                    <field name="dekad_default_customer_id" placeholder="e.g. Walk-in Customer"/>
                </setting>
            </xpath>
        </field>
    </record>
</odoo>