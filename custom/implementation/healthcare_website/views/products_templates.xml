<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <template id="products_page" name="Health Protection Products">
        <t t-call="website.layout">
            <t t-set="pageName" t-value="'products'"/>
            <div id="wrap" class="hp-page">

                <!-- Header band -->
                <section class="hp-prod-hero">
                    <div class="container-xl">
                        <div class="hp-eyebrow"><span class="hp-eyebrow-dot"/>Our Products</div>
                        <h1 class="hp-section-title mb-2">Laboratory products <span class="hp-c-blue">catalog</span></h1>
                        <p class="hp-text mb-4">
                            Reagents, calibrators, controls and consumables for hematology and clinical chemistry.
                            Contact us for availability and a tailored quotation.
                        </p>
                        <form action="/products" method="get" class="hp-prod-search" role="search">
                            <input t-if="family" type="hidden" name="family" t-att-value="family"/>
                            <i class="fa fa-search"/>
                            <input type="search" name="search" t-att-value="search" class="form-control"
                                   placeholder="Search by product name or code..." aria-label="Search products"/>
                            <button type="submit" class="btn hp-btn-primary">Search</button>
                        </form>
                    </div>
                </section>

                <section class="hp-prod-body">
                    <div class="container-xl">
                        <!-- Family filters -->
                        <div class="hp-prod-filters">
                            <a t-attf-href="/products#{'?search=%s' % search if search else ''}"
                               t-attf-class="hp-chip #{'active' if not family else ''}">
                                <i class="fa fa-th-large"/>All <span class="hp-chip-count" t-out="total_count"/>
                            </a>
                            <t t-foreach="families" t-as="fam">
                                <a t-if="fam['count']"
                                   t-attf-href="/products?family=#{fam['key']}#{'&amp;search=%s' % search if search else ''}"
                                   t-attf-class="hp-chip #{'active' if family == fam['key'] else ''}">
                                    <i t-attf-class="fa #{fam['icon']}"/><t t-out="fam['label']"/>
                                    <span class="hp-chip-count" t-out="fam['count']"/>
                                </a>
                            </t>
                        </div>

                        <div class="hp-prod-summary">
                            <span>
                                Showing <b t-out="len(products)"/> of <b t-out="found"/> products
                                <t t-if="search"> for "<b t-out="search"/>"</t>
                            </span>
                            <a t-if="search or family" href="/products" class="hp-prod-reset"><i class="fa fa-times"/> Clear filters</a>
                        </div>

                        <!-- Product cards -->
                        <div t-if="products" class="row g-4">
                            <div t-foreach="products" t-as="product" class="col-sm-6 col-lg-4 col-xxl-3">
                                <t t-set="fam" t-value="product_family[product.id]"/>
                                <div t-attf-class="hp-prod-card hp-fam-#{fam['key']}">
                                    <div class="hp-prod-top">
                                        <span class="hp-prod-icon"><i t-attf-class="fa #{fam['icon']}"/></span>
                                        <span t-if="product.default_code" class="hp-prod-code" t-out="product.default_code"/>
                                    </div>
                                    <span class="hp-prod-family" t-out="fam['label']"/>
                                    <h3 class="hp-prod-name" t-out="product.name"/>
                                    <div class="hp-prod-bottom">
                                        <a t-if="res_company.email"
                                           t-attf-href="mailto:#{res_company.email}?subject=Quotation%20request%3A%20#{product.name}"
                                           class="hp-prod-btn" title="Request a quote"><i class="fa fa-envelope-o"/></a>
                                        <a t-else="" href="/#contact" class="hp-prod-btn" title="Contact us"><i class="fa fa-long-arrow-right"/></a>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div t-else="" class="hp-prod-empty">
                            <i class="fa fa-search"/>
                            <h3>No products found</h3>
                            <p>Try another name or code, or <a href="/products">browse all products</a>.</p>
                        </div>

                        <div t-if="pager['page_count'] &gt; 1" class="hp-prod-pager">
                            <t t-call="website.pager"/>
                        </div>
                    </div>
                </section>

            </div>
        </t>
    </template>

</odoo>
