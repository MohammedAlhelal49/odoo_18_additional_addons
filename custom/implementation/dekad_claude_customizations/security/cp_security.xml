<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Contract & Proposal lines follow the company of their sales order. -->
    <record id="rule_dekad_cp_module_company" model="ir.rule">
        <field name="name">Proposal module: order company</field>
        <field name="model_id" ref="model_dekad_cp_module"/>
        <field name="domain_force">[('order_id.company_id', 'in', company_ids)]</field>
    </record>
    <record id="rule_dekad_cp_phase_company" model="ir.rule">
        <field name="name">Proposal phase: order company</field>
        <field name="model_id" ref="model_dekad_cp_phase"/>
        <field name="domain_force">[('order_id.company_id', 'in', company_ids)]</field>
    </record>
    <record id="rule_dekad_ct_payment_company" model="ir.rule">
        <field name="name">Contract payment: order company</field>
        <field name="model_id" ref="model_dekad_ct_payment"/>
        <field name="domain_force">[('order_id.company_id', 'in', company_ids)]</field>
    </record>
</odoo>
