<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_pos_order_tree_bs_collection" model="ir.ui.view">
        <field name="name">pos.order.list.bs.collection</field>
        <field name="model">pos.order</field>
        <field name="inherit_id" ref="point_of_sale.view_pos_order_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='state']" position="after">
                <field name="bs_collection_status" optional="show" widget="badge"
                       decoration-danger="bs_collection_status == 'credit_unpaid'"
                       decoration-warning="bs_collection_status == 'credit_partial'"
                       decoration-success="bs_collection_status in ('paid', 'credit_paid')"
                       decoration-info="bs_collection_status in ('collection', 'collection_cancelled', 'collection_reversal')"/>
                <field name="bs_credit_remaining" optional="show" sum="Remaining On Credit"/>
                <field name="bs_pending_collection" optional="hide"/>
            </xpath>
        </field>
    </record>

    <record id="view_pos_order_filter_bs_collection" model="ir.ui.view">
        <field name="name">pos.order.select.bs.collection</field>
        <field name="model">pos.order</field>
        <field name="inherit_id" ref="point_of_sale.view_pos_order_filter"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='name']" position="after">
                <filter name="bs_credit_owed" string="On Credit - Unpaid"
                        domain="[('bs_collection_status', 'in', ('credit_unpaid', 'credit_partial'))]"/>
                <filter name="bs_collections" string="Collections"
                        domain="[('bs_is_collection', '=', True)]"/>
            </xpath>
        </field>
    </record>
</odoo>
