<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="report_saleorder_viewsport_document">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t t-call="web.basic_layout">
                    <t t-set="cur" t-value="o.currency_id"/>
                    <t t-set="fmt" t-value="lambda v: '{:,.2f}'.format(v or 0.0)"/>
                    <t t-set="fmt_cur" t-value="lambda v: cur.name + ' ' + '{:,.2f}'.format(v or 0.0)"/>
                    <t t-set="cp" t-value="o.partner_id.commercial_partner_id"/>
                    <t t-set="project" t-value="o._get_project()"/>
                    <t t-call="viewsport_implementation.vs_report_fonts"/>
                    <style>
                        body.o_body_pdf, body.container { padding-left: 0 !important; padding-right: 0 !important; }
                        .vs-qt { font-family: 'VS Sans', 'VS Arabic', Arial, sans-serif; font-size: 14px; color: #000; line-height: 1.2; }
                        .vs-qt table, .vs-qt tr, .vs-qt td, .vs-qt th { border: 0 none; border-color: transparent; }
                        .vs-qt table { border-collapse: collapse; width: 100%; }
                        .vs-qt .vs-box td { border: 1px solid #c0c0c0 !important; padding: 2px 4px; height: 21px; font-size: 14px; vertical-align: middle; }
                        .vs-qt .vs-lbl { background-color: #dddddd; font-weight: bold; text-align: right; white-space: nowrap; }
                        .vs-qt .vs-items th { background-color: #40baec; border: 1px solid #000 !important; text-align: center; font-weight: bold; font-size: 14px; padding: 2px; line-height: 1.1; }
                        .vs-qt .vs-items th small { display: block; font-size: 10.5px; font-weight: bold; }
                        .vs-qt .vs-items td { border-left: 1px solid #000 !important; border-right: 1px solid #000 !important; padding: 2px 3px; vertical-align: middle; font-size: 14px; }
                        .vs-qt .vs-items tr.vs-last td { border-bottom: 1.5px solid #000 !important; }
                        .vs-qt .vs-tot td { border: 1px solid #000 !important; padding: 4px 6px; font-weight: bold; font-size: 13px; }
                        .vs-qt .vs-terms p { margin: 0 0 7px 0; font-size: 13px; }
                    </style>
                    <div class="page vs-qt">

                        <!-- 1. HEADER: logo + TRN -->
                        <table>
                            <tr>
                                <td style="width: 60%; vertical-align: top;">
                                    <img t-if="o.company_id.vs_report_logo" t-att-src="image_data_uri(o.company_id.vs_report_logo)" style="height: 72px;" alt="Viewsport Pitches"/>
                                    <img t-else="" src="/viewsport_implementation/static/src/img/viewsport_logo.png" style="height: 72px;" alt="Viewsport Pitches"/>
                                </td>
                                <td style="width: 40%; vertical-align: top; text-align: right; font-weight: bold; font-size: 15.5px; line-height: 1.3; padding-top: 2px;">
                                    TAX REGISTRATION<br/>
                                    <span style="color: #c00000;">#TRN <t t-esc="o.company_id.vat or ''"/></span>
                                </td>
                            </tr>
                        </table>

                        <!-- 2. TITLE -->
                        <div style="text-align: center; font-weight: bold; font-size: 28px; margin: 34px 0 22px 0;">
                            QUOTATION <span dir="rtl" style="unicode-bidi: embed;"><span class="vs-ar">عـــرض سعر</span></span>
                        </div>

                        <!-- 3. PROJECT + QUOTE TO / QTN -->
                        <div style="font-size: 13.5px; margin: 0 0 6px 3px;"><strong>Project Name: </strong><span style="color: #888;" t-esc="project.name or '-'"/></div>
                        <table>
                            <tr>
                                <td style="width: 53.8%; vertical-align: top; padding: 0;">
                                    <table class="vs-box">
                                        <tr><td class="vs-lbl" style="width: 35.3%;">Quote To:</td><td style="font-weight: bold;" t-esc="cp.name"/></tr>
                                        <tr><td class="vs-lbl">Atten.:</td><td t-esc="o._get_attention() or '-'"/></tr>
                                        <tr><td class="vs-lbl">Customer Ref/ Assign:</td><td t-esc="o.client_order_ref or '-'"/></tr>
                                        <tr><td class="vs-lbl">Customer TRN No.:</td><td t-esc="cp.vat or '-'"/></tr>
                                        <tr><td class="vs-lbl">Customer Email:</td><td t-esc="o.partner_id.email or cp.email or '-'"/></tr>
                                    </table>
                                </td>
                                <td style="width: 6%;"/>
                                <td style="width: 40.2%; vertical-align: top; padding: 0;">
                                    <table class="vs-box">
                                        <tr><td class="vs-lbl" style="width: 45.5%;">QTN Date:</td><td t-esc="(o.date_order and o.date_order.strftime('%d/%m/%Y')) or ''"/></tr>
                                        <tr><td class="vs-lbl">QTN No:</td><td t-esc="o._get_qtn_number()"/></tr>
                                        <tr><td class="vs-lbl">QTN Validity:</td><td t-esc="(o.validity_date and o.validity_date.strftime('%d/%m/%Y')) or '-'"/></tr>
                                        <tr><td class="vs-lbl">Prepared By:</td><td t-esc="o.user_id.name or '-'"/></tr>
                                        <tr><td class="vs-lbl">Quote of Pages:</td><td t-esc="o.so_no_of_pages or '-'"/></tr>
                                    </table>
                                </td>
                            </tr>
                        </table>

                        <div style="font-weight: bold; font-size: 12.5px; margin: 16px 0 6px 3px;">We are pleased to submit the following quotation:</div>

                        <!-- 4. LINES -->
                        <t t-set="rows" t-value="o._get_quotation_rows()"/>
                        <table class="vs-items">
                            <thead>
                                <tr>
                                    <th style="width: 10.3%;">Ser. No.<small><span class="vs-ar">التسلسل</span></small></th>
                                    <th style="width: 49.6%;">Description<small><span class="vs-ar">الوصــــــــــف</span></small></th>
                                    <th style="width: 8.9%;">UOM<small><span class="vs-ar">الوحدة</span></small></th>
                                    <th style="width: 9.3%;">QTY<small><span class="vs-ar">الكمية</span></small></th>
                                    <th style="width: 11.1%;">Unit Price<small><span class="vs-ar">سعر الوحدة</span></small></th>
                                    <th style="width: 10.8%;">Amount<small><span class="vs-ar">الإجمالي</span></small></th>
                                </tr>
                            </thead>
                            <tbody>
                                <t t-foreach="rows" t-as="r">
                                    <t t-set="line" t-value="r[1]"/>
                                    <tr t-att-class="'vs-last' if r_last else ''">
                                        <t t-if="r[2] in ('subject', 'section')">
                                            <t t-set="bg" t-value="'#e6b8b7' if r[2] == 'subject' else '#f2dcdb'"/>
                                            <td t-att-style="'background-color: ' + bg + '; text-align: center; font-weight: bold; height: 30px;'" t-esc="r[0]"/>
                                            <td t-att-style="'background-color: ' + bg + '; font-weight: bold; color: #7a5c5c;'" t-esc="line.name"/>
                                            <td/><td/><td/><td/>
                                        </t>
                                        <t t-else="">
                                            <td style="text-align: center; font-weight: bold; font-size: 12.5px; height: 44px;" t-esc="r[0]"/>
                                            <td style="color: #555;">
                                                <t t-foreach="(line.name or '').split('\n')" t-as="dl"><t t-esc="dl"/><br t-if="not dl_last"/></t>
                                            </td>
                                            <td style="text-align: center; font-weight: bold;" t-esc="line.product_uom._vs_label()"/>
                                            <td style="text-align: center; font-weight: bold;" t-esc="fmt(line.product_uom_qty)"/>
                                            <td style="text-align: center; font-size: 13px;"><t t-esc="fmt(line.price_unit)"/><div t-if="line.discount" style="font-size: 10px; color: #c00000; white-space: nowrap;">-<t t-esc="'{:g}'.format(line.discount)"/>% disc.</div></td>
                                            <td style="text-align: center; font-weight: bold; font-size: 13px; white-space: nowrap;" t-esc="fmt_cur(line.price_subtotal)"/>
                                        </t>
                                    </tr>
                                </t>
                            </tbody>
                        </table>

                        <!-- 5. TOTALS (label and value on the same row so they always stay aligned) -->
                        <table style="page-break-inside: avoid;">
                            <tr>
                                <td style="width: 54.4%;"/>
                                <td style="width: 45.6%; padding: 0;">
                                    <table class="vs-tot">
                                        <tr>
                                            <td style="text-align: right; height: 22px; width: 76.3%; white-space: nowrap;">SubTotal <span dir="rtl" style="unicode-bidi: embed;"><span class="vs-ar">الاجمالي قبل الضريبة</span></span>&#8206;  &gt;&gt;&gt;</td>
                                            <td style="text-align: center; white-space: nowrap;" t-esc="fmt_cur(o.amount_untaxed)"/>
                                        </tr>
                                        <tr>
                                            <td style="text-align: right; height: 22px; white-space: nowrap;">VAT<span dir="rtl" style="unicode-bidi: embed;"><span class="vs-ar">الضريبة</span></span>&#8206;<t t-if="o._vs_vat_label()"> (@ <t t-esc="o._vs_vat_label()"/>)</t> &gt;&gt;&gt;</td>
                                            <td style="text-align: center; white-space: nowrap;" t-esc="fmt_cur(o.amount_tax)"/>
                                        </tr>
                                        <tr>
                                            <td style="text-align: right; height: 22px; white-space: nowrap;">Total With VAT <span dir="rtl" style="unicode-bidi: embed;"><span class="vs-ar">الإجمالي شامل الضريبة</span></span>&#8206; &gt;&gt;&gt;</td>
                                            <td style="text-align: center; white-space: nowrap;" t-esc="fmt_cur(o.amount_total)"/>
                                        </tr>
                                    </table>
                                </td>
                            </tr>
                        </table>

                        <!-- 6. TOTAL AMOUNT IN WORDS -->
                        <div style="margin-top: 16px; border-top: 1px dashed #000; border-bottom: 1px dashed #000; padding: 6px 0 6px 20px;">
                            <strong style="font-size: 17px;">Total Amount: </strong>
                            <img t-if="cur.name == 'AED'" src="/viewsport_implementation/static/src/img/dirham_symbol.svg" style="height: 14px; width: 14px; vertical-align: -1px; margin-left: 4px; opacity: 0.6;"/>
                            <strong style="color: #888; font-size: 14px;" t-esc="o._get_amount_in_words()"/>
                        </div>

                        <!-- 7. TERMS -->
                        <div class="vs-terms" style="margin-top: 20px; padding-left: 3px; page-break-inside: avoid;">
                            <p style="font-weight: bold; margin-bottom: 12px;">PARTICULAR TERMS &amp; CONDITIONS</p>
                            <p style="margin-bottom: 3px;"><strong>1- Payment Terms:</strong></p>
                            <p style="margin-bottom: 12px;" t-esc="o.payment_term_id.name or '-'"/>
                            <p style="margin-bottom: 3px;"><strong>2- Implementation period:</strong></p>
                            <p style="margin-bottom: 9px;" t-esc="o.implementation_period or '-'"/>
                            <t t-out="o.company_id.vs_quotation_terms"/>
                        </div>
                    </div>

                    <!-- 8. FOOTER (every page) -->
                    <div class="footer" style="font-family: 'VS Sans', 'VS Arabic', Arial, sans-serif; text-align: center; font-weight: bold; font-size: 16px; line-height: 1.3;">
                        <style>body.o_body_pdf, body.container { padding-left: 0 !important; padding-right: 0 !important; }</style><t t-call="viewsport_implementation.vs_report_fonts"/>
                        <div style="color: #e00000; font-size: 11.5px; font-family: 'VS Calibri', 'VS Arabic', Calibri, sans-serif; margin-bottom: 1px;">This is a system generated document and does not require a signature</div>
                        <div style="border-top: 1.5px solid #000; padding-top: 2px;">
                            <t t-foreach="o.company_id._vs_footer_lines()" t-as="fl">
                                <div t-if="fl[1]" dir="rtl" style="font-size: 14.5px;" t-esc="fl[0]"/>
                                <div t-else="" t-esc="fl[0]"/>
                            </t>
                        </div>
                    </div>
                </t>
            </t>
        </t>
    </template>
</odoo>
