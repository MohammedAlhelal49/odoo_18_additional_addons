<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="report_receipt_voucher_viewsport_document">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t t-call="web.basic_layout">
                    <t t-set="cur" t-value="o.currency_id"/>
                    <t t-set="fmt_cur" t-value="lambda v: '%s %s' % (cur.name, '{:,.2f}'.format(v or 0.0))"/>
                    <t t-set="invoices" t-value="o.reconciled_invoice_ids"/>
                    <t t-call="viewsport_implementation.vs_report_fonts"/>
                    <style>
                        body.o_body_pdf, body.container { padding-left: 0 !important; padding-right: 0 !important; }
                        .vs-rv { font-family: 'VS Sans', 'VS Arabic', Arial, sans-serif; font-size: 15px; color: #000; line-height: 1.25; }
                        .vs-rv table, .vs-rv tr, .vs-rv td, .vs-rv th { border: 0 none; border-color: transparent; }
                        .vs-rv table { border-collapse: collapse; width: 100%; }
                        .vs-rv .vs-info td { background-color: #ddebf7; padding: 1px 6px; height: 24px; font-size: 15.4px; vertical-align: middle; }
                        .vs-rv .vs-info .vs-en { text-align: right; width: 28.5%; }
                        .vs-rv .vs-info .vs-v { text-align: center; font-weight: bold; width: 50.5%; }
                        .vs-rv .vs-info .vs-ar { text-align: left; width: 21%; font-size: 14.6px; }
                        .vs-rv .vs-grid td { border: 1px solid #000 !important; }
                        .vs-rv .vs-desc { font-family: 'VS Calibri', 'VS Arabic', Calibri, sans-serif; font-size: 16.3px; }
                    </style>
                    <div class="page vs-rv">

                        <!-- 1. LOGO -->
                        <img t-if="o.company_id.vs_report_logo" t-att-src="image_data_uri(o.company_id.vs_report_logo)" style="height: 63px;" alt="Viewsport Pitches"/><img t-else="" src="/viewsport_implementation/static/src/img/viewsport_logo.png" style="height: 63px;" alt="Viewsport Pitches"/>

                        <!-- 2. TITLE -->
                        <div style="text-align: center; font-weight: bold; margin-top: 38px; line-height: 1.2;">
                            <div style="font-size: 24px;" dir="rtl"><span class="vs-ar">سـنـــــــــــــد قــــــبض</span></div>
                            <div style="font-size: 22.5px;">E-RECEIPT VOUCHER</div>
                            <div style="font-size: 22.5px;">No.<t t-esc="o.receipt_voucher_no or o.name"/></div>
                        </div>

                        <!-- 3. TRANSACTION INFORMATION -->
                        <table style="margin-top: 34px;">
                            <tr>
                                <td style="font-weight: bold; font-size: 15.4px; padding: 0 0 6px 0;">Transaction Information</td>
                                <td style="font-weight: bold; font-size: 18px; text-align: right; padding: 0 0 6px 0;" dir="rtl"><span class="vs-ar">بيانات المعاملة</span></td>
                            </tr>
                        </table>
                        <table class="vs-info">
                            <tr>
                                <td class="vs-en">Received from Mrs./Ms.:</td>
                                <td class="vs-v" t-esc="o.partner_id.commercial_partner_id.name"/>
                                <td class="vs-ar" dir="rtl"><span class="vs-ar">إستلمنا من السيد/ السادة</span>:</td>
                            </tr>
                            <tr>
                                <td class="vs-en">Cheque / Converted Amount:</td>
                                <td class="vs-v" t-esc="fmt_cur(o.amount)"/>
                                <td class="vs-ar" dir="rtl"><span class="vs-ar">مبلغ وقدرة</span>:</td>
                            </tr>
                            <tr>
                                <td class="vs-en">Payment Method:</td>
                                <td class="vs-v" t-esc="dict(o._fields['receipt_payment_method'].selection).get(o.receipt_payment_method, '')"/>
                                <td class="vs-ar" dir="rtl"><span class="vs-ar">طريقة الدفع</span>:</td>
                            </tr>
                            <tr>
                                <td class="vs-en">Cheque / Transfer Date:</td>
                                <td class="vs-v" t-esc="(o.date and o.date.strftime('%d %B %Y').lstrip('0')) or ''"/>
                                <td class="vs-ar" dir="rtl"><span class="vs-ar">تاريخ الشيك/ التحويل</span>:</td>
                            </tr>
                            <tr>
                                <td class="vs-en">Bank:</td>
                                <td class="vs-v" t-esc="o.receipt_bank_name or '-'"/>
                                <td class="vs-ar" dir="rtl"><span class="vs-ar">أسم البنك</span>:</td>
                            </tr>
                            <tr>
                                <td class="vs-en">Cheque No /Transaction ID:</td>
                                <td class="vs-v" t-esc="o.memo or '-'"/>
                                <td class="vs-ar" dir="rtl"><span class="vs-ar">رقم الشيك / المعاملة</span>:</td>
                            </tr>
                        </table>

                        <!-- 4. DETAIL BREAKDOWN -->
                        <table class="vs-grid" style="margin-top: 28px;">
                            <tr>
                                <td style="width: 79.5%; font-weight: bold; font-size: 15.3px; padding: 4px 5px;">Detail Breakdown <span dir="rtl" style="unicode-bidi: embed; font-size: 12.5px;"><span class="vs-ar">تفاصيل الدفع</span></span></td>
                                <td style="width: 20.5%; font-weight: bold; font-size: 15.3px; padding: 4px 10px 4px 36px;">Amount <span dir="rtl" style="unicode-bidi: embed; font-size: 12.5px;"><span class="vs-ar">المبلغ</span></span></td>
                            </tr>
                            <tr>
                                <td class="vs-desc" style="padding: 12px 5px; line-height: 1.4;">
                                    <t t-set="desc" t-value="o._get_receipt_description()"/>
                                    <t t-if="desc.startswith('Being ')"><strong>Being</strong> <t t-esc="desc[6:]"/></t>
                                    <t t-else="" t-esc="desc"/>
                                </td>
                                <td class="vs-desc" style="text-align: center; font-weight: bold; font-size: 15.5px; vertical-align: middle;" t-esc="fmt_cur(o.amount).replace(' ', '', 1)"/>
                            </tr>
                        </table>
                        <div style="border-bottom: 1px solid #000; padding: 8px 0 6px 72px; font-weight: bold; font-size: 15px;">
                            Amount in words: <img t-if="cur.name == 'AED'" src="/viewsport_implementation/static/src/img/dirham_symbol.svg" style="height: 14px; width: 14px; vertical-align: -2px; margin-left: 4px;"/>
                            <span t-esc="o._get_receipt_amount_in_words()"/>
                        </div>

                        <!-- 5. TAX INVOICE REF -->
                        <div style="margin-top: 30px; border-top: 1px solid #000; border-bottom: 2px solid #000; padding: 6px 0 4px 0; font-weight: bold;">
                            <span style="font-size: 15px;">Tax Invoice Ref <span dir="rtl" style="unicode-bidi: embed; font-size: 13px;"><span class="vs-ar">مرجع الفاتورة</span></span></span>
                            <span style="color: #c00000; font-size: 18px; margin-left: 28px;" t-esc="', '.join(invoices.mapped('name')) or '-'"/>
                        </div>

                        <!-- 6. SIGNATURES -->
                        <table class="vs-grid" style="margin-top: 18px;">
                            <tr>
                                <td style="width: 26%; font-weight: bold; font-size: 14px; padding: 7px 10px 7px 46px; white-space: nowrap;">Accountant <span dir="rtl" style="unicode-bidi: embed; font-size: 12px; margin-left: 14px;"><span class="vs-ar">المحاسب</span></span></td>
                                <td style="width: 54%;"/>
                                <td style="width: 20%; font-weight: bold; font-size: 14px; padding: 7px 4px 7px 14px; white-space: nowrap;">Auditor <span dir="rtl" style="unicode-bidi: embed; font-size: 12px; margin-left: 12px;"><span class="vs-ar">المدقق الداخلي</span></span></td>
                            </tr>
                            <tr>
                                <td colspan="3" style="height: 135px;"/>
                            </tr>
                        </table>

                        <!-- 7. FOOTER (directly under the content, as in the template) -->
                        <div style="text-align: center; font-weight: bold; font-size: 17px; line-height: 1.3; margin-top: 4px;">
                            <t t-foreach="o.company_id._vs_footer_lines()" t-as="fl">
                            <div t-if="fl[1]" dir="rtl" style="font-size: 14px;" t-esc="fl[0]"/>
                            <div t-else="" t-esc="fl[0]"/>
                        </t>
                        </div>
                    </div>
                </t>
            </t>
        </t>
    </template>
</odoo>
