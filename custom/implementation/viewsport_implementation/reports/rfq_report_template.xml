<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="report_rfq_viewsport_document">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t t-call="web.basic_layout">
                    <t t-set="fmt" t-value="lambda v: '{:,.2f}'.format(v or 0.0)"/>
                    <t t-set="p" t-value="o.partner_id"/>
                    <t t-set="cp" t-value="o.partner_id.commercial_partner_id"/>
                    <t t-call="viewsport_implementation.vs_report_fonts"/>
                    <style>
                        body.o_body_pdf, body.container { padding-left: 0 !important; padding-right: 0 !important; }
                        .vs-rfq { font-family: 'VS Sans', 'VS Arabic', Arial, sans-serif; font-size: 17.2px; color: #000; line-height: 1.2; }
                        .vs-rfq table, .vs-rfq tr, .vs-rfq td, .vs-rfq th { border: 0 none; border-color: transparent; }
                        .vs-rfq table { border-collapse: collapse; width: 100%; }
                        .vs-rfq .vs-box td { border: 1px solid #c0c0c0 !important; padding: 3.4px 4.6px; height: 28.7px; font-size: 16.7px; vertical-align: middle; }
                        .vs-rfq .vs-lbl { background-color: #dddddd; font-weight: bold; text-align: right; white-space: nowrap; }
                        .vs-rfq .vs-ph { color: #404040; }
                        .vs-rfq .vs-items th { background-color: #40baec; border: 1px solid #000 !important; text-align: center; font-weight: bold; font-size: 17.2px; padding: 2.3px; line-height: 1.12; }
                        .vs-rfq .vs-items th small { display: block; font-size: 12.6px; font-weight: bold; }
                        .vs-rfq .vs-items td { border: 1px solid #c0c0c0 !important; padding: 2.3px 6.9px; height: 33.3px; vertical-align: middle; font-size: 18.4px; }
                        .vs-rfq .vs-items tr.vs-alt td { background-color: #f0f0f0; }
                        .vs-rfq .vs-num { font-family: 'VS Narrow', 'VS Arabic', 'Arial Narrow', sans-serif; text-align: center; font-size: 17.8px; white-space: nowrap; }
                        .vs-rfq .vs-terms p { margin: 0 0 11.5px 0; font-size: 15.2px; }
                        .vs-rfq .vs-muted { color: #808080; }
                    </style>
                    <div class="page vs-rfq">

                        <!-- 1. HEADER: logo + TRN / date -->
                        <table style="border: 1px solid #c0c0c0 !important;">
                            <tr>
                                <td style="width: 78.3%; padding: 6.9px 6.9px 4.6px 6.9px; vertical-align: middle;">
                                    <img t-if="o.company_id.vs_report_logo" t-att-src="image_data_uri(o.company_id.vs_report_logo)" style="height: 80px;" alt="Viewsport Pitches"/>
                                    <img t-else="" src="/viewsport_implementation/static/src/img/viewsport_logo.png" style="height: 80px;" alt="Viewsport Pitches"/>
                                </td>
                                <td style="width: 21.7%; padding: 0; vertical-align: top;">
                                    <table>
                                        <tr>
                                            <td style="border-left: 1px solid #c0c0c0 !important; font-weight: bold; font-size: 16.1px; text-align: center; line-height: 1.3; padding: 6.9px 2.3px; height: 52.9px;">
                                                TAX REGISTRATION<br/>
                                                TRN # <span style="color: #c00000;" t-esc="o.company_id.vat or ''"/>
                                            </td>
                                        </tr>
                                        <tr>
                                            <td style="padding: 0;">
                                                <table>
                                                    <tr>
                                                        <td style="background-color: #dddddd; border: 1px solid #c0c0c0 !important; border-right: 0 none !important; text-align: right; font-weight: bold; font-size: 17.2px; padding: 5.8px 3.4px; width: 50%; height: 34.5px;">Date</td>
                                                        <td style="background-color: #dddddd; border: 1px solid #c0c0c0 !important; border-left: 0 none !important; font-weight: bold; font-size: 15.5px; padding: 5.8px 3.4px; white-space: nowrap;"
                                                            t-esc="(o.date_order and o.date_order.strftime('%d/%m/%Y')) or ''"/>
                                                    </tr>
                                                </table>
                                            </td>
                                        </tr>
                                    </table>
                                </td>
                            </tr>
                            <!-- 2. TITLE (inside the header frame, as in the template) -->
                            <tr>
                                <td colspan="2" style="border-top: 1px solid #c0c0c0 !important; text-align: center; font-weight: bold; line-height: 1.15; padding: 16.1px 0 6.9px 0;">
                                    <div style="font-size: 24.1px;">REQUEST FOR QUOTATION</div>
                                    <div style="font-size: 20.7px;" dir="rtl"><span class="vs-ar">طلــــب عــــــرض أســــــــعار</span></div>
                                </td>
                            </tr>
                        </table>

                        <!-- 3. RFQ TO / DELIVERY TO -->
                        <table style="margin-top: 6.9px;">
                            <tr>
                                <td style="width: 53.2%; vertical-align: top;">
                                    <div style="font-weight: bold; font-size: 16.1px; padding: 0 0 3.4px 2.3px;">RFQ TO</div>
                                    <table class="vs-box">
                                        <tr>
                                            <td class="vs-lbl" style="width: 21.8%;">M/s:</td>
                                            <td class="vs-ph" style="font-weight: bold;" t-esc="cp.name"/>
                                        </tr>
                                        <tr>
                                            <td class="vs-lbl">Atten.:</td>
                                            <td class="vs-ph" t-esc="(p.name if p != cp else '') or ''"/>
                                        </tr>
                                        <tr>
                                            <td class="vs-lbl">Address :</td>
                                            <td class="vs-ph" t-esc="', '.join(x for x in [cp.street, cp.street2, cp.city, cp.country_id.name] if x) or '-'"/>
                                        </tr>
                                        <tr>
                                            <td class="vs-lbl">Contact No:</td>
                                            <td class="vs-ph" t-esc="p.phone or p.mobile or cp.phone or cp.mobile or '-'"/>
                                        </tr>
                                        <tr>
                                            <td class="vs-lbl">Email:</td>
                                            <td class="vs-ph" t-esc="p.email or cp.email or '-'"/>
                                        </tr>
                                    </table>
                                </td>
                                <td style="width: 3.6%;"/>
                                <td style="width: 43.2%; vertical-align: top;">
                                    <div style="font-weight: bold; font-size: 16.1px; padding: 0 0 3.4px 2.3px;">DELIVERY TO</div>
                                    <table class="vs-box">
                                        <tr>
                                            <td class="vs-lbl" style="width: 49.5%;">Project Ref:</td>
                                            <td style="font-weight: bold;" t-esc="o._get_rfq_project_ref()"/>
                                        </tr>
                                        <tr><td class="vs-lbl">RFQ No.:</td><td t-esc="o._get_rfq_number()"/></tr>
                                        <tr><td class="vs-lbl">Payment Plan:</td><td t-esc="o.payment_term_id.name or 'To be mutually agreed'"/></tr>
                                        <tr>
                                            <td class="vs-lbl">Delivery Location:</td>
                                            <td t-esc="dict(o._fields['rfq_delivery_location'].selection).get(o.rfq_delivery_location) or '-'"/>
                                        </tr>
                                        <tr><td class="vs-lbl">RFQ No. of Pages:</td><td t-esc="o.po_no_of_pages or '-'"/></tr>
                                    </table>
                                </td>
                            </tr>
                        </table>

                        <p style="margin: 9.2px 0 3.4px 0; font-size: 17.8px;">You are kindly requested to quote your best price for the supply of the materials as detailed below:</p>

                        <!-- 4. ITEMS -->
                        <table class="vs-items">
                            <thead>
                                <tr>
                                    <th style="width: 11.5%;">Ser. No.<small><span class="vs-ar">التسلسل</span></small></th>
                                    <th style="width: 45.6%;">Description<small><span class="vs-ar">الوصــــــــــف</span></small></th>
                                    <th style="width: 10.9%;">UOM<small><span class="vs-ar">الوحدة</span></small></th>
                                    <th style="width: 10.3%;">QTY<small><span class="vs-ar">الكمية</span></small></th>
                                    <th style="width: 10.6%;">Unit Price<small><span class="vs-ar">سعر الوحدة</span></small></th>
                                    <th style="width: 11.1%;">Amount<small><span class="vs-ar">الإجمالي</span></small></th>
                                </tr>
                            </thead>
                            <tbody>
                                <t t-set="item_index" t-value="1"/>
                                <t t-foreach="o.order_line" t-as="line">
                                    <tr t-if="line.display_type == 'line_section'">
                                        <td colspan="6" style="font-weight: bold;" t-esc="line.name"/>
                                    </tr>
                                    <tr t-elif="line.display_type == 'line_note'">
                                        <td colspan="6" style="font-style: italic;" t-esc="line.name"/>
                                    </tr>
                                    <tr t-else="" t-att-class="'vs-alt' if item_index % 2 == 1 else ''">
                                        <td style="text-align: center;" t-esc="'%.2f' % item_index"/>
                                        <td style="padding-left: 9.2px;">
                                            <t t-foreach="(line.name or '').split('\n')" t-as="dl"><t t-esc="dl"/><br t-if="not dl_last"/></t>
                                        </td>
                                        <td style="text-align: center;" t-esc="line.product_uom._vs_label()"/>
                                        <td class="vs-num" t-esc="fmt(line.product_qty)"/>
                                        <td class="vs-num" t-esc="fmt(line.price_unit)"/>
                                        <td class="vs-num" t-esc="fmt(line.price_subtotal)"/>
                                        <t t-set="item_index" t-value="item_index + 1"/>
                                    </tr>
                                </t>
                            </tbody>
                        </table>
                        <table style="page-break-inside: avoid;">
                            <tr>
                                <td style="width: 57.1%;"/>
                                <td style="width: 31.8%; text-align: right; font-weight: bold; font-size: 17.8px; padding: 6.9px 9.2px; border-bottom: 1px solid #000 !important;">Total Amount &gt;&gt;&gt;</td>
                                <td style="width: 11.1%; text-align: center; font-weight: bold; font-size: 17.8px; border: 1px solid #000 !important; border-top: 0 none !important;" t-esc="fmt(o.amount_untaxed)"/>
                            </tr>
                        </table>

                        <!-- 5. DELIVERY LOCATION -->
                        <t t-set="wh_partner" t-value="o.picking_type_id.warehouse_id.partner_id"/>
                        <p style="margin: 25.3px 0 0 2.3px; font-size: 15.2px;"><strong>Delivery location: </strong>
                            <strong class="vs-muted">
                                <t t-if="o.ship_to_info" t-esc="o.ship_to_info"/>
                                <t t-elif="wh_partner" t-esc="', '.join(x for x in [wh_partner.name, wh_partner.city] if x)"/>
                                <t t-else="">-</t>
                            </strong>
                        </p>

                        <!-- 6. TERMS & CONDITIONS -->
                        <div class="vs-terms" style="margin-top: 25.3px; padding-left: 2.3px; page-break-inside: avoid;">
                            <p style="font-weight: bold; text-decoration: underline; margin-bottom: 13.8px;">TERMS &amp; CONDITION:</p>
                            <p><strong>1- Payment Terms:</strong></p>
                            <p t-esc="o.payment_term_id.name or 'To be mutually agreed.'"/>
                            <p><strong>2- Delivery Period: </strong><t t-esc="o._get_rfq_delivery_period_text()"/></p>
                            <t t-out="o.company_id.vs_rfq_terms"/>
                        </div>

                        <!-- 7. SIGNATURES -->
                        <table style="margin-top: 25.3px; page-break-inside: avoid; font-size: 15.2px;">
                            <tr>
                                <td style="width: 68%; vertical-align: top; padding-left: 2.3px;">
                                    <div style="font-weight: bold;">Request by:</div>
                                    <div style="margin-top: 13.8px; color: #555;">Name:<t t-if="o.user_id"> <t t-esc="o.user_id.name"/></t><t t-else="">………………………………………………</t></div>
                                    <div style="margin: 11.5px 0 0 96.6px; font-weight: bold; color: #555;">Signature,</div>
                                </td>
                                <td style="width: 32%; vertical-align: top; text-align: center;">
                                    <div style="font-weight: bold;">Project's Manager</div>
                                    <div style="margin-top: 13.8px;">approval</div>
                                </td>
                            </tr>
                            <tr>
                                <td style="padding: 39.1px 0 0 193.2px;">
                                    <div style="font-weight: bold;">VIEWSPORT PITCHES</div>
                                    <div style="padding-left: 4.6px;">Procurement Manager</div>
                                </td>
                                <td/>
                            </tr>
                        </table>
                    </div>

                    <!-- 8. FOOTER (every page) -->
                    <div class="footer" style="font-family: 'VS Sans', 'VS Arabic', Arial, sans-serif; text-align: center; font-weight: bold; font-size: 18.4px; line-height: 1.3; border-top: 2.3px solid #000; padding-top: 3.4px;">
                        <style>body.o_body_pdf, body.container { padding-left: 0 !important; padding-right: 0 !important; }</style><t t-call="viewsport_implementation.vs_report_fonts"/>
                        <t t-foreach="o.company_id._vs_footer_lines()" t-as="fl">
                            <div t-if="fl[1]" dir="rtl" style="font-size: 16.7px;" t-esc="fl[0]"/>
                            <div t-else="" t-esc="fl[0]"/>
                        </t>
                    </div>
                </t>
            </t>
        </t>
    </template>
</odoo>
