<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="report_cheque_ack_viewsport_document">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t t-call="web.basic_layout">
                    <t t-set="cur" t-value="o.currency_id"/>
                    <t t-set="fmt" t-value="lambda v: '{:,.2f}'.format(v or 0.0)"/>
                    <t t-set="payee" t-value="o.partner_id.commercial_partner_id.name or ''"/>
                    <t t-set="chq_date" t-value="o._vs_cheque_date()"/>
                    <t t-set="petty" t-value="o.vs_ack_type == 'petty_cash'"/>
                    <t t-set="image" t-value="o._vs_cheque_image()"/>
                    <t t-call="viewsport_implementation.vs_report_fonts"/>
                    <style>
                        body.o_body_pdf, body.container { padding-left: 0 !important; padding-right: 0 !important; }
                        .vs-ck { font-family: 'VS Sans', 'VS Arabic', Arial, sans-serif; font-size: 15px; color: #000; line-height: 1.25; }
                        .vs-ck table, .vs-ck tr, .vs-ck td, .vs-ck th { border: 0 none; border-color: transparent; }
                        .vs-ck table { border-collapse: collapse; width: 100%; }
                        .vs-ck .vs-info td { background-color: #ddebf7; padding: 1px 6px; height: 24px; font-size: 15.4px; font-weight: bold; vertical-align: middle; }
                        .vs-ck .vs-info .vs-en { text-align: right; width: 22%; border-right: 1.5px solid #000 !important; }
                        .vs-ck .vs-info .vs-v { text-align: center; width: 54%; }
                        .vs-ck .vs-info .vs-ar { text-align: left; width: 24%; font-size: 14.6px; border-left: 1px solid #fff !important; }
                        .vs-ck .vs-rule { border-top: 1px solid #000; }
                        .vs-ck .vs-desc { font-family: 'VS Calibri', 'VS Arabic', Calibri, sans-serif; font-size: 16.3px; }
                        .vs-ck .vs-sign td { border-top: 1px solid #000 !important; border-bottom: 1px solid #000 !important; text-align: center; font-weight: bold; font-size: 14.5px; line-height: 1.15; padding: 3px 4px; }
                        .vs-ck .vs-sign td.vs-mid { border-left: 1px solid #000 !important; border-right: 1px solid #000 !important; }
                        .vs-ck .vs-sign small { font-size: 12px; }
                    </style>
                    <div class="page vs-ck">

                        <!-- 1. LOGO -->
                        <img t-if="o.company_id.vs_report_logo" t-att-src="image_data_uri(o.company_id.vs_report_logo)" style="height: 60px;" alt="Viewsport Pitches"/><img t-else="" src="/viewsport_implementation/static/src/img/viewsport_logo.png" style="height: 60px;" alt="Viewsport Pitches"/>

                        <!-- 2. TITLE -->
                        <div style="text-align: center; font-weight: bold; margin-top: 30px; line-height: 1.3;">
                            <div style="font-size: 17px;" dir="rtl"><span class="vs-ar">إقــــــــرار اســــــــــــتلام شيك</span></div>
                            <div style="font-size: 17px;">Cheque Acknowlegement</div>
                        </div>

                        <!-- 3. CHEQUE INFORMATION -->
                        <table class="vs-info" style="margin-top: 14px;">
                            <tr>
                                <td class="vs-en">Payee:</td>
                                <td class="vs-v" t-esc="payee"/>
                                <td class="vs-ar" dir="rtl"><span class="vs-ar">أسم المستفيد</span>:</td>
                            </tr>
                            <tr>
                                <td class="vs-en">Cheque Date:</td>
                                <td class="vs-v" t-esc="(chq_date and chq_date.strftime('%d %B %Y').lstrip('0')) or ''"/>
                                <td class="vs-ar" dir="rtl"><span class="vs-ar">تاريخ الشيك</span></td>
                            </tr>
                            <tr>
                                <td class="vs-en">Cheque No:</td>
                                <td class="vs-v" t-esc="o.reference or ''"/>
                                <td class="vs-ar" dir="rtl"><span class="vs-ar">رقم الشيك</span>:</td>
                            </tr>
                            <tr>
                                <td class="vs-en">Cheque Amount:</td>
                                <td class="vs-v" t-esc="cur.name + fmt(o.payment_amount)"/>
                                <td class="vs-ar" dir="rtl"><span class="vs-ar">مبلغ الشيك</span>:</td>
                            </tr>
                        </table>

                        <!-- 4. DETAIL BREAKDOWN -->
                        <div class="vs-rule" style="margin-top: 1px; padding: 5px 2px 4px 2px; font-weight: bold; font-size: 14.5px; border-bottom: 1px solid #000;">
                            Detail Breakdown <span dir="rtl" style="unicode-bidi: embed; font-size: 12.5px;"><span class="vs-ar">تفاصيل الدفع</span></span>
                        </div>
                        <div class="vs-desc" style="padding: 6px 2px; min-height: 56px; line-height: 1.35;">
                            <t t-foreach="(o._vs_detail_text() or '').split('\n')" t-as="dl"><t t-esc="dl"/><br t-if="not dl_last"/></t>
                        </div>
                        <div class="vs-rule" style="padding: 6px 2px; font-weight: bold; font-size: 15px; border-bottom: 1px solid #000;">
                            <t t-if="petty">
                                <div>Tax Invoice Ref: <t t-esc="o._vs_vendor_invoice_ref() or '………………………..........'"/></div>
                                <div>Receipt Voucher Ref: ………………………..</div>
                            </t>
                            <table t-else="">
                                <tr>
                                    <td style="width: 24%; text-align: right; line-height: 1.2; padding-right: 8px;">Vendor Tax Invoice<br/>Reference:</td>
                                    <td style="vertical-align: bottom; color: #c00000;" t-esc="o._vs_vendor_invoice_ref()"/>
                                </tr>
                            </table>
                        </div>

                        <!-- 5. CHEQUE COPY -->
                        <div style="background-color: #ddebf7; border-bottom: 1px solid #000; padding: 2px 2px; font-weight: bold; font-size: 17px;">
                            Cheque Copy <span dir="rtl" style="unicode-bidi: embed;"><span class="vs-ar">صورة الشيك</span></span>
                        </div>
                        <div style="height: 290px; text-align: center; padding: 10px 0;">
                            <img t-if="image" t-att-src="image_data_uri(image)" style="max-height: 270px; max-width: 92%;" alt="Cheque copy"/>
                        </div>

                        <!-- 6. RECEIVED + AMOUNT IN WORDS -->
                        <div style="border-top: 1px solid #000; border-bottom: 1px solid #000; padding: 3px 2px; font-weight: bold; font-size: 14.5px; color: #e00000;">
                            <t t-esc="payee"/> received full amount against cheque <t t-esc="o.reference or ''"/>.
                        </div>
                        <table style="border-bottom: 1px solid #000;">
                            <tr>
                                <td style="width: 76%; padding: 3px 2px; font-weight: bold; font-size: 13px; white-space: nowrap; border-right: 1px solid #000 !important;">
                                    <span style="font-size: 14.5px;">Amount in words : (</span><img t-if="cur.name == 'AED'" src="/viewsport_implementation/static/src/img/dirham_symbol.svg" style="height: 13px; width: 13px; vertical-align: -1px;"/><t t-else="" t-esc="cur.symbol"/><span style="font-size: 14.5px;"> )</span>
                                    <t t-esc="o._vs_amount_in_words()"/>
                                </td>
                                <td style="text-align: center; font-weight: bold; font-size: 15px;" t-esc="fmt(o.payment_amount)"/>
                            </tr>
                        </table>

                        <!-- 7. SIGNATURES -->
                        <table class="vs-sign" style="margin-top: 14px;">
                            <tr>
                                <td style="width: 24%;">Finance Manager<br/><small><span class="vs-ar">المدير المالي</span></small></td>
                                <td class="vs-mid" style="width: 52%;">Audit<br/><small><span class="vs-ar">تدقيق</span></small></td>
                                <td style="width: 24%;">
                                    <t t-if="petty">General Manager<br/><small><span class="vs-ar">المدير العام</span></small></t>
                                    <t t-else="">Authorized Approval<br/><small><span class="vs-ar">يعتمد من قبل</span></small></t>
                                </td>
                            </tr>
                        </table>
                        <table class="vs-sign" style="margin-top: 66px;">
                            <tr>
                                <td style="width: 24%;">Receiver<br/><small><span class="vs-ar">المستلم</span></small></td>
                                <td class="vs-mid" style="width: 52%;">Contact Number<br/><small><span class="vs-ar">رقم التواصل</span></small></td>
                                <td style="width: 24%;">Received Date<br/><small><span class="vs-ar">تاريخ الاستلام</span></small></td>
                            </tr>
                        </table>

                        <!-- 8. FOOTER (under the content, as in the template) -->
                        <div style="margin-top: 52px; border-top: 2px solid #000; padding-top: 2px; text-align: center; font-weight: bold; font-size: 17px; line-height: 1.3;">
                            <t t-foreach="o.company_id._vs_footer_lines()" t-as="fl">
                                <div t-if="fl[1]" dir="rtl" style="font-size: 14px;" t-esc="fl[0]"/>
                                <div t-else="" t-esc="fl[0]"/>
                            </t>
                        </div>
                    </div>
                </t>
            </t>
        </t>
    </template>
</odoo>
