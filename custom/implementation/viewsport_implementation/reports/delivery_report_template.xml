<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Shared pieces of the two delivery documents -->
    <template id="vs_delivery_styles">
        <t t-call="viewsport_implementation.vs_report_fonts"/>
        <style>
            body.o_body_pdf, body.container { padding-left: 0 !important; padding-right: 0 !important; }
            .vs-dl { font-family: 'VS Sans', 'VS Arabic', Arial, sans-serif; font-size: 14px; color: #000; line-height: 1.2; }
            .vs-dl table, .vs-dl tr, .vs-dl td, .vs-dl th { border: 0 none; border-color: transparent; }
            .vs-dl table { border-collapse: collapse; width: 100%; }
            .vs-dl .vs-info td { padding: 0 2px; font-weight: bold; font-size: 12.2px; line-height: 1.3; white-space: nowrap; }
            .vs-dl .vs-box td { border: 1px solid #c0c0c0 !important; padding: 1px 3px; height: 19px; font-size: 13.3px; vertical-align: middle; }
            .vs-dl .vs-lbl { background-color: #dddddd; font-weight: bold; text-align: right; white-space: nowrap; color: #333; }
            .vs-dl .vs-ph { color: #666; }
            .vs-dl .vs-red { color: #d0021b; font-weight: bold; }
            .vs-dl .vs-blue { color: #1a73c8; }
            .vs-dl .vs-sec { font-weight: bold; font-size: 14px; padding: 0 0 3px 3px; }
            .vs-dl .vs-items th { background-color: #d9d9d9; border: 1px solid #000 !important; text-align: center; font-weight: bold; font-size: 13.5px; padding: 2px 1px; line-height: 1.1; }
            .vs-dl .vs-items th small { display: block; font-size: 10.5px; font-weight: bold; white-space: nowrap; }
            .vs-dl .vs-items td { border: 1px solid #7a7a7a !important; padding: 1px 3px; vertical-align: middle; font-size: 13.4px; }
            .vs-dl .vs-items tr.vs-alt td { background-color: #f0f0f0; }
            .vs-dl .vs-hand { font-size: 12.5px; }
        </style>
    </template>

    <template id="vs_delivery_logo">
        <img t-if="o.company_id.vs_report_logo" t-att-src="image_data_uri(o.company_id.vs_report_logo)" t-att-style="'height: ' + str(logo_h) + 'px;'" alt="Viewsport Pitches"/>
        <img t-else="" src="/viewsport_implementation/static/src/img/viewsport_logo.png" t-att-style="'height: ' + str(logo_h) + 'px;'" alt="Viewsport Pitches"/>
    </template>

    <template id="vs_delivery_footer">
        <div class="footer" style="font-family: 'VS Sans', 'VS Arabic', Arial, sans-serif; text-align: center; font-weight: bold; font-size: 15.5px; line-height: 1.3; border-top: 1.5px solid #000; padding-top: 3px;">
            <style>body.o_body_pdf, body.container { padding-left: 0 !important; padding-right: 0 !important; }</style><t t-call="viewsport_implementation.vs_report_fonts"/>
            <t t-foreach="o.company_id._vs_footer_lines()" t-as="fl">
                <div t-if="fl[1]" dir="rtl" style="font-size: 14px;" t-esc="fl[0]"/>
                <div t-else="" t-esc="fl[0]"/>
            </t>
        </div>
    </template>

    <!-- ============================== DELIVERY NOTE ============================== -->
    <template id="report_delivery_note_viewsport_document">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t t-call="web.basic_layout">
                    <t t-set="fmt_qty" t-value="lambda v: ('%.2f' % v).rstrip('0').rstrip('.') if v else ''"/>
                    <t t-set="cp" t-value="o.partner_id.commercial_partner_id"/>
                    <t t-set="logo_h" t-value="88"/>
                    <t t-call="viewsport_implementation.vs_delivery_styles"/>
                    <div class="page vs-dl">
                        <!-- 1. HEADER -->
                        <table>
                            <tr>
                                <td style="width: 63.5%; vertical-align: top; padding-left: 2px;"><t t-call="viewsport_implementation.vs_delivery_logo"/></td>
                                <td style="width: 36.5%; vertical-align: top;">
                                    <div style="font-weight: bold; font-size: 16.5px; border-bottom: 1px solid #000; padding: 0 2px 1px 2px;">Delivery Note Information</div>
                                    <table class="vs-info">
                                        <tr>
                                            <td style="width: 39%;">DLN Number #</td>
                                            <td style="color: #d0021b; font-family: 'VS Script', cursive; font-size: 16px; font-weight: bold;" t-esc="o._vs_dln_number()"/>
                                        </tr>
                                        <tr><td>Delivery Date:</td><td t-esc="(o.date_done or o.scheduled_date) and (o.date_done or o.scheduled_date).strftime('%d/%m/%Y') or ''"/></tr>
                                        <tr><td>P.O Ref.:</td><td t-esc="o._vs_customer_po_ref() or '-'"/></tr>
                                        <tr><td>Contract Ref. number:</td><td t-esc="o._vs_project_ref() or '-'"/></tr>
                                    </table>
                                </td>
                            </tr>
                        </table>

                        <!-- 2. TITLE -->
                        <div style="text-align: center; font-weight: bold; line-height: 1.15; margin: 10px 0 8px 0;">
                            <div style="font-size: 25px;">DELIVERY NOTE</div>
                            <div style="font-size: 23px;" dir="rtl"><span class="vs-ar">ســــــند تســليم</span></div>
                        </div>

                        <!-- 3. BUYER / SELLER -->
                        <table>
                            <tr>
                                <td style="width: 54.4%;" class="vs-sec">BUYER <span dir="rtl" style="unicode-bidi: embed; font-size: 12.5px;"><span class="vs-ar">المشتري</span></span></td>
                                <td style="width: 45.6%;" class="vs-sec">SELLER <span dir="rtl" style="unicode-bidi: embed; font-size: 12.5px;"><span class="vs-ar">البائع</span></span></td>
                            </tr>
                            <tr>
                                <td style="vertical-align: top; padding: 0;">
                                    <table class="vs-box">
                                        <tr><td class="vs-lbl" style="width: 29.5%;">Customer:</td><td class="vs-ph" style="font-weight: bold;">M/s <t t-esc="cp.name or ''"/></td></tr>
                                        <tr><td class="vs-lbl">Address:</td><td class="vs-ph" style="font-weight: bold;" t-esc="', '.join(x for x in [cp.street, cp.street2, cp.city, cp.country_id.name] if x) or '-'"/></tr>
                                        <tr><td class="vs-lbl">Customer TRN:</td><td class="vs-red" t-esc="cp.vat or '-'"/></tr>
                                        <tr><td class="vs-lbl">Customer Code:</td><td class="vs-ph" t-esc="cp.ref or '-'"/></tr>
                                        <tr><td class="vs-lbl">Customer Email:</td><td class="vs-blue" t-esc="cp.email or '-'"/></tr>
                                    </table>
                                </td>
                                <td style="vertical-align: top; padding: 0;">
                                    <table class="vs-box">
                                        <tr><td class="vs-lbl" style="width: 33%;">Company Name:</td><td style="font-weight: bold; white-space: nowrap; font-size: 11.6px; letter-spacing: -0.2px;" t-esc="o.company_id.vs_legal_name or o.company_id.name"/></tr>
                                        <tr><td class="vs-lbl">VSP TRN:</td><td class="vs-red" t-esc="o.company_id.vat or ''"/></tr>
                                        <tr><td class="vs-lbl">Address:</td><td t-esc="o.company_id.vs_bill_from_address or ''"/></tr>
                                        <tr><td class="vs-lbl">Phone:</td><td t-esc="o.company_id.vs_bill_from_phone or ''"/></tr>
                                        <tr><td class="vs-lbl">Email:</td><td class="vs-blue" t-esc="o.company_id.vs_bill_from_email or ''"/></tr>
                                    </table>
                                </td>
                            </tr>
                        </table>

                        <!-- 4. ITEMS (at least 10 numbered rows, as on the template) -->
                        <t t-set="moves" t-value="o._vs_lines()"/>
                        <table class="vs-items" style="margin-top: 12px;">
                            <thead>
                                <tr>
                                    <th style="width: 7.8%;">Ser. No.<small><span class="vs-ar">التسلسل</span></small></th>
                                    <th style="width: 8.2%;">Item Ref.<small><span class="vs-ar">مرجع البند</span></small></th>
                                    <th style="width: 45.3%;">Item Description<small><span class="vs-ar">الوصــــــــــف</span></small></th>
                                    <th style="width: 8.3%;">QTY<small><span class="vs-ar">الكمية</span></small></th>
                                    <th style="width: 10.2%;">UOM<small><span class="vs-ar">الوحدة</span></small></th>
                                    <th style="width: 20.2%;">Remark<small><span class="vs-ar">ملاحظات</span></small></th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr t-foreach="range(max(10, len(moves)))" t-as="i" t-att-class="'vs-alt' if i % 2 == 0 else ''">
                                    <t t-set="mv" t-value="moves[i] if i &lt; len(moves) else False"/>
                                    <td style="text-align: center; font-weight: bold; height: 31px;" t-esc="'%.2f' % (i + 1)"/>
                                    <td style="text-align: center;" t-esc="(mv and mv.product_id.default_code) or ''"/>
                                    <td t-esc="(mv and (mv.description_picking or mv.product_id.display_name)) or ''"/>
                                    <td style="text-align: center;" t-esc="(mv and fmt_qty(mv.quantity or mv.product_uom_qty)) or ''"/>
                                    <td style="text-align: center;" t-esc="(mv and mv.product_uom._vs_label()) or ''"/>
                                    <td/>
                                </tr>
                            </tbody>
                        </table>

                        <!-- 5. HANDOVER (filled by hand) -->
                        <div class="vs-hand" style="margin-top: 34px; font-weight: bold;">The above goods handed over in good condition from…................................................... To:…..............................................................................</div>
                        <div class="vs-hand" style="margin-top: 46px; font-weight: bold;">Vehicle No./ containe.: ..............................Seal No.: ............................Carriers Name: ............................................................. Signature...............</div>
                        <div class="vs-hand" style="margin-top: 46px;">Receiver's Name:….........................................................................................................</div>
                        <div class="vs-hand" style="margin: 30px 0 0 40px;">Signature,</div>
                        <table style="margin-top: 34px;" class="vs-hand">
                            <tr>
                                <td style="width: 31%; font-weight: bold; padding-left: 78px;">Accredit,,,</td>
                                <td style="width: 41%;"><span style="border-bottom: 1px solid #000; padding: 0 8px;">Storekeeper</span></td>
                                <td style="width: 28%;"><span style="border-bottom: 1px solid #000; padding: 0 10px;">Accountant</span></td>
                            </tr>
                        </table>
                    </div>
                    <t t-call="viewsport_implementation.vs_delivery_footer"/>
                </t>
            </t>
        </t>
    </template>

    <!-- ============================== DELIVERY ORDER ============================== -->
    <template id="report_delivery_viewsport_document">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t t-call="web.basic_layout">
                    <t t-set="fmt_qty" t-value="lambda v: ('%.2f' % v).rstrip('0').rstrip('.') if v else ''"/>
                    <t t-set="cp" t-value="o.partner_id.commercial_partner_id"/>
                    <t t-set="logo_h" t-value="80"/>
                    <t t-call="viewsport_implementation.vs_delivery_styles"/>
                    <div class="page vs-dl">
                        <!-- 1. HEADER -->
                        <table>
                            <tr>
                                <td style="width: 75%; vertical-align: top; padding: 4px 0 0 2px;"><t t-call="viewsport_implementation.vs_delivery_logo"/></td>
                                <td style="width: 25%; vertical-align: top;">
                                    <div style="background-color: #dddddd; border: 1px solid #b0b0b0; border-radius: 6px; padding: 7px 10px; font-weight: bold; font-size: 13px; font-family: 'VS Georgia', Georgia, serif;">
                                        Date: <t t-if="o.scheduled_date" t-esc="o.scheduled_date.strftime('%d / %m / %Y')"/><t t-else="">........../........../..........</t>
                                    </div>
                                    <div style="background-color: #dddddd; border: 1px solid #b0b0b0; border-radius: 6px; padding: 6px 10px; margin-top: 10px; font-weight: bold; font-size: 13px; font-family: 'VS Georgia', Georgia, serif;">
                                        D/O No.: <span style="color: #d0021b; font-size: 20px; font-family: 'VS Script', cursive; font-weight: normal;" t-esc="o._vs_do_number()"/>
                                    </div>
                                </td>
                            </tr>
                        </table>

                        <!-- 2. TITLE -->
                        <div style="text-align: center; font-weight: bold; line-height: 1.2; margin: 30px 0 26px 0;">
                            <div style="font-size: 27px;">DELIVERY ORDER</div>
                            <div style="font-size: 24px;" dir="rtl"><span class="vs-ar">أمــــر تسـليم</span></div>
                        </div>

                        <!-- 3. FROM / TO and references -->
                        <t t-set="wh" t-value="o.picking_type_id.warehouse_id"/>
                        <table>
                            <tr>
                                <td style="width: 65.6%; vertical-align: top;">
                                    <div style="background-color: #dddddd; border: 1px solid #999; padding: 6px 8px; font-size: 14px; height: 92px;">
                                        <div><strong style="text-decoration: underline;">Deliver From:</strong>
                                            <t t-esc="(wh.partner_id.name or wh.name or o.location_id.display_name) or ''"/></div>
                                        <div style="margin-top: 10px;">.......................................................................................................................</div>
                                        <div style="margin-top: 10px;"><strong style="text-decoration: underline;">Deliver to:</strong>
                                            <t t-if="o.partner_id" t-esc="', '.join(x for x in [o.partner_id.name, o.partner_id.street, o.partner_id.city] if x)"/>
                                            <t t-else="">.....................................................................................................</t>
                                        </div>
                                    </div>
                                </td>
                                <td style="width: 7.6%;"/>
                                <td style="width: 26.8%; vertical-align: top;">
                                    <div style="border: 1.5px solid #000; padding: 6px 4px; font-weight: bold; font-size: 14px; white-space: nowrap;">Project Reference: <t t-esc="o._vs_project_ref() or '……....…………'"/></div>
                                    <div style="border: 1.5px solid #000; padding: 6px 4px; margin-top: 22px; font-weight: bold; font-size: 14px; white-space: nowrap;">Invoice Reference: <t t-esc="o._vs_invoice_refs() or '….....................'"/></div>
                                </td>
                            </tr>
                        </table>

                        <!-- 4. ITEMS (at least 12 numbered rows, as on the template) -->
                        <t t-set="moves" t-value="o._vs_lines()"/>
                        <table class="vs-items" style="margin-top: 14px;">
                            <thead>
                                <tr>
                                    <th style="width: 10.7%; font-size: 16px; background-color: #f0f0f0;">Ser. No.<small style="font-size: 12px;"><span class="vs-ar">التسلسل</span></small></th>
                                    <th style="width: 10.8%; font-size: 16px; background-color: #f0f0f0;">Item Ref.<small style="font-size: 12px;"><span class="vs-ar">مرجع البند</span></small></th>
                                    <th style="width: 44.4%; font-size: 16px; background-color: #f0f0f0;">Item Description<small style="font-size: 12px;"><span class="vs-ar">الوصــــــــــف</span></small></th>
                                    <th style="width: 7.7%; font-size: 16px; background-color: #f0f0f0;">UOM<small style="font-size: 12px;"><span class="vs-ar">الوحدة</span></small></th>
                                    <th style="width: 7.8%; font-size: 16px; background-color: #f0f0f0;">QTY<small style="font-size: 12px;"><span class="vs-ar">الكمية</span></small></th>
                                    <th style="width: 18.6%; font-size: 16px; background-color: #f0f0f0;">Remark<small style="font-size: 12px;"><span class="vs-ar">ملاحظات</span></small></th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr t-foreach="range(max(12, len(moves)))" t-as="i" class="vs-alt">
                                    <t t-set="mv" t-value="moves[i] if i &lt; len(moves) else False"/>
                                    <td style="text-align: center; font-weight: bold; height: 33px;" t-esc="'%.2f' % (i + 1)"/>
                                    <td style="text-align: center;" t-esc="(mv and mv.product_id.default_code) or ''"/>
                                    <td style="color: #444;" t-esc="(mv and (mv.description_picking or mv.product_id.display_name)) or ''"/>
                                    <td style="text-align: center;" t-esc="(mv and mv.product_uom._vs_label()) or ''"/>
                                    <td style="text-align: center;" t-esc="(mv and fmt_qty(mv.quantity or mv.product_uom_qty)) or ''"/>
                                    <td/>
                                </tr>
                            </tbody>
                        </table>

                        <!-- 5. HANDOVER (filled by hand) -->
                        <div style="margin-top: 16px; font-size: 14px;">The above goods handed over in good condition <strong>from</strong> …........................................................................ <strong>to</strong> : ……………………………</div>
                        <div style="margin-top: 22px; font-size: 14px;">….................................................................................................................................................................................................</div>
                        <div style="margin-top: 26px; font-size: 14px;">Vehicle No./containe on.: …...........……….…. Seal No.: …......………… Carrier's Name…..……..………………………Singature</div>
                        <table style="margin-top: 32px; font-size: 14px;">
                            <tr>
                                <td style="width: 21%; font-weight: bold;">Receiver's Name:</td>
                                <td style="width: 46%; border-bottom: 1px solid #000 !important;"/>
                                <td/>
                            </tr>
                        </table>
                        <div style="margin-top: 22px; font-weight: bold; font-size: 14px;">Singature,</div>
                        <div style="margin-top: 48px; font-weight: bold; font-size: 12.5px;">Accredit,,,</div>
                        <table style="margin-top: 8px; font-size: 17px; font-family: 'VS Cambria', Cambria, serif; font-weight: bold;">
                            <tr>
                                <td style="width: 18%;"/>
                                <td style="width: 48%;"><span style="border-bottom: 1px solid #000; padding: 0 14px;">Storekeeper</span></td>
                                <td style="width: 34%;"><span style="border-bottom: 1px solid #000; padding: 0 16px;">Accountant</span></td>
                            </tr>
                        </table>
                    </div>
                    <t t-call="viewsport_implementation.vs_delivery_footer"/>
                </t>
            </t>
        </t>
    </template>
</odoo>
