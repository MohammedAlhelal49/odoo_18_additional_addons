<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ===== Projects ===== -->
    <record id="view_aoe_project_list" model="ir.ui.view">
        <field name="name">alomran.eng.project.list</field>
        <field name="model">alomran.eng.project</field>
        <field name="arch" type="xml">
            <list string="Projects">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="category"/>
                <field name="emirate"/>
                <field name="location"/>
                <field name="year"/>
                <field name="is_featured" widget="boolean_toggle"/>
                <field name="is_published" widget="boolean_toggle"/>
            </list>
        </field>
    </record>

    <record id="view_aoe_project_kanban" model="ir.ui.view">
        <field name="name">alomran.eng.project.kanban</field>
        <field name="model">alomran.eng.project</field>
        <field name="arch" type="xml">
            <kanban>
                <field name="id"/>
                <field name="is_featured"/>
                <field name="is_published"/>
                <templates>
                    <t t-name="card" class="flex-row">
                        <aside class="o_kanban_aside_full">
                            <field name="image" widget="image" options="{'size': [120, 90], 'img_class': 'object-fit-cover'}"/>
                        </aside>
                        <main class="ms-2">
                            <field name="name" class="fw-bold fs-5"/>
                            <field name="category"/>
                            <field name="location" class="text-muted"/>
                            <div>
                                <span t-if="record.is_featured.raw_value" class="badge text-bg-warning me-1">Featured</span>
                                <span t-if="!record.is_published.raw_value" class="badge text-bg-secondary">Unpublished</span>
                            </div>
                        </main>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="view_aoe_project_form" model="ir.ui.view">
        <field name="name">alomran.eng.project.form</field>
        <field name="model">alomran.eng.project</field>
        <field name="arch" type="xml">
            <form string="Project">
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_open_website" type="object" class="oe_stat_button" icon="fa-globe" string="Go to Website"/>
                    </div>
                    <widget name="web_ribbon" title="Unpublished" bg_color="text-bg-secondary" invisible="is_published"/>
                    <field name="image" widget="image" class="oe_avatar" options="{'preview_image': 'image', 'size': [180, 135]}"/>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" placeholder="e.g. Private Villa — Al Jimi"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="category"/>
                            <field name="emirate"/>
                            <field name="location"/>
                            <field name="year"/>
                            <field name="area"/>
                        </group>
                        <group>
                            <field name="scope"/>
                            <field name="is_featured"/>
                            <field name="is_published"/>
                            <field name="sequence"/>
                            <field name="active" invisible="1"/>
                        </group>
                    </group>
                    <field name="summary" placeholder="Short summary shown on the project card…"/>
                    <notebook>
                        <page string="Description" name="description">
                            <field name="description"/>
                        </page>
                        <page string="Gallery" name="gallery">
                            <field name="gallery_ids" mode="kanban">
                                <kanban>
                                    <templates>
                                        <t t-name="card">
                                            <field name="image" widget="image" options="{'size': [160, 120]}"/>
                                            <field name="name"/>
                                        </t>
                                    </templates>
                                </kanban>
                                <form>
                                    <group>
                                        <field name="image" widget="image"/>
                                        <field name="name"/>
                                        <field name="sequence"/>
                                    </group>
                                </form>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_aoe_project_search" model="ir.ui.view">
        <field name="name">alomran.eng.project.search</field>
        <field name="model">alomran.eng.project</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="location"/>
                <filter name="published" string="Published" domain="[('is_published', '=', True)]"/>
                <filter name="featured" string="Featured" domain="[('is_featured', '=', True)]"/>
                <filter name="archived" string="Archived" domain="[('active', '=', False)]"/>
                <group expand="0" string="Group By">
                    <filter name="group_category" string="Category" context="{'group_by': 'category'}"/>
                    <filter name="group_emirate" string="Emirate" context="{'group_by': 'emirate'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_aoe_project" model="ir.actions.act_window">
        <field name="name">Portfolio Projects</field>
        <field name="res_model">alomran.eng.project</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Add your first project</p>
            <p>Projects published here appear on the /projects page of the website.</p>
        </field>
    </record>

    <!-- ===== Inquiries ===== -->
    <record id="view_aoe_inquiry_list" model="ir.ui.view">
        <field name="name">alomran.eng.inquiry.list</field>
        <field name="model">alomran.eng.inquiry</field>
        <field name="arch" type="xml">
            <list string="Inquiries" decoration-info="state == 'new'" decoration-muted="state == 'lost'">
                <field name="create_date" string="Received"/>
                <field name="name"/>
                <field name="phone"/>
                <field name="email" optional="show"/>
                <field name="service"/>
                <field name="emirate" optional="show"/>
                <field name="state" widget="badge" decoration-info="state == 'new'" decoration-success="state == 'won'"
                       decoration-warning="state in ('contacted', 'quoted')" decoration-danger="state == 'lost'"/>
            </list>
        </field>
    </record>

    <record id="view_aoe_inquiry_form" model="ir.ui.view">
        <field name="name">alomran.eng.inquiry.form</field>
        <field name="model">alomran.eng.inquiry</field>
        <field name="arch" type="xml">
            <form string="Inquiry">
                <header>
                    <field name="state" widget="statusbar" options="{'clickable': '1'}"/>
                </header>
                <sheet>
                    <div class="oe_title"><h1><field name="name"/></h1></div>
                    <group>
                        <group>
                            <field name="phone" widget="phone"/>
                            <field name="email" widget="email"/>
                            <field name="emirate"/>
                        </group>
                        <group>
                            <field name="service"/>
                            <field name="create_date" string="Received"/>
                            <field name="lang"/>
                            <field name="source_page"/>
                            <field name="lead_id" invisible="not lead_id"/>
                        </group>
                    </group>
                    <separator string="Message"/>
                    <field name="message" nolabel="1"/>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_aoe_inquiry_search" model="ir.ui.view">
        <field name="name">alomran.eng.inquiry.search</field>
        <field name="model">alomran.eng.inquiry</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="phone"/>
                <field name="service"/>
                <filter name="new" string="New" domain="[('state', '=', 'new')]"/>
                <group expand="0" string="Group By">
                    <filter name="group_state" string="Status" context="{'group_by': 'state'}"/>
                    <filter name="group_service" string="Service" context="{'group_by': 'service'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_aoe_inquiry" model="ir.actions.act_window">
        <field name="name">Website Inquiries</field>
        <field name="res_model">alomran.eng.inquiry</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_new': 1}</field>
    </record>

    <menuitem id="menu_aoe_root" name="Al Omran Website" sequence="85" web_icon="alomran_engineering_website,static/description/icon.png"/>
    <menuitem id="menu_aoe_inquiries" name="Inquiries" parent="menu_aoe_root" action="action_aoe_inquiry" sequence="10"/>
    <menuitem id="menu_aoe_projects" name="Portfolio Projects" parent="menu_aoe_root" action="action_aoe_project" sequence="20"/>

</odoo>
