<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <template id="report_invoice_document_inherit_customer_label"
                  inherit_id="account.report_invoice_document">

            <!-- ============================= -->
            <!-- NO SHIPPING -->
            <!-- ============================= -->
            <xpath expr="//div[@name='no_shipping']//address" position="replace">

                <div class="mb-2">
                    <strong>Customer Information:</strong>
                </div>

                <div>
                    <strong>Name:</strong>
                    <span t-field="o.partner_id.name"/>
                </div>
                <div t-if="o.partner_id.mobile or o.partner_id.phone">
                    <strong>Contact:</strong>

                    <t t-if="o.partner_id.mobile">
                        <span t-field="o.partner_id.mobile"/>
                    </t>

                    <t t-if="o.partner_id.mobile and o.partner_id.phone">
                        <span> / </span>
                    </t>

                    <t t-if="o.partner_id.phone">
                        <span t-field="o.partner_id.phone"/>
                    </t>
                </div>
                <div style="display:flex; align-items:center; gap:8px;">
                    <strong style="min-width:90px;">Plate info:</strong>

                    <span>
                        <t t-if="o.partner_id.street">
                            <span t-field="o.partner_id.street"/>
                        </t>

                        <t t-if="o.partner_id.zip">
                            , <span t-field="o.partner_id.zip"/>
                        </t>

                        <t t-if="o.partner_id.city">
                            , <span t-field="o.partner_id.city"/>
                        </t>

                        <t t-if="o.partner_id.state_id">
                            , <span t-field="o.partner_id.state_id.name"/>
                        </t>

                        <t t-if="o.partner_id.country_id">
                            , <span t-field="o.partner_id.country_id.name"/>
                        </t>
                    </span>
                </div>

            </xpath>


            <!-- ============================= -->
            <!-- SHIPPING = INVOICE -->
            <!-- ============================= -->
            <xpath expr="//div[@name='address_same_as_shipping']//address" position="replace">

                <div class="mb-2">
                    <strong>Customer Information:</strong>
                </div>

                <div>
                    <strong>Name:</strong>
                    <span t-field="o.partner_id.name"/>
                </div>
                <div t-if="o.partner_id.mobile or o.partner_id.phone">
                    <strong>Contact:</strong>

                    <t t-if="o.partner_id.mobile">
                        <span t-field="o.partner_id.mobile"/>
                    </t>

                    <t t-if="o.partner_id.mobile and o.partner_id.phone">
                        <span> / </span>
                    </t>

                    <t t-if="o.partner_id.phone">
                        <span t-field="o.partner_id.phone"/>
                    </t>
                </div>
                                <div style="display:flex; align-items:center; gap:8px;">
                    <strong style="min-width:90px;">Plate info:</strong>

                    <span>
                        <t t-if="o.partner_id.street">
                            <span t-field="o.partner_id.street"/>
                        </t>

                        <t t-if="o.partner_id.zip">
                            , <span t-field="o.partner_id.zip"/>
                        </t>

                        <t t-if="o.partner_id.city">
                            , <span t-field="o.partner_id.city"/>
                        </t>

                        <t t-if="o.partner_id.state_id">
                            , <span t-field="o.partner_id.state_id.name"/>
                        </t>

                        <t t-if="o.partner_id.country_id">
                            , <span t-field="o.partner_id.country_id.name"/>
                        </t>
                    </span>
                </div>

            </xpath>


            <!-- ============================= -->
            <!-- SHIPPING DIFFERENT -->
            <!-- ============================= -->
            <xpath expr="//div[@name='address_not_same_as_shipping']//address" position="replace">

                <div class="mb-2">
                    <strong>Customer Information:</strong>
                </div>

                <div>
                    <strong>Name:</strong>
                    <span t-field="o.partner_id.name"/>
                </div>
                <div t-if="o.partner_id.mobile or o.partner_id.phone">
                    <strong>Contact:</strong>

                    <t t-if="o.partner_id.mobile">
                        <span t-field="o.partner_id.mobile"/>
                    </t>

                    <t t-if="o.partner_id.mobile and o.partner_id.phone">
                        <span> / </span>
                    </t>

                    <t t-if="o.partner_id.phone">
                        <span t-field="o.partner_id.phone"/>
                    </t>
                </div>
                                <div style="display:flex; align-items:center; gap:8px;">
                    <strong style="min-width:90px;">Plate info:</strong>

                    <span>
                        <t t-if="o.partner_id.street">
                            <span t-field="o.partner_id.street"/>
                        </t>

                        <t t-if="o.partner_id.zip">
                            , <span t-field="o.partner_id.zip"/>
                        </t>

                        <t t-if="o.partner_id.city">
                            , <span t-field="o.partner_id.city"/>
                        </t>

                        <t t-if="o.partner_id.state_id">
                            , <span t-field="o.partner_id.state_id.name"/>
                        </t>

                        <t t-if="o.partner_id.country_id">
                            , <span t-field="o.partner_id.country_id.name"/>
                        </t>
                    </span>
                </div>

            </xpath>

        </template>

        <!-- Arabic label under each invoice line column title -->
        <template id="report_invoice_document_arabic_column_titles"
                  inherit_id="account.report_invoice_document">
            <xpath expr="//th[@name='th_description']" position="inside">
                <div lang="ar" dir="rtl">الوصف</div>
            </xpath>
            <xpath expr="//th[@name='th_quantity']" position="inside">
                <div lang="ar" dir="rtl">الكمية</div>
            </xpath>
            <xpath expr="//th[@name='th_priceunit']" position="inside">
                <div lang="ar" dir="rtl">سعر الوحدة</div>
            </xpath>
            <xpath expr="//th[@name='th_taxes']" position="inside">
                <div lang="ar" dir="rtl">الضريبة</div>
            </xpath>
            <!-- 'VAT Amount' column comes from l10n_ae -->
            <xpath expr="//th[@name='tax_amount']" position="inside">
                <div lang="ar" dir="rtl">قيمة الضريبة</div>
            </xpath>
            <xpath expr="//th[@name='th_subtotal']" position="inside">
                <div lang="ar" dir="rtl">المبلغ</div>
            </xpath>
        </template>

        <!-- Company TRN in the header, under the company address (customer invoices / credit notes only) -->
        <template id="external_layout_folder_company_trn" inherit_id="web.external_layout_folder">
            <xpath expr="//ul[@name='company_address_list']" position="inside">
                <li t-if="o and o._name == 'account.move' and o.move_type in ('out_invoice', 'out_refund') and company.vat and not forced_vat">
                    TRN: <span t-field="company.vat"/>
                </li>
            </xpath>
        </template>

    </data>
</odoo>