<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="alomran_takeover_log_view_list" model="ir.ui.view">
        <field name="name">alomran.takeover.log.list</field>
        <field name="model">alomran.takeover.log</field>
        <field name="arch" type="xml">
            <list create="0" edit="0" delete="0" decoration-warning="cross_branch">
                <field name="date"/>
                <field name="customer_name"/>
                <field name="number"/>
                <field name="user_id" widget="many2one_avatar_user"/>
                <field name="company_id"/>
                <field name="previous_user_ids" widget="many2many_tags"/>
                <field name="previous_company_ids" widget="many2many_tags"/>
                <field name="lead_count"/>
                <field name="cross_branch"/>
            </list>
        </field>
    </record>

    <record id="alomran_takeover_log_view_form" model="ir.ui.view">
        <field name="name">alomran.takeover.log.form</field>
        <field name="model">alomran.takeover.log</field>
        <field name="arch" type="xml">
            <form create="0" edit="0" delete="0">
                <sheet>
                    <group>
                        <group>
                            <field name="date"/>
                            <field name="customer_name"/>
                            <field name="number"/>
                            <field name="cross_branch"/>
                        </group>
                        <group>
                            <field name="user_id"/>
                            <field name="company_id"/>
                            <field name="previous_user_ids" widget="many2many_tags"/>
                            <field name="previous_company_ids" widget="many2many_tags"/>
                        </group>
                    </group>
                    <field name="lead_ids">
                        <list>
                            <field name="name"/>
                            <field name="stage_id"/>
                            <field name="user_id"/>
                            <field name="company_id"/>
                        </list>
                    </field>
                    <field name="partner_ids">
                        <list>
                            <field name="name"/>
                            <field name="mobile"/>
                            <field name="phone"/>
                        </list>
                    </field>
                </sheet>
            </form>
        </field>
    </record>

    <record id="alomran_takeover_log_view_search" model="ir.ui.view">
        <field name="name">alomran.takeover.log.search</field>
        <field name="model">alomran.takeover.log</field>
        <field name="arch" type="xml">
            <search>
                <field name="customer_name"/>
                <field name="number"/>
                <field name="user_id"/>
                <field name="previous_user_ids"/>
                <filter name="cross_branch" string="From Another Branch" domain="[('cross_branch', '=', True)]"/>
                <filter name="this_month" string="This Month"
                        domain="[('date', '&gt;=', (context_today() + relativedelta(day=1)).strftime('%Y-%m-%d'))]"/>
                <separator/>
                <filter name="group_user" string="Taken By" context="{'group_by': 'user_id'}"/>
                <filter name="group_company" string="New Branch" context="{'group_by': 'company_id'}"/>
                <filter name="group_date" string="Date" context="{'group_by': 'date:day'}"/>
            </search>
        </field>
    </record>

    <record id="alomran_takeover_log_action" model="ir.actions.act_window">
        <field name="name">Take Over Log</field>
        <field name="res_model">alomran.takeover.log</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No customer has been taken over yet.</p>
            <p>Every manual transfer (Take Over) of a customer is recorded here.</p>
        </field>
    </record>

    <menuitem id="alomran_takeover_log_menu"
              name="Take Over Log"
              parent="crm.crm_menu_report"
              action="alomran_takeover_log_action"
              groups="sales_team.group_sale_manager"
              sequence="60"/>

</odoo>
