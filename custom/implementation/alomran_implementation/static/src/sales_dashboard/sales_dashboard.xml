<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <t t-name="alomran_implementation.SalesKpiCards">
        <div t-foreach="cards" t-as="card" t-key="card.key" class="col-6 col-md-4 col-xl">
            <div class="card o_sd_kpi h-100" t-att-class="{'o_sd_clickable': card.onClick}" t-on-click="() => this.onCardClick(card)">
                <div class="card-body p-3">
                    <div class="o_sd_kpi_label text-muted" t-esc="card.label"/>
                    <div class="o_sd_kpi_value" t-att-class="card.valueClass" t-esc="card.value"/>
                    <div class="o_sd_kpi_sub small o_sd_inline">
                        <span t-if="card.trend" t-att-class="card.trend.cls" t-esc="card.trend.label"/>
                        <span t-if="card.sub" class="text-muted" t-esc="card.sub"/>
                    </div>
                </div>
            </div>
        </div>
    </t>

    <t t-name="alomran_implementation.SalesDashboard">
        <div class="o_action o_sd_dashboard" t-att-dir="isRtl ? 'rtl' : 'ltr'">
            <!-- ======================== filters ======================== -->
            <div class="o_sd_filters border-bottom">
                <div class="d-flex flex-wrap align-items-center gap-2">
                    <h4 class="m-0 o_sd_title">
                        Sales Dashboard
                        <small t-if="state.data and !state.data.can_see_all" class="text-muted fs-6">(My Sales)</small>
                    </h4>
                    <div class="btn-group o_sd_presets" role="group">
                        <t t-foreach="state.filters.presets" t-as="preset" t-key="preset.key">
                            <button type="button" class="btn btn-sm"
                                    t-att-class="state.preset === preset.key ? 'btn-primary' : 'btn-outline-secondary'"
                                    t-on-click="() => this.selectPreset(preset.key)"
                                    t-esc="preset.label"/>
                        </t>
                    </div>
                    <div t-if="state.preset === 'custom'" class="d-flex align-items-center gap-1">
                        <input type="date" class="form-control form-control-sm o_sd_date" t-att-value="state.dateFrom"
                               t-on-change="(ev) => this.onDateChange('dateFrom', ev)"/>
                        <span>→</span>
                        <input type="date" class="form-control form-control-sm o_sd_date" t-att-value="state.dateTo"
                               t-on-change="(ev) => this.onDateChange('dateTo', ev)"/>
                    </div>
                    <button type="button" class="btn btn-sm btn-light o_sd_push_end" t-on-click="() => this.load()" title="Refresh">
                        <i class="fa fa-refresh" t-att-class="{'fa-spin': state.loading}"/>
                    </button>
                </div>
                <div class="d-flex flex-wrap align-items-center gap-2 mt-2"
                     t-if="state.filters.companies.length > 1 or state.filters.can_see_all">
                    <t t-if="state.filters.companies.length > 1">
                        <span class="text-muted small">Branch:</span>
                        <t t-foreach="state.filters.companies" t-as="company" t-key="company.id">
                            <button type="button" class="btn btn-sm rounded-pill"
                                    t-att-class="isCompanyActive(company.id) ? 'btn-secondary' : 'btn-outline-secondary'"
                                    t-on-click="() => this.toggleCompany(company.id)" t-esc="company.name"/>
                        </t>
                        <span t-if="!state.companyIds.length" class="text-muted small">(all)</span>
                    </t>
                    <Dropdown t-if="state.filters.can_see_all">
                        <button class="btn btn-sm btn-outline-secondary rounded-pill o_sd_gap_start">
                            <i class="fa fa-user"/> <t t-esc="userLabel"/>
                        </button>
                        <t t-set-slot="content">
                            <DropdownItem closingMode="'none'" onSelected="() => this.clearUsers()"
                                          class="{ 'fw-bold': !state.userIds.length }">
                                All salespeople
                            </DropdownItem>
                            <div class="dropdown-divider"/>
                            <div style="max-height: 320px; overflow-y: auto;">
                                <DropdownItem t-foreach="state.filters.users" t-as="u" t-key="u.id"
                                              closingMode="'none'" onSelected="() => this.toggleUser(u.id)">
                                    <i t-attf-class="fa fa-fw #{state.userIds.includes(u.id) ? 'fa-check-square-o' : 'fa-square-o'}"/>
                                    <t t-esc="u.name"/>
                                </DropdownItem>
                            </div>
                        </t>
                    </Dropdown>
                </div>
                <div t-if="state.data" class="small text-muted mt-1 o_sd_inline">
                    <bdi t-esc="state.data.period.label"/>
                    <span>· <t t-esc="compareLabel"/></span>
                    <span>· <t t-esc="timezoneLabel"/></span>
                </div>
            </div>

            <div t-if="!state.data and state.loading" class="text-center p-5 text-muted">
                <i class="fa fa-spinner fa-spin fa-2x"/>
            </div>

            <div t-if="state.data" class="o_sd_body" t-att-class="{'o_sd_loading': state.loading}">
                <!-- ======================== KPIs ======================== -->
                <div class="row g-2 mb-2">
                    <t t-call="alomran_implementation.SalesKpiCards"><t t-set="cards" t-value="salesCards"/></t>
                </div>
                <div class="row g-2 mb-3">
                    <t t-call="alomran_implementation.SalesKpiCards"><t t-set="cards" t-value="followCards"/></t>
                </div>

                <!-- ======================== charts ======================== -->
                <div class="row g-3 mb-3">
                    <div class="col-12 col-lg-8">
                        <div class="card h-100"><div class="card-body">
                            <h6 class="card-title">Sales trend</h6>
                            <div class="o_sd_chart"><canvas t-ref="salesChart"/></div>
                        </div></div>
                    </div>
                    <div class="col-12 col-lg-4">
                        <div class="card h-100"><div class="card-body">
                            <h6 class="card-title">Payment methods</h6>
                            <div class="o_sd_chart" t-if="state.data.payment_methods.some((p) => p.amount &gt; 0)"><canvas t-ref="paymentChart"/></div>
                            <div t-else="" class="text-muted text-center py-5">No sales in this period</div>
                        </div></div>
                    </div>
                </div>

                <div class="row g-3 mb-3">
                    <div class="col-12 col-lg-8">
                        <div class="card h-100"><div class="card-body">
                            <h6 class="card-title">Customer sources</h6>
                            <div class="o_sd_chart" t-if="state.data.sources.some((s) => s.amount &gt; 0)"><canvas t-ref="sourceChart"/></div>
                            <div t-else="" class="text-muted text-center py-5">No sales in this period</div>
                        </div></div>
                    </div>
                    <div class="col-12 col-lg-4">
                        <div class="card h-100"><div class="card-body">
                            <h6 class="card-title">New vs re-enrollment</h6>
                            <div class="o_sd_chart" t-if="state.data.enrollments.some((e) => e.amount &gt; 0)"><canvas t-ref="enrollmentChart"/></div>
                            <div t-else="" class="text-muted text-center py-5">No sales in this period</div>
                        </div></div>
                    </div>
                </div>

                <!-- ======================== tables ======================== -->
                <div class="row g-3 mb-3">
                    <div class="col-12 col-lg-5">
                        <div class="card h-100"><div class="card-body">
                            <h6 class="card-title">Best-selling courses</h6>
                            <div class="table-responsive">
                                <table class="table table-sm table-hover mb-0">
                                    <thead><tr><th>Course</th><th class="text-end">Contracts</th><th class="text-end">Amount</th></tr></thead>
                                    <tbody>
                                        <tr t-foreach="state.data.courses" t-as="course" t-key="course.id" class="o_sd_clickable" t-on-click="() => this.openCourse(course)">
                                            <td t-esc="course.name"/>
                                            <td class="text-end" t-esc="int(course.contracts)"/>
                                            <td class="text-end text-nowrap" t-esc="money(course.amount)"/>
                                        </tr>
                                        <tr t-if="!state.data.courses.length"><td colspan="3" class="text-muted text-center">No sales in this period</td></tr>
                                    </tbody>
                                </table>
                            </div>
                        </div></div>
                    </div>
                    <div class="col-12 col-lg-7">
                        <div class="card h-100"><div class="card-body">
                            <h6 class="card-title">Largest amounts remaining to invoice</h6>
                            <div class="table-responsive">
                                <table class="table table-sm table-hover mb-0">
                                    <thead><tr>
                                        <th>Contract</th><th>Customer</th><th t-if="state.data.can_see_all">Salesperson</th>
                                        <th class="text-end">Total</th><th class="text-end">Remaining</th>
                                    </tr></thead>
                                    <tbody>
                                        <tr t-foreach="state.data.top_remaining" t-as="order" t-key="order.id" class="o_sd_clickable" t-on-click="() => this.openOrder(order)">
                                            <td class="text-nowrap">
                                                <div t-esc="order.name"/>
                                                <small class="text-muted" t-esc="order.date"/>
                                            </td>
                                            <td>
                                                <div t-esc="order.customer"/>
                                                <small class="text-muted" dir="ltr" t-esc="order.phone"/>
                                            </td>
                                            <td t-if="state.data.can_see_all" t-esc="order.user"/>
                                            <td class="text-end text-nowrap" t-esc="money(order.total)"/>
                                            <td class="text-end text-nowrap fw-bold text-warning" t-esc="money(order.remaining)"/>
                                        </tr>
                                        <tr t-if="!state.data.top_remaining.length"><td colspan="5" class="text-muted text-center">Nothing remaining to invoice</td></tr>
                                    </tbody>
                                </table>
                            </div>
                        </div></div>
                    </div>
                </div>

                <!-- ======================== salespeople / branches ======================== -->
                <div class="row g-3 mb-3" t-if="state.data.salespeople.length or state.data.branches.length">
                    <div t-if="state.data.salespeople.length" t-att-class="state.data.branches.length ? 'col-12 col-lg-7' : 'col-12'">
                        <div class="card h-100"><div class="card-body">
                            <h6 class="card-title">Salespeople</h6>
                            <div class="table-responsive">
                                <table class="table table-sm table-hover mb-0">
                                    <thead><tr>
                                        <th>Salesperson</th><th class="text-end">Contracts</th><th class="text-end">New</th>
                                        <th class="text-end">Amount</th><th class="text-end">Average</th><th class="text-end">Remaining</th>
                                    </tr></thead>
                                    <tbody>
                                        <tr t-foreach="state.data.salespeople" t-as="person" t-key="person.id or 0" class="o_sd_clickable" t-on-click="() => this.openSalesperson(person)">
                                            <td t-esc="person.name"/>
                                            <td class="text-end" t-esc="int(person.contracts)"/>
                                            <td class="text-end" t-esc="int(person.new_enrollments)"/>
                                            <td class="text-end text-nowrap" t-esc="money(person.amount)"/>
                                            <td class="text-end text-nowrap" t-esc="money(person.avg)"/>
                                            <td class="text-end text-nowrap" t-esc="money(person.remaining)"/>
                                        </tr>
                                    </tbody>
                                </table>
                            </div>
                        </div></div>
                    </div>
                    <div t-if="state.data.branches.length" t-att-class="state.data.salespeople.length ? 'col-12 col-lg-5' : 'col-12'">
                        <div class="card h-100"><div class="card-body">
                            <h6 class="card-title">Branches</h6>
                            <div class="table-responsive">
                                <table class="table table-sm table-hover mb-0">
                                    <thead><tr><th>Branch</th><th class="text-end">Contracts</th><th class="text-end">Amount</th><th class="text-end">Remaining</th></tr></thead>
                                    <tbody>
                                        <tr t-foreach="state.data.branches" t-as="branch" t-key="branch.id" class="o_sd_clickable" t-on-click="() => this.openBranch(branch)">
                                            <td t-esc="branch.name"/>
                                            <td class="text-end" t-esc="int(branch.contracts)"/>
                                            <td class="text-end text-nowrap" t-esc="money(branch.amount)"/>
                                            <td class="text-end text-nowrap" t-esc="money(branch.remaining)"/>
                                        </tr>
                                    </tbody>
                                </table>
                            </div>
                        </div></div>
                    </div>
                </div>
            </div>
        </div>
    </t>
</templates>
