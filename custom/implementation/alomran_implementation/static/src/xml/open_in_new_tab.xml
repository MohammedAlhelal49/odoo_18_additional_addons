<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="alomran_implementation.OpenInNewTab">
        <a t-if="url" t-att-href="url" target="_blank" rel="noopener"
           class="btn btn-link btn-sm p-0 o_alomran_open_new_tab"
           title="Open in New Tab" aria-label="Open in New Tab"
           t-on-click="onClick">
            <i class="fa fa-external-link"/>
        </a>
    </t>
</templates>
