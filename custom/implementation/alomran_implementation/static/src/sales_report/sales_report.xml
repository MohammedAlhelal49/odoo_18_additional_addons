<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <t t-name="alomran_implementation.SalesReportMultiFilter">
        <Dropdown>
            <button class="btn btn-secondary btn-sm o-dropdown-caret" t-att-class="{'o_sr_active_filter': state.options[name].length}">
                <i t-att-class="'fa ' + icon"/>
                <span class="o_sr_filter_text" t-esc="listLabel(name, items, idKey, allLabel)"/>
            </button>
            <t t-set-slot="content">
                <DropdownItem onSelected="() => this.clearList(name)" class="!state.options[name].length ? 'selected' : ''">
                    <t t-esc="allLabel"/>
                </DropdownItem>
                <div class="dropdown-divider" role="separator"/>
                <div style="max-height: 320px; overflow-y: auto;">
                    <t t-foreach="items" t-as="item" t-key="item[idKey]">
                        <DropdownItem closingMode="'none'" onSelected="() => this.toggleInList(name, item[idKey])"
                                      class="state.options[name].includes(item[idKey]) ? 'selected' : ''">
                            <t t-esc="item.name"/>
                        </DropdownItem>
                    </t>
                </div>
            </t>
        </Dropdown>
    </t>

    <t t-name="alomran_implementation.SalesReport">
        <div class="o_action o_sr_report" t-att-dir="isRtl ? 'rtl' : 'ltr'">
            <div class="o_sr_report_bar border-bottom" t-if="state.filters">
                <div class="d-flex flex-wrap align-items-center o_sr_gap">
                    <h4 class="m-0 o_sr_report_title">
                        <t t-esc="state.filters.title"/>
                        <small t-if="!state.filters.can_see_all" class="text-muted fs-6">(My Sales)</small>
                    </h4>
                    <div class="d-flex flex-wrap o_sr_gap o_sr_push_end">
                        <button type="button" class="btn btn-primary btn-sm" t-on-click="printPdf" t-att-disabled="state.loading">
                            <i class="fa fa-file-pdf-o"/> PDF
                        </button>
                        <button type="button" class="btn btn-primary btn-sm" t-on-click="exportXlsx" t-att-disabled="state.loading">
                            <i class="fa fa-file-excel-o"/> Excel
                        </button>
                    </div>
                </div>

                <div class="d-flex flex-wrap align-items-center o_sr_gap mt-2">
                    <!-- period -->
                    <Dropdown>
                        <button class="btn btn-secondary btn-sm o-dropdown-caret">
                            <i class="fa fa-calendar"/>
                            <span class="o_sr_filter_text" t-esc="presetLabel"/>
                        </button>
                        <t t-set-slot="content">
                            <t t-foreach="state.filters.presets" t-as="preset" t-key="preset.key">
                                <DropdownItem onSelected="() => this.setOption('preset', preset.key)"
                                              class="state.options.preset === preset.key ? 'selected' : ''">
                                    <t t-esc="preset.label"/>
                                </DropdownItem>
                            </t>
                        </t>
                    </Dropdown>
                    <div t-if="state.options.preset === 'custom'" class="d-flex align-items-center o_sr_gap">
                        <input type="date" class="form-control form-control-sm o_sr_date" t-att-value="state.options.date_from"
                               t-on-change="(ev) => this.onDateChange('date_from', ev)"/>
                        <span>→</span>
                        <input type="date" class="form-control form-control-sm o_sr_date" t-att-value="state.options.date_to"
                               t-on-change="(ev) => this.onDateChange('date_to', ev)"/>
                    </div>

                    <!-- comparison -->
                    <Dropdown t-if="state.filters.comparisons.length">
                        <button class="btn btn-secondary btn-sm o-dropdown-caret" t-att-class="{'o_sr_active_filter': state.options.comparison !== 'none'}">
                            <i class="fa fa-exchange"/>
                            <span class="o_sr_filter_text" t-esc="comparisonLabel"/>
                        </button>
                        <t t-set-slot="content">
                            <t t-foreach="state.filters.comparisons" t-as="cmp" t-key="cmp.key">
                                <DropdownItem onSelected="() => this.setOption('comparison', cmp.key)"
                                              class="state.options.comparison === cmp.key ? 'selected' : ''">
                                    <t t-esc="cmp.label"/>
                                </DropdownItem>
                            </t>
                        </t>
                    </Dropdown>

                    <t t-if="state.filters.companies.length > 1" t-call="alomran_implementation.SalesReportMultiFilter">
                        <t t-set="name" t-value="'company_ids'"/>
                        <t t-set="items" t-value="state.filters.companies"/>
                        <t t-set="idKey" t-value="'id'"/>
                        <t t-set="icon" t-value="'fa-building'"/>
                        <t t-set="allLabel" t-value="state.filters.all_companies_label"/>
                    </t>
                    <t t-if="state.filters.can_see_all" t-call="alomran_implementation.SalesReportMultiFilter">
                        <t t-set="name" t-value="'user_ids'"/>
                        <t t-set="items" t-value="state.filters.users"/>
                        <t t-set="idKey" t-value="'id'"/>
                        <t t-set="icon" t-value="'fa-user'"/>
                        <t t-set="allLabel" t-value="state.filters.all_users_label"/>
                    </t>
                    <t t-call="alomran_implementation.SalesReportMultiFilter">
                        <t t-set="name" t-value="'payment_methods'"/>
                        <t t-set="items" t-value="state.filters.payment_methods"/>
                        <t t-set="idKey" t-value="'key'"/>
                        <t t-set="icon" t-value="'fa-credit-card'"/>
                        <t t-set="allLabel" t-value="state.filters.all_payments_label"/>
                    </t>
                    <t t-call="alomran_implementation.SalesReportMultiFilter">
                        <t t-set="name" t-value="'sources'"/>
                        <t t-set="items" t-value="state.filters.sources"/>
                        <t t-set="idKey" t-value="'key'"/>
                        <t t-set="icon" t-value="'fa-bullhorn'"/>
                        <t t-set="allLabel" t-value="state.filters.all_sources_label"/>
                    </t>
                    <t t-call="alomran_implementation.SalesReportMultiFilter">
                        <t t-set="name" t-value="'enrollments'"/>
                        <t t-set="items" t-value="state.filters.enrollments"/>
                        <t t-set="idKey" t-value="'key'"/>
                        <t t-set="icon" t-value="'fa-refresh'"/>
                        <t t-set="allLabel" t-value="state.filters.all_enrollments_label"/>
                    </t>

                    <button t-if="state.data and hasChildren" type="button" class="btn btn-link btn-sm o_sr_push_end"
                            t-on-click="() => this.unfoldAll(!Object.keys(state.unfolded).length)">
                        <t t-if="Object.keys(state.unfolded).length">Fold all</t>
                        <t t-else="">Unfold all</t>
                    </button>
                </div>
            </div>

            <div t-if="!state.data" class="text-center p-5 text-muted"><i class="fa fa-spinner fa-spin fa-2x"/></div>

            <div t-if="state.data" class="o_sr_report_body" t-att-class="{'o_sr_loading': state.loading}">
                <div class="o_sr_report_sheet">
                    <div class="mb-3">
                        <div class="fw-bold" t-esc="state.data.company"/>
                        <div class="small text-muted"><bdi t-esc="state.data.period_label"/></div>
                        <div t-if="state.data.comparison_label" class="small text-muted">
                            Compared with <bdi t-esc="state.data.comparison_label"/>
                        </div>
                        <div class="small text-muted" t-foreach="state.data.filters_summary" t-as="part" t-key="part_index" t-esc="part"/>
                    </div>
                    <div class="table-responsive">
                        <table class="table table-sm table-hover o_sr_report_table">
                            <thead>
                                <tr>
                                    <th/>
                                    <th t-foreach="state.data.columns" t-as="col" t-key="col.key"
                                        t-att-class="col.type !== 'text' ? 'text-end' : ''" t-esc="col.label"/>
                                </tr>
                            </thead>
                            <tbody>
                                <tr t-foreach="visibleLines" t-as="line" t-key="line.id"
                                    t-att-class="'o_sr_level_' + line.level + (line.children and line.children.length ? ' o_sr_parent' : '')">
                                    <td class="o_sr_label">
                                        <span class="o_sr_caret" t-on-click="() => this.toggleLine(line)">
                                            <i t-if="line.children and line.children.length"
                                               t-att-class="'fa fa-fw ' + (isUnfolded(line) ? 'fa-caret-down' : (isRtl ? 'fa-caret-left' : 'fa-caret-right'))"/>
                                        </span>
                                        <a t-if="line.action" href="#" class="o_sr_line_link" t-on-click.prevent="() => this.openLine(line)" t-esc="line.label"/>
                                        <span t-else="" t-esc="line.label"/>
                                        <small t-if="line.sublabel" class="text-muted o_sr_gap_start" t-esc="line.sublabel"/>
                                    </td>
                                    <td t-foreach="state.data.columns" t-as="col" t-key="col.key"
                                        t-att-class="(col.type !== 'text' ? 'text-end text-nowrap ' : '') + deltaClass(col, line.values[col.key])"
                                        t-esc="format(line.values[col.key], col.type)"/>
                                </tr>
                                <tr t-if="!state.data.lines.length">
                                    <td t-att-colspan="state.data.columns.length + 1" class="text-center text-muted py-4">No data for this period</td>
                                </tr>
                            </tbody>
                            <tfoot>
                                <tr class="o_sr_total">
                                    <td>Total</td>
                                    <td t-foreach="state.data.columns" t-as="col" t-key="col.key"
                                        t-att-class="(col.type !== 'text' ? 'text-end text-nowrap ' : '') + deltaClass(col, state.data.totals[col.key])"
                                        t-esc="format(state.data.totals[col.key], col.type)"/>
                                </tr>
                            </tfoot>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </t>
</templates>
