<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Lookup records are private to the user who ran the search -->
    <record id="rule_alomran_customer_lookup_own" model="ir.rule">
        <field name="name">Customer Lookup: own searches only</field>
        <field name="model_id" ref="model_alomran_customer_lookup"/>
        <field name="domain_force">[('create_uid', '=', user.id)]</field>
    </record>
    <record id="rule_alomran_customer_lookup_line_own" model="ir.rule">
        <field name="name">Customer Lookup Lines: own searches only</field>
        <field name="model_id" ref="model_alomran_customer_lookup_line"/>
        <field name="domain_force">[('create_uid', '=', user.id)]</field>
    </record>

    <!-- Daily activity report: multi-company (branch) isolation -->
    <record id="rule_alomran_daily_activity_report_company" model="ir.rule">
        <field name="name">Daily Activity Report: allowed branches</field>
        <field name="model_id" ref="model_alomran_daily_activity_report"/>
        <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
    </record>

    <!-- Daily activity report: "Own Documents" salespeople only see their own figures -->
    <record id="rule_alomran_daily_activity_report_own" model="ir.rule">
        <field name="name">Daily Activity Report: own figures</field>
        <field name="model_id" ref="model_alomran_daily_activity_report"/>
        <field name="domain_force">[('user_id', '=', user.id)]</field>
        <field name="groups" eval="[(4, ref('sales_team.group_sale_salesman'))]"/>
    </record>
    <record id="rule_alomran_daily_activity_report_all" model="ir.rule">
        <field name="name">Daily Activity Report: all employees</field>
        <field name="model_id" ref="model_alomran_daily_activity_report"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('sales_team.group_sale_salesman_all_leads'))]"/>
    </record>
</odoo>
